load("//tools:regression.bzl", "cc_test", "py_test")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")
load("@rules_python//python:defs.bzl", "py_binary", "py_library")

cc_binary(
    name = "pin_options",
    srcs = ["pin_options.cpp"],
    tags = ["manual"],
    deps = ["//inou/lefdef:inou_lefdef"],
)

filegroup(
    name = "coordinators",
    srcs = ["rf_chunks.py", "rf_feedback.py"],
    visibility = ["//lhd:__pkg__"],
)

cc_binary(
    name = "check_connections",
    srcs = ["check_connections.cpp"],
    tags = ["manual"],
    deps = ["//inou/lefdef:inou_lefdef"],
)

cc_binary(
    name = "frame_trees",
    srcs = ["frame_trees.cpp"],
    tags = ["manual"],
    deps = [
        "//inou/lefdef:inou_lefdef",
        "//pass/place:legroute",
    ],
)

cc_library(
    name = "row_solve",
    srcs = ["row_solve.cpp"],
    hdrs = ["row_solve.hpp"],
    deps = ["@dreamplace_lemon//:graph"],
)

cc_test(
    name = "row_solve_test",
    size = "small",
    srcs = ["row_solve_test.cpp"],
    deps = [
        ":row_solve",
        "//inou/lefdef:inou_lefdef",
        "@googletest//:gtest_main",
    ],
)

cc_binary(
    name = "row_probe",
    srcs = ["row_probe.cpp"],
    tags = ["manual"],
    deps = [":row_solve"],
)

cc_binary(
    name = "retained_metal",
    srcs = ["retained_metal.cpp"],
    tags = ["manual"],
    deps = ["//inou/lefdef:inou_lefdef"],
)

py_library(
    name = "rf_shared_tracks_lib",
    srcs = ["rf_shared_tracks.py"],
    imports = ["."],
)

py_binary(
    name = "rf_shared_tracks",
    srcs = ["rf_shared_tracks.py"],
    legacy_create_init = 0,
)

py_test(
    name = "rf_route_test",
    size = "small",
    srcs = ["rf_route_test.py"],
    args = ["$(location //lhd)", "$(location :rf_chunks)", "$(location :rf_feedback)"],
    data = ["//lhd", ":rf_chunks", ":rf_feedback"],
    legacy_create_init = 0,
    deps = [":rf_shared_tracks_lib"],
)

py_library(
    name = "rf_chunks_lib",
    srcs = ["rf_chunks.py"],
    imports = ["."],
    deps = ["@rules_python//python/runfiles"],
)

py_binary(
    name = "rf_chunks",
    srcs = ["rf_chunks.py"],
    data = ["//lhd"],
    legacy_create_init = 0,
    deps = ["@rules_python//python/runfiles"],
)

py_binary(
    name = "rf_feedback",
    srcs = ["rf_feedback.py"],
    data = ["//lhd"],
    legacy_create_init = 0,
    deps = [":rf_chunks_lib"],
)
