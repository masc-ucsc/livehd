/* Hermetic Liberty for transparent data-latch mapping (sky130-shaped): the
 * register and clock-gate cells of abc_icg_q.lib plus latch cells, which
 * pass.abc must pick from their `latch` groups by enable polarity and area,
 * honoring dont_use and skipping isolation / scan shapes:
 *   DLXTPx1   area 5   latch, enable GATE (active high), Q   -> the high pick
 *   DLXTPx2   area 5.5 same pins                             -> its drive ladder
 *   DLXTNx1   area 5   enable !GATE_N (active low), Q        -> the low pick
 *   DLXBPx1   area 6   GATE, Q + Q_N                         -> dearer, never picked
 *   DLXTPx0   area 3   dont_use                              -> never used
 *   ISOLATCHx1 area 2  is_isolation_cell                     -> never used
 *   SDLXTPx1  area 2.5 an extra scan input SCE               -> never used
 *   DLRTPx1   area 6.5 GATE + clear !RESET_B                 -> reset-to-0, high
 *   DLRTNx1   area 6.5 !GATE_N + clear !RESET_B              -> reset-to-0, low
 *   DLSTPx1   area 6.8 GATE + preset SET                     -> reset-to-1, high
 */
library(abc_latch_q) {
  delay_model : table_lookup;
  time_unit : "1ns";
  capacitive_load_unit (1,pf);
  default_inout_pin_cap : 0.0;
  default_input_pin_cap : 0.0;
  default_output_pin_cap : 0.0;
  default_fanout_load : 1.0;

  cell(INVx1) {
    area : 1;
    pin(A) { direction : input; capacitance : 1; }
    pin(Y) { direction : output; function : "A'";
      timing() { related_pin : "A"; cell_rise(scalar){values("0.1");} cell_fall(scalar){values("0.1");}
                 rise_transition(scalar){values("0.1");} fall_transition(scalar){values("0.1");} } }
  }
  cell(BUFx1) {
    area : 2;
    pin(A) { direction : input; capacitance : 1; }
    pin(Y) { direction : output; function : "A";
      timing() { related_pin : "A"; cell_rise(scalar){values("0.1");} cell_fall(scalar){values("0.1");}
                 rise_transition(scalar){values("0.1");} fall_transition(scalar){values("0.1");} } }
  }
  cell(NAND2x1) {
    area : 3;
    pin(A) { direction : input; capacitance : 1; }
    pin(B) { direction : input; capacitance : 1; }
    pin(Y) { direction : output; function : "(A B)'";
      timing() { related_pin : "A"; cell_rise(scalar){values("0.2");} cell_fall(scalar){values("0.2");}
                 rise_transition(scalar){values("0.1");} fall_transition(scalar){values("0.1");} }
      timing() { related_pin : "B"; cell_rise(scalar){values("0.2");} cell_fall(scalar){values("0.2");}
                 rise_transition(scalar){values("0.1");} fall_transition(scalar){values("0.1");} } }
  }
  cell(NOR2x1) {
    area : 3;
    pin(A) { direction : input; capacitance : 1; }
    pin(B) { direction : input; capacitance : 1; }
    pin(Y) { direction : output; function : "(A+B)'";
      timing() { related_pin : "A"; cell_rise(scalar){values("0.2");} cell_fall(scalar){values("0.2");}
                 rise_transition(scalar){values("0.1");} fall_transition(scalar){values("0.1");} }
      timing() { related_pin : "B"; cell_rise(scalar){values("0.2");} cell_fall(scalar){values("0.2");}
                 rise_transition(scalar){values("0.1");} fall_transition(scalar){values("0.1");} } }
  }
  cell(AND2x1) {
    area : 3.5;
    pin(A) { direction : input; capacitance : 1; }
    pin(B) { direction : input; capacitance : 1; }
    pin(Y) { direction : output; function : "(A B)";
      timing() { related_pin : "A"; cell_rise(scalar){values("0.25");} cell_fall(scalar){values("0.25");}
                 rise_transition(scalar){values("0.1");} fall_transition(scalar){values("0.1");} }
      timing() { related_pin : "B"; cell_rise(scalar){values("0.25");} cell_fall(scalar){values("0.25");}
                 rise_transition(scalar){values("0.1");} fall_transition(scalar){values("0.1");} } }
  }
  cell(XOR2x1) {
    area : 5;
    pin(A) { direction : input; capacitance : 1; }
    pin(B) { direction : input; capacitance : 1; }
    pin(Y) { direction : output; function : "(A^B)";
      timing() { related_pin : "A"; cell_rise(scalar){values("0.3");} cell_fall(scalar){values("0.3");}
                 rise_transition(scalar){values("0.1");} fall_transition(scalar){values("0.1");} }
      timing() { related_pin : "B"; cell_rise(scalar){values("0.3");} cell_fall(scalar){values("0.3");}
                 rise_transition(scalar){values("0.1");} fall_transition(scalar){values("0.1");} } }
  }
  cell(DFFx1) {
    area : 6;
    ff(IQ, IQN) { next_state : "D"; clocked_on : "CLK";  }
    pin(CLK) { direction : input; capacitance : 1; clock : true; }
    pin(D)   { direction : input; capacitance : 1; }
    pin(Q) { direction : output; function : "IQ";
      timing() { related_pin : "CLK"; timing_type : rising_edge;
                 cell_rise(scalar){values("0.1");} cell_fall(scalar){values("0.1");}
                 rise_transition(scalar){values("0.1");} fall_transition(scalar){values("0.1");} } }
  }
  cell(DFFRx1) {
    area : 7;
    ff(IQ, IQN) { next_state : "D"; clocked_on : "CLK"; clear : "!RB"; }
    pin(CLK) { direction : input; capacitance : 1; clock : true; }
    pin(D)   { direction : input; capacitance : 1; }
    pin(RB) { direction : input; capacitance : 1; }
    pin(Q) { direction : output; function : "IQ";
      timing() { related_pin : "CLK"; timing_type : rising_edge;
                 cell_rise(scalar){values("0.1");} cell_fall(scalar){values("0.1");}
                 rise_transition(scalar){values("0.1");} fall_transition(scalar){values("0.1");} } }
  }
  cell(DFFSx1) {
    area : 7.5;
    ff(IQ, IQN) { next_state : "D"; clocked_on : "CLK"; preset : "S"; }
    pin(CLK) { direction : input; capacitance : 1; clock : true; }
    pin(D)   { direction : input; capacitance : 1; }
    pin(S) { direction : input; capacitance : 1; }
    pin(Q) { direction : output; function : "IQ";
      timing() { related_pin : "CLK"; timing_type : rising_edge;
                 cell_rise(scalar){values("0.1");} cell_fall(scalar){values("0.1");}
                 rise_transition(scalar){values("0.1");} fall_transition(scalar){values("0.1");} } }
  }
  cell(DFFRx0) {
    area : 6.5;
    dont_use : true;
    ff(IQ, IQN) { next_state : "D"; clocked_on : "CLK"; clear : "!RB"; }
    pin(CLK) { direction : input; capacitance : 1; clock : true; }
    pin(D)   { direction : input; capacitance : 1; }
    pin(RB) { direction : input; capacitance : 1; }
    pin(Q) { direction : output; function : "IQ";
      timing() { related_pin : "CLK"; timing_type : rising_edge;
                 cell_rise(scalar){values("0.1");} cell_fall(scalar){values("0.1");}
                 rise_transition(scalar){values("0.1");} fall_transition(scalar){values("0.1");} } }
  }
  cell(DFFRSx1) {
    area : 9;
    ff(IQ, IQN) { next_state : "D"; clocked_on : "CLK"; clear : "!RB"; preset : "!SB"; clear_preset_var1 : L; clear_preset_var2 : H; }
    pin(CLK) { direction : input; capacitance : 1; clock : true; }
    pin(D)   { direction : input; capacitance : 1; }
    pin(RB) { direction : input; capacitance : 1; }
    pin(SB) { direction : input; capacitance : 1; }
    pin(Q) { direction : output; function : "IQ";
      timing() { related_pin : "CLK"; timing_type : rising_edge;
                 cell_rise(scalar){values("0.1");} cell_fall(scalar){values("0.1");}
                 rise_transition(scalar){values("0.1");} fall_transition(scalar){values("0.1");} } }
  }
  cell(DLCLKPx1) {
    area : 8;
    clock_gating_integrated_cell : "latch_posedge";
    statetable("CLK GATE", "IQ") { table : "L L : - : L, L H : - : H, H - : - : N"; }
    pin(IQ) { direction : internal; internal_node : "IQ"; }
    pin(CLK) { direction : input; capacitance : 1; clock : true; clock_gate_clock_pin : true; }
    pin(GATE) { direction : input; capacitance : 1; clock_gate_enable_pin : true;
      timing() { related_pin : "CLK"; timing_type : setup_rising;
                 rise_constraint(scalar){values("0.05");} fall_constraint(scalar){values("0.05");} } }
    pin(GCLK) { direction : output; clock_gate_out_pin : true; state_function : "CLK & IQ";
      timing() { related_pin : "CLK"; timing_type : combinational;
                 cell_rise(scalar){values("0.1");} cell_fall(scalar){values("0.1");}
                 rise_transition(scalar){values("0.1");} fall_transition(scalar){values("0.1");} } }
  }
  cell(DLCLKPx2) {
    area : 9;
    clock_gating_integrated_cell : "latch_posedge";
    statetable("CLK GATE", "IQ") { table : "L L : - : L, L H : - : H, H - : - : N"; }
    pin(IQ) { direction : internal; internal_node : "IQ"; }
    pin(CLK) { direction : input; capacitance : 1; clock : true; clock_gate_clock_pin : true; }
    pin(GATE) { direction : input; capacitance : 1; clock_gate_enable_pin : true;
      timing() { related_pin : "CLK"; timing_type : setup_rising;
                 rise_constraint(scalar){values("0.05");} fall_constraint(scalar){values("0.05");} } }
    pin(GCLK) { direction : output; clock_gate_out_pin : true; state_function : "CLK & IQ";
      timing() { related_pin : "CLK"; timing_type : combinational;
                 cell_rise(scalar){values("0.1");} cell_fall(scalar){values("0.1");}
                 rise_transition(scalar){values("0.1");} fall_transition(scalar){values("0.1");} } }
  }
  cell(SDLCLKPx1) {
    area : 8.5;
    clock_gating_integrated_cell : "latch_posedge_precontrol";
    statetable("CLK GATE SCE", "IQ") { table : "L L L : - : L, L L H : - : H, L H L : - : H, L H H : - : H, H - - : - : N"; }
    pin(IQ) { direction : internal; internal_node : "IQ"; }
    pin(CLK) { direction : input; capacitance : 1; clock : true; clock_gate_clock_pin : true; }
    pin(GATE) { direction : input; capacitance : 1; clock_gate_enable_pin : true;
      timing() { related_pin : "CLK"; timing_type : setup_rising;
                 rise_constraint(scalar){values("0.05");} fall_constraint(scalar){values("0.05");} } }
    pin(SCE) { direction : input; capacitance : 1; clock_gate_test_pin : true; }
    pin(GCLK) { direction : output; clock_gate_out_pin : true; state_function : "CLK & IQ";
      timing() { related_pin : "CLK"; timing_type : combinational;
                 cell_rise(scalar){values("0.1");} cell_fall(scalar){values("0.1");}
                 rise_transition(scalar){values("0.1");} fall_transition(scalar){values("0.1");} } }
  }
  cell(DLCLKPx0) {
    area : 4;
    dont_use : true;
    clock_gating_integrated_cell : "latch_posedge";
    statetable("CLK GATE", "IQ") { table : "L L : - : L, L H : - : H, H - : - : N"; }
    pin(IQ) { direction : internal; internal_node : "IQ"; }
    pin(CLK) { direction : input; capacitance : 1; clock : true; clock_gate_clock_pin : true; }
    pin(GATE) { direction : input; capacitance : 1; clock_gate_enable_pin : true;
      timing() { related_pin : "CLK"; timing_type : setup_rising;
                 rise_constraint(scalar){values("0.05");} fall_constraint(scalar){values("0.05");} } }
    pin(GCLK) { direction : output; clock_gate_out_pin : true; state_function : "CLK & IQ";
      timing() { related_pin : "CLK"; timing_type : combinational;
                 cell_rise(scalar){values("0.1");} cell_fall(scalar){values("0.1");}
                 rise_transition(scalar){values("0.1");} fall_transition(scalar){values("0.1");} } }
  }
  cell(DLCLKNx1) {
    area : 3;
    clock_gating_integrated_cell : "latch_negedge";
    statetable("CLK GATE", "IQ") { table : "L L : - : L, L H : - : H, H - : - : N"; }
    pin(IQ) { direction : internal; internal_node : "IQ"; }
    pin(CLK) { direction : input; capacitance : 1; clock : true; clock_gate_clock_pin : true; }
    pin(GATE) { direction : input; capacitance : 1; clock_gate_enable_pin : true;
      timing() { related_pin : "CLK"; timing_type : setup_rising;
                 rise_constraint(scalar){values("0.05");} fall_constraint(scalar){values("0.05");} } }
    pin(GCLK) { direction : output; clock_gate_out_pin : true; state_function : "CLK | IQ";
      timing() { related_pin : "CLK"; timing_type : combinational;
                 cell_rise(scalar){values("0.1");} cell_fall(scalar){values("0.1");}
                 rise_transition(scalar){values("0.1");} fall_transition(scalar){values("0.1");} } }
  }
  cell(DLCLKOx1) {
    area : 2;
    clock_gating_integrated_cell : "latch_posedge";
    statetable("CLK GATE", "IQ") { table : "L L : - : L, L H : - : H, H - : - : N"; }
    pin(IQ) { direction : internal; internal_node : "IQ"; }
    pin(CLK) { direction : input; capacitance : 1; clock : true; clock_gate_clock_pin : true; }
    pin(GATE) { direction : input; capacitance : 1; clock_gate_enable_pin : true;
      timing() { related_pin : "CLK"; timing_type : setup_rising;
                 rise_constraint(scalar){values("0.05");} fall_constraint(scalar){values("0.05");} } }
    pin(GCLK) { direction : output; clock_gate_out_pin : true; state_function : "(CLK+IQ)";
      timing() { related_pin : "CLK"; timing_type : combinational;
                 cell_rise(scalar){values("0.1");} cell_fall(scalar){values("0.1");}
                 rise_transition(scalar){values("0.1");} fall_transition(scalar){values("0.1");} } }
  }
  cell(DLXTPx1) {
    area : 5;
    latch(IQ, IQN) { data_in : "D"; enable : "GATE"; }
    pin(GATE) { direction : input; capacitance : 1; clock : true; }
    pin(D) { direction : input; capacitance : 1; }
    pin(Q) { direction : output; function : "IQ";
      timing() { related_pin : "GATE"; timing_type : rising_edge;
                 cell_rise(scalar){values("0.1");} cell_fall(scalar){values("0.1");}
                 rise_transition(scalar){values("0.1");} fall_transition(scalar){values("0.1");} }
      timing() { related_pin : "D"; timing_type : combinational;
                 cell_rise(scalar){values("0.1");} cell_fall(scalar){values("0.1");}
                 rise_transition(scalar){values("0.1");} fall_transition(scalar){values("0.1");} } }
  }
  cell(DLXTPx2) {
    area : 5.5;
    latch(IQ, IQN) { data_in : "D"; enable : "GATE"; }
    pin(GATE) { direction : input; capacitance : 1; clock : true; }
    pin(D) { direction : input; capacitance : 1; }
    pin(Q) { direction : output; function : "IQ";
      timing() { related_pin : "GATE"; timing_type : rising_edge;
                 cell_rise(scalar){values("0.1");} cell_fall(scalar){values("0.1");}
                 rise_transition(scalar){values("0.1");} fall_transition(scalar){values("0.1");} }
      timing() { related_pin : "D"; timing_type : combinational;
                 cell_rise(scalar){values("0.1");} cell_fall(scalar){values("0.1");}
                 rise_transition(scalar){values("0.1");} fall_transition(scalar){values("0.1");} } }
  }
  cell(DLXTNx1) {
    area : 5;
    latch(IQ, IQN) { data_in : "D"; enable : "!GATE_N"; }
    pin(GATE_N) { direction : input; capacitance : 1; clock : true; }
    pin(D) { direction : input; capacitance : 1; }
    pin(Q) { direction : output; function : "IQ";
      timing() { related_pin : "GATE_N"; timing_type : rising_edge;
                 cell_rise(scalar){values("0.1");} cell_fall(scalar){values("0.1");}
                 rise_transition(scalar){values("0.1");} fall_transition(scalar){values("0.1");} }
      timing() { related_pin : "D"; timing_type : combinational;
                 cell_rise(scalar){values("0.1");} cell_fall(scalar){values("0.1");}
                 rise_transition(scalar){values("0.1");} fall_transition(scalar){values("0.1");} } }
  }
  cell(DLXBPx1) {
    area : 6;
    latch(IQ, IQN) { data_in : "D"; enable : "GATE"; }
    pin(GATE) { direction : input; capacitance : 1; clock : true; }
    pin(D) { direction : input; capacitance : 1; }
    pin(Q) { direction : output; function : "IQ";
      timing() { related_pin : "GATE"; timing_type : rising_edge;
                 cell_rise(scalar){values("0.1");} cell_fall(scalar){values("0.1");}
                 rise_transition(scalar){values("0.1");} fall_transition(scalar){values("0.1");} }
      timing() { related_pin : "D"; timing_type : combinational;
                 cell_rise(scalar){values("0.1");} cell_fall(scalar){values("0.1");}
                 rise_transition(scalar){values("0.1");} fall_transition(scalar){values("0.1");} } }
    pin(Q_N) { direction : output; function : "IQN";
      timing() { related_pin : "GATE"; timing_type : rising_edge;
                 cell_rise(scalar){values("0.1");} cell_fall(scalar){values("0.1");}
                 rise_transition(scalar){values("0.1");} fall_transition(scalar){values("0.1");} }
      timing() { related_pin : "D"; timing_type : combinational;
                 cell_rise(scalar){values("0.1");} cell_fall(scalar){values("0.1");}
                 rise_transition(scalar){values("0.1");} fall_transition(scalar){values("0.1");} } }
  }
  cell(DLXTPx0) {
    area : 3;
    dont_use : true;
    latch(IQ, IQN) { data_in : "D"; enable : "GATE"; }
    pin(GATE) { direction : input; capacitance : 1; clock : true; }
    pin(D) { direction : input; capacitance : 1; }
    pin(Q) { direction : output; function : "IQ";
      timing() { related_pin : "GATE"; timing_type : rising_edge;
                 cell_rise(scalar){values("0.1");} cell_fall(scalar){values("0.1");}
                 rise_transition(scalar){values("0.1");} fall_transition(scalar){values("0.1");} }
      timing() { related_pin : "D"; timing_type : combinational;
                 cell_rise(scalar){values("0.1");} cell_fall(scalar){values("0.1");}
                 rise_transition(scalar){values("0.1");} fall_transition(scalar){values("0.1");} } }
  }
  cell(ISOLATCHx1) {
    area : 2;
    is_isolation_cell : true;
    latch(IQ, IQN) { data_in : "D"; enable : "GATE"; }
    pin(GATE) { direction : input; capacitance : 1; clock : true; }
    pin(D) { direction : input; capacitance : 1; }
    pin(Q) { direction : output; function : "IQ";
      timing() { related_pin : "GATE"; timing_type : rising_edge;
                 cell_rise(scalar){values("0.1");} cell_fall(scalar){values("0.1");}
                 rise_transition(scalar){values("0.1");} fall_transition(scalar){values("0.1");} }
      timing() { related_pin : "D"; timing_type : combinational;
                 cell_rise(scalar){values("0.1");} cell_fall(scalar){values("0.1");}
                 rise_transition(scalar){values("0.1");} fall_transition(scalar){values("0.1");} } }
  }
  cell(SDLXTPx1) {
    area : 2.5;
    latch(IQ, IQN) { data_in : "D"; enable : "GATE"; }
    pin(GATE) { direction : input; capacitance : 1; clock : true; }
    pin(D) { direction : input; capacitance : 1; }
    pin(SCE) { direction : input; capacitance : 1; }
    pin(Q) { direction : output; function : "IQ";
      timing() { related_pin : "GATE"; timing_type : rising_edge;
                 cell_rise(scalar){values("0.1");} cell_fall(scalar){values("0.1");}
                 rise_transition(scalar){values("0.1");} fall_transition(scalar){values("0.1");} }
      timing() { related_pin : "D"; timing_type : combinational;
                 cell_rise(scalar){values("0.1");} cell_fall(scalar){values("0.1");}
                 rise_transition(scalar){values("0.1");} fall_transition(scalar){values("0.1");} } }
  }
  cell(DLRTPx1) {
    area : 6.5;
    latch(IQ, IQN) { data_in : "D"; enable : "GATE"; clear : "!RESET_B"; }
    pin(GATE) { direction : input; capacitance : 1; clock : true; }
    pin(D) { direction : input; capacitance : 1; }
    pin(RESET_B) { direction : input; capacitance : 1; }
    pin(Q) { direction : output; function : "IQ";
      timing() { related_pin : "GATE"; timing_type : rising_edge;
                 cell_rise(scalar){values("0.1");} cell_fall(scalar){values("0.1");}
                 rise_transition(scalar){values("0.1");} fall_transition(scalar){values("0.1");} }
      timing() { related_pin : "D"; timing_type : combinational;
                 cell_rise(scalar){values("0.1");} cell_fall(scalar){values("0.1");}
                 rise_transition(scalar){values("0.1");} fall_transition(scalar){values("0.1");} } }
  }
  cell(DLRTNx1) {
    area : 6.5;
    latch(IQ, IQN) { data_in : "D"; enable : "!GATE_N"; clear : "!RESET_B"; }
    pin(GATE_N) { direction : input; capacitance : 1; clock : true; }
    pin(D) { direction : input; capacitance : 1; }
    pin(RESET_B) { direction : input; capacitance : 1; }
    pin(Q) { direction : output; function : "IQ";
      timing() { related_pin : "GATE_N"; timing_type : rising_edge;
                 cell_rise(scalar){values("0.1");} cell_fall(scalar){values("0.1");}
                 rise_transition(scalar){values("0.1");} fall_transition(scalar){values("0.1");} }
      timing() { related_pin : "D"; timing_type : combinational;
                 cell_rise(scalar){values("0.1");} cell_fall(scalar){values("0.1");}
                 rise_transition(scalar){values("0.1");} fall_transition(scalar){values("0.1");} } }
  }
  cell(DLSTPx1) {
    area : 6.8;
    latch(IQ, IQN) { data_in : "D"; enable : "GATE"; preset : "SET"; }
    pin(GATE) { direction : input; capacitance : 1; clock : true; }
    pin(D) { direction : input; capacitance : 1; }
    pin(SET) { direction : input; capacitance : 1; }
    pin(Q) { direction : output; function : "IQ";
      timing() { related_pin : "GATE"; timing_type : rising_edge;
                 cell_rise(scalar){values("0.1");} cell_fall(scalar){values("0.1");}
                 rise_transition(scalar){values("0.1");} fall_transition(scalar){values("0.1");} }
      timing() { related_pin : "D"; timing_type : combinational;
                 cell_rise(scalar){values("0.1");} cell_fall(scalar){values("0.1");}
                 rise_transition(scalar){values("0.1");} fall_transition(scalar){values("0.1");} } }
  }
}
