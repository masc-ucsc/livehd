// A 3-entry array at index 3 writes and reads outside it. The write is dropped
// and the read is 0 (unchanged); each port warns once. A bounded index type
// reaching 3 is a compile error (upass.bitwidth index-out-of-range), so the
// index here is too wide for bitwidth to bound (past 62 bits).
pub mod warn_mem(x:U8, wa:U70, ra:U70) -> (y:U8@[0]) {
  reg a:[3]U8 = 0
  a[wa] = x
  y = a[ra]
}

test warn_mem.outside {
  mut d = warn_mem
  tick 5 {
    d.x  = 7
    d.wa = if clock >= 2 { 3 } else { 1 }
    d.ra = if clock >= 3 { 3 } else { 1 }
    step
    if clock >= 3 {
      assert(d.y == 0, "an outside read is 0")
    }
  }
}
