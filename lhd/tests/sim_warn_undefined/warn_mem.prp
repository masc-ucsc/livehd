// A 3-entry array indexed by a 70-bit address cannot be proven inside [0, 3):
// pass.bitwidth reports mem-address-overflow, so this file must NOT compile
// (sim_warn_undefined_test.sh asserts the rejection). Run-time out-of-range
// memory warnings are only reachable from Verilog (warn_vmem.v).
pub mod warn_mem(x:U8, wa:U70, ra:U70) -> (y:U8@[0]) {
  reg a:[3]U8 = 0
  a[wa] = x
  y = a[ra]
}

test warn_mem.outside {
  mut d = warn_mem
  tick 5 {
    d.x  = 7
    d.wa = if clock >= 2 { 3 } else { 1 }
    d.ra = if clock >= 3 { 3 } else { 1 }
    step
    if clock >= 3 {
      assert(d.y == 0, "an outside read is 0")
    }
  }
}
