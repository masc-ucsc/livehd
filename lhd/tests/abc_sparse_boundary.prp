/*
:name: abc_sparse_boundary
:type: lgraph compile
*/

// A wide native Set_mask boundary whose caller reads only two bits. pass.abc
// must create PIs/selectors for those demanded bits, not for all 4096 bits.
comb wide_update(base:U4096, bit:U1) -> (out:U4096) {
  mut tmp:U4096 = base
  tmp#[3072] = bit
  out = tmp
}

pub comb top(base:U4096, bit:U1) -> (y:U1) {
  const word = wide_update(base=base, bit=bit)
  y = word#[3072] ^ word#[7]
}
