const dut_m = import("lg:partial_oob_select")

test partial_oob_select.icarus {
  mut dut = dut_m
  tick 4 {
    dut.reset = false
    dut.a = 5 + clock * 3
    dut.b = (clock & 1) == 1
    dut.i = clock
    step
    const w0 = if clock == 0 { 7 } elif clock == 3 { 15 } else { 11 }
    const w1 = if clock == 0 { 2 } elif clock == 1 { 0 } elif clock == 2 { 6 } else { 4 }
    const w2 = if (clock & 1) == 0 { 1 } else { -2 }
    const w3 = if clock == 0 { 3 } elif clock == 1 { 6 } elif clock == 2 { 14 } else { 10 }
    assert(dut.o0 == w0, "t[1 -: 3] = 3'b111 writes only bits 1..0")
    assert(dut.o1 == w1, "a[1 -: 3] keeps a[1:0] in place")
    assert(dut.o2 == w2, "the signed comb nonblocking write re-signs")
    assert(dut.o3 == w3, "u[i +: 2] past the top writes only the bits that fit")
  }
}
