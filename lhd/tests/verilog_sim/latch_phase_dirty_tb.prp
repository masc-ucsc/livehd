const dut_m = import("lg:latch_phase_dirty")

test latch_phase_dirty.icarus {
  mut dut = dut_m
  tick 6 {
    dut.reset = clock < 2
    dut.e = clock != 4
    dut.d = clock + 10
    step
    if clock < 2 {
      assert(dut.o0 == clock + 10, "open while the clock is high")
    } elif clock == 4 {
      assert(dut.o0 == 13, "e == 0 holds the cycle-3 value")
    } else {
      assert(dut.o0 == clock + 10, "open while the clock is high")
    }
  }
}
