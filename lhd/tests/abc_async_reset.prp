// A Liberty containing only a plain DFF cannot represent either reset contract.
// The async register must react without a clock edge; the sync register must
// retain its reset/initial value rather than become an X-valued plain DFF before
// the first edge. pass.abc may still map both surrounding data cones.
pub mod abc_async_reset(clk:u1, rst:u1, d:u4) -> (async_q:u4@[], sync_q:u4@[]) {
  reg async_state:u4:[clock_pin=ref clk, reset_pin=ref rst, sync=false] = 0
  reg sync_state:u4:[clock_pin=ref clk, reset_pin=ref rst, sync=true] = 0ub1111
  async_q = async_state
  sync_q = sync_state
  async_state = d ^ 0ub1010
  sync_state = d ^ 0ub0101
}
