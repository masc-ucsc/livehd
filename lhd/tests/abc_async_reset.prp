// A Liberty containing only a plain DFF cannot represent an ASYNCHRONOUS reset:
// that register must react without a clock edge, so it stays a native flop
// (its data cone is still mapped). The SYNCHRONOUS register is a D-cone mux
// (`rst ? 0ub1111 : d ^ k`, reset over enable) and maps to DFF cells
// `sync_state_<bit>`: its `initial` is the reset value realized on D, and a
// plain DFF powers on X exactly like the source register's own always block.
pub mod abc_async_reset(clk:Clock, rst:Reset, d:U4) -> (async_q:U4@[], sync_q:U4@[]) {
  reg async_state:U4:[clock_pin=clk, reset_pin=rst, async=true] = 0
  reg sync_state:U4:[clock_pin=clk, reset_pin=rst, async=false] = 0ub1111
  async_q = async_state
  sync_q = sync_state
  async_state = d ^ 0ub1010
  sync_state = d ^ 0ub0101
}
