# lhd — the stateless, hermetic LiveHD CLI kernel (task 1y-bazel).
# Contract: the LiveHD docs. lhd links the pass/inou registry
# and drives it via argv; the legacy lgshell REPL was removed 2026-06-04.

load("//tools:regression.bzl", "cc_test")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")
load("//tools:copt_default.bzl", "COPTS")

# Formal-source content salt (2f-fcore ruling 2026-07-10): hash every prover
# source (pass/lec + pass/semdiff + the cvc5 pin) AND the proof preparation
# that shapes the graphs the verdict cache digests into a constant baked into
# the binary. The verdict cache keys on it, so a prover change auto-invalidates
# all cached verdicts while unrelated lhd rebuilds keep the cache warm.
#
# The cache key is the canonical digest of the PREPARED graphs, and that digest
# does not capture everything the preparation decides: two binaries whose
# prepared graphs differed only in how spliced cell state was named shared one
# key and replayed the older binary's verdict. So the preparation is engine
# identity too: pass/single_edge (time base, clock-gate fold, --lib/own-body
# cell splicing), //graph (inline_sub, latch_contract's latch semantics, the
# occurrence materializer, split_selfref), pass/cprop (the post-inline folds and
# the mixed-loop normalization that can return a no-solver PROVEN) and the lec
# driver itself (its semdiff skip gate and prep orchestration). //graph,
# pass/single_edge and pass/cprop are hashed through their library archives
# (their sources are not exported), like //pass/synth:synth_salt does.
# pass/lec/lib_cell_prep.* is already in //pass/lec:formal_srcs. shasum is
# macOS-native; sha256sum is the coreutils fallback (a failed exec consumes no
# stdin, so the pipe re-reads cleanly).
genrule(
    name = "formal_salt",
    srcs = [
        "lhd_kernel_formal.cpp",  # the lec driver: proof-prep orchestration, the semdiff no-solver skip gate
        "//core:formal_srcs",  # canonical_entity_name / reset_name_polarity moved here; pairing + reset semantics must stay salted
        "//graph",  # inline_sub, latch_contract, occurrence_materialize, split_selfref (archive)
        "//graph:node_util.hpp",  # logical hierarchy names are proof/cache identity
        "//graph:split_selfref.cpp",
        "//graph:split_selfref.hpp",
        "//pass/aegraph:pass_aegraph",  # the e-graph engine of the post-inline re-simplify (archive)
        "//pass/cprop:pass_cprop",  # post-inline folds + mixed-loop normalization (archive)
        "//pass/lec:formal_srcs",
        "//pass/place/pcrs:formal_srcs",
        "//pass/semdiff:formal_srcs",
        "//pass/single_edge:pass_single_edge",  # proof_prep: time base, clock gates, lib-cell splicing (archive)
        "//pass/synth:arith.hpp",  # cone_abc blasts bvmul/bvadd through the synthesis arithmetic builders
        "//packages:cvc5_repo.bzl",
        "//packages:cvc5_src.BUILD",
        "//packages:cvc5-offline.patch",
        "//packages:cvc5-kissat-fresh.patch",
        "//packages:cvc5-bv-unknown.patch",
    ] + select({
        "//:without_abc": [],
        # Salt CEC/full-adder detection when the optional accelerator exists.
        # An ABC-removed source checkout must not retain a patch dependency.
        "//conditions:default": ["//packages:abc.patch", "//packages:abc-physical.patch"],
    }),
    outs = ["formal_salt.hpp"],
    cmd = "h=$$(cat $(SRCS) | (shasum -a 256 2>/dev/null || sha256sum) | cut -c1-16); " +
          "printf '// Generated by //lhd:formal_salt -- DO NOT EDIT.\\n" +
          "// Content hash of pass/lec + pass/semdiff + the proof preparation +\\n" +
          "// the cvc5 pin: the formal verdict-cache engine-identity salt\\n" +
          "// (todo/livehd/2f-fcore.html sec 3).\\n" +
          "#pragma once\\n#include <cstdint>\\n" +
          "namespace livehd { inline constexpr uint64_t kFormalSrcSalt = 0x%sULL; }\\n' \"$$h\" > $@",
)

# Pyrope compile-cache engine identity. Hash the compiled frontend/lowering
# libraries plus the kernel seam that orchestrates them: any implementation
# edit that can change a cached LNAST/LGraph invalidates the scope without a
# hand-bumped version. Test-only sources are already excluded by these targets.
genrule(
    name = "compile_salt",
    srcs = [
        "lhd_compile_cache.cpp",
        "lhd_compile_cache.hpp",
        "lhd_kernel_common.cpp",
        "lhd_kernel_compile.cpp",
        "lhd_kernel_internal.hpp",
        "//core",
        "//core:file_name",
        "//core:pyrope_ident",
        "//core:sim_values",
        "//pass/specialize:specialize_srcs",
        "//pass/sweep:sweep_srcs",
        "//pass/satopt:satopt_srcs",
        "//pass/synth:synth_srcs",
        "//graph",
        "//inou/prp:inou_prp",
        "//inou/slang:inou_slang",
        "//lnast",
        "//pass/bitfuzz:pass_bitfuzz",
        "//pass/aegraph:pass_aegraph",
        "//pass/bitwidth:pass_bitwidth",
        "//pass/cprop:pass_cprop",
        "//pass/enableopt:pass_enableopt",
        "//pass/formal:pass_formal",
        "//pass/legalize",
        "//pass/liberty:liberty_dff",
        "//pass/lnastfmt:pass_lnastfmt",
        "//pass/place/pcrs",
        "//pass/semdiff",
        "//pass/upass:pass_upass",
        "//upass/runner:upass_runner",  # the lowering itself: a genrule src of a cc_library hashes only THAT target's archive, and pass_upass's does not contain upass_runner.o
        "//upass/aeg:upass_aeg",  # the tree aegraph step the runner runs before its DCE
        "//upass/tolg:upass_tolg",
    ] + select({
        "//:without_abc": [],
        "//conditions:default": ["//pass/abc:mapper_srcs"],
    }),
    outs = ["compile_salt.hpp"],
    cmd = "h=$$(cat $(SRCS) | (shasum -a 256 2>/dev/null || sha256sum) | cut -c1-16); " +
          "printf '// Generated by //lhd:compile_salt -- DO NOT EDIT.\\n" +
          "// Content hash of the Pyrope frontend and lowering closure: the compile\\n" +
          "// incremental-cache engine identity (docs/opt_loop_incr.md L8).\\n" +
          "#pragma once\\n#include <cstdint>\\n" +
          "namespace livehd { inline constexpr uint64_t kCompileSrcSalt = 0x%sULL; }\\n' \"$$h\" > $@",
)

# The profile-guided sim tuner's model (sim_profile.md §5-§8): the JSONL tune
# store, the workdir lock and CoW retention (lhd_tune), and the pure sim policy
# (lhd_sim_tune). Its own small library so lhd_sim_tune_test pins the policy
# without linking the engine, and deliberately OUTSIDE :compile_salt -- no tune
# change can touch a cached LNAST/LGraph, so none may cold-start a compile scope.
cc_library(
    name = "lhd_tune",
    srcs = [
        "lhd_sim_tune.cpp",
        "lhd_tune.cpp",
    ],
    hdrs = [
        "lhd_sim_tune.hpp",
        "lhd_tune.hpp",
    ],
    copts = COPTS,
    includes = ["."],
    visibility = ["//visibility:public"],
    deps = [
        "//core:file_utils",
        "//core:serialization_hdrs",
        "//inou/cgen:sim_tune_hdrs",
        "@rapidjson",
    ],
)

cc_test(
    name = "lhd_sim_tune_test",
    srcs = ["lhd_sim_tune_test.cpp"],
    copts = COPTS,
    deps = [
        ":lhd_tune",
        "@googletest//:gtest_main",
    ],
)

