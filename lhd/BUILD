# The run-time half of the LLVM testbench flow (todo/livehd/2sl-llvm-only-sim.md): loads the DUT kernel objects
# and the testbench object through OrcJIT and runs the tests. A small executable of its own on purpose --
# starting the compiler binary costs over a second -- that links none of the compiler (the ABI is header-only).
cc_binary(
    name = "lhd_simrt",
    srcs = [
        "lhd_sim_llvm_rt.cpp",
        "lhd_sim_observe.cpp",
        "lhd_sim_observe.hpp",
    ],
    copts = COPTS,
    additional_linker_inputs = select({
        "@platforms//os:macos": ["lhd_simrt_exports.txt"],
        "//conditions:default": [],
    }),
    linkopts = select({
        "@platforms//os:macos": ["-Wl,-exported_symbols_list,$(location lhd_simrt_exports.txt)"],
        "//conditions:default": [],
    }),
    visibility = ["//visibility:public"],
    deps = [
        "//core:file_utils",
        "//core:serialization_hdrs",
        "//core:sim_program",
        "//core:sim_values",
        "//inou/cgen:sim_native_rt",
        "//inou/prp:tb_abi",
        "//inou/prp:tb_integer",
        "@hlop//hlop",
        "@rapidjson",
    ],
)

[cc_binary(
    name = name,
    testonly = test_fixture,
    local_defines = ["LHD_TEST_GUI_JOB_PROBE"] if test_fixture else [],
    srcs = [
        "lhd_main.cpp",
        "lhd_pyrope.cpp",
        "lhd_pyrope.hpp",
    ],
    copts = COPTS,
    data = [
        "chunk_flow.py",
        "chunk_dispatch.py",
        "chunk_resources.py",
        ":lhd_simrt",
        "chunk_interfaces.py",
        "chunk_explore.py",
        "chunk_validate.py",
        "//tools:clock_probe",
        "chunk_calibrate.py",
        "chunk_live.py",
        "chunk_score.py",
        "chunk_journal.py",
        "chunk_gui.html",
        "@dreamplace//thirdparty/flute:flute",
        "//ware:cgen_memory_rtl",
    ] + select({
        "//:without_abc": [],
        "//conditions:default": ["//inou/yosys:scripts"],
    }),
    additional_linker_inputs = select({
        ":dbg_macos": ["lhd_dbg_exports.txt"],
        "//conditions:default": [],
    }),
    # Export Yosys symbols for optional user plugins; read_slang is built in.
    # A -c dbg macOS build exports nothing instead: dyld otherwise spends ~1 s
    # binding its weak C++ exports at every start, which dominated every debug
    # CLI test. Yosys user plugins need an optimized build there.
    linkopts = select({
        "@platforms//os:macos": [],
        "//conditions:default": [
            "-Wl,--export-dynamic",
        ],
    }) + select({
        ":dbg_macos": ["-Wl,-exported_symbols_list,$(location lhd_dbg_exports.txt)"],
        "//conditions:default": [],
    }),
    visibility = ["//visibility:public"],
    deps = [
        ":lhd_lib",
        "//pass/place:gui",
        "@rules_cc//cc/runfiles",
        "//inou/prp:pyrope_style",
        "//lsp",
        "//pass/cost:host_mem",
        "@tree_sitter",
        "@tree_sitter_pyrope//:prpfmt",
    ],
) for name, test_fixture in [("lhd", False), ("lhd_gui_fixture", True)]]

