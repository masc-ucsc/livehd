# Common, ABC-free synthesis infrastructure shared by every mapper backend
# (pass/abc) and by unate synthesis (pass/usyn): the arithmetic builders, the
# Lnet (the flat k-LUT network a region is blasted into), ware and memory
# lowering, the SAT simplifications (the mux-fact sweep takes its prover as a
# callback), loop preparation, the region driver and writer, and the
# parallel-lane scheduler. Nothing here may include or link ABC
# (abc_cleanup.md).

load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("//tools:copt_default.bzl", "COPTS")

# `synth_salt.hpp` is excluded from the glob because it is this rule's own
# OUTPUT; globbing a generated header back in as a source is a cycle.
filegroup(
    name = "synth_srcs",
    visibility = ["//visibility:public"],
    srcs = glob(
        [
            "*.cpp",
            "*.hpp",
        ],
        exclude = [
            "synth_salt.hpp",
            "*_test.cpp",
            "*_smoke.cpp",
        ],
    ),
)

# The code identity of everything a mapped region depends on outside its
# backend: this package, the graph library (private occurrence expansion and
# inlining), the memory RTL and its generators/importers, the passes that
# prepare the synthesis copy, the register-cell pick and the partitioner.
#
# `pass/partition` decides region boundaries and boundary port names, and those
# ARE the shape of the region-cache key (docs/opt_loop_incr.md F8), so a
# partitioner change can invalidate a mapped body just as a mapper change can.
#
# `pass/liberty/liberty_dff.*` picks the DFF cell a mapped body's Sub decl names
# (and whether its QN pin is read as Q), so a ranking change confined to that
# file must invalidate cached bodies too.
#
# Backend salts fold this one in: //pass/abc:abc_salt hashes synth_salt.hpp,
# and //pass/usyn:usyn_salt hashes abc_salt.hpp.
genrule(
    name = "synth_salt",
    srcs = [
        ":synth_srcs",
        "//graph",
        "//ware:cgen_memory_rtl",
        "//inou/cgen:memory_generator_srcs",
        "//inou/yosys:memory_import_srcs",
        "//pass/cprop:pass_cprop",
        "//pass/enableopt:pass_enableopt",
        "//pass/bitwidth:pass_bitwidth",
        "//pass/color:pass_color",  # shared pattern identity
        "//pass/liberty:liberty_dff_srcs",
        "//pass/formal:formal",  # memory and selector proof semantics
        "//pass/partition:partition_srcs",
    ],
    outs = ["synth_salt.hpp"],
    visibility = [
        "//pass/abc:__pkg__",
        "//pass/satopt:__pkg__",
    ],
    cmd = "h=$$(cat $(SRCS) | (shasum -a 256 2>/dev/null || sha256sum) | cut -c1-16); " +
          "printf '// Generated by //pass/synth:synth_salt -- DO NOT EDIT.\\n" +
          "// Content hash of pass/synth and the passes it builds on: the shared\\n" +
          "// synthesis code salt that every backend salt folds in.\\n" +
          "#pragma once\\n#include <cstdint>\\n" +
          "namespace livehd::synth { inline constexpr uint64_t kSynthSrcSalt = 0x%sULL; }\\n' \"$$h\" > $@",
)

cc_library(
    name = "synth",
    srcs = glob(
        ["*.cpp"],
        exclude = [
            "*_test.cpp",
            "*_smoke.cpp",
        ],
    ),
    hdrs = glob(
        ["*.hpp"],
        exclude = ["synth_salt.hpp"],
    ) + [":synth_salt"],
    copts = COPTS,
    includes = ["."],
    visibility = ["//visibility:public"],
    deps = [
        "//core",
        "//graph",
        "//pass/bitwidth:pass_bitwidth",
        "//pass/color:pass_color",
        "//pass/common:pass",
        "//pass/cprop:pass_cprop",
        "//pass/enableopt:pass_enableopt",
        "//pass/cost:host_mem",
        "//pass/formal:formal",
        "//pass/liberty:liberty_dff",
        "//pass/partition:pass_partition",
        "//pass/semdiff:semdiff",  # region cache: structural_identical
        "@abseil-cpp//absl/container:btree",
        "@abseil-cpp//absl/container:flat_hash_map",
        "@abseil-cpp//absl/container:flat_hash_set",
        "@abseil-cpp//absl/container:node_hash_map",
        "@rapidjson",
    ],
)

exports_files(["arith.hpp"])

# Functional unit test for the backend-agnostic adder/comparator builders
# (arith.hpp), instantiated with a software bit model.
cc_test(
    name = "arith_test",
    srcs = [
        "arith.hpp",
        "arith_test.cpp",
    ],
    copts = COPTS,
    includes = ["."],
    deps = ["@googletest//:gtest_main"],
)

