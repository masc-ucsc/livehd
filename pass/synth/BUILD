load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")
load("//tools:copt_default.bzl", "COPTS")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

# `synth_salt.hpp` is excluded from the glob because it is this package's own
# generated OUTPUT; globbing a generated header back in as a source is a cycle.
filegroup(
    name = "mapper_srcs",
    visibility = ["//visibility:public"],
    srcs = glob(
        [
            "*.cpp",
            "*.hpp",
        ],
        exclude = [
            "synth_salt.hpp",
            "*_test.cpp",
            "*_smoke.cpp",
            "measure_synth.cpp",
        ],
    ),
)

# The pass.synth code salt. It hashes this package PLUS //pass/abc:abc_salt, so
# it inherits ABC's identity transitively without re-listing it -- and, crucially,
# abc_salt does NOT hash pass/synth: an edit here must not cold-start the DEFAULT
# ABC incremental cache of every `lhd synth`/`lhd pass abc` user.
genrule(
    name = "synth_salt",
    srcs = [
        ":mapper_srcs",
        "//pass/abc:abc_salt",
    ],
    outs = ["synth_salt.hpp"],
    cmd = "h=$$(cat $(SRCS) | (shasum -a 256 2>/dev/null || sha256sum) | cut -c1-16); " +
          "printf '// Generated by //pass/synth:synth_salt -- DO NOT EDIT.\\n" +
          "// Content hash of pass/synth + the //pass/abc:abc_salt header: the\\n" +
          "// pass.synth producer identity for caches, witnesses and provenance.\\n" +
          "#pragma once\\n#include <cstdint>\\n" +
          "namespace livehd::synth { inline constexpr uint64_t kSynthSrcSalt = 0x%sULL; }\\n' \"$$h\" > $@",
)

# ONE library per pass, as every other pass/ package does (pass/abc, pass/cprop,
# pass/opentimer, ...). The optimizer, its bounded search extensions, the ABC
# technology-mapping backend and the proof/publication layer are one unit: they
# share Search_options and the witness/report vocabulary, and splitting them into
# a dozen micro-libraries only hid that from the build graph.
cc_library(
    name = "pass_synth",
    srcs = glob(
        ["*.cpp"],
        exclude = [
            "*_test.cpp",
            "*_smoke.cpp",
            "measure_synth.cpp",
        ],
    ),
    hdrs = glob(
        ["*.hpp"],
        exclude = ["synth_salt.hpp"],
    ) + [":synth_salt"],
    copts = COPTS,
    includes = ["."],
    visibility = ["//visibility:public"],
    deps = [
        "//core",
        "//graph",
        "//pass/abc:pass_abc",
        "//pass/common:pass",
        "//pass/cost:host_mem",
        "//pass/cprop:pass_cprop",
        "//pass/lec:lec_query",
        "//pass/liberty:pass_liberty",
        "//pass/opentimer:pass_opentimer",
        "//pass/single_edge:pass_single_edge",  # proof_prep: the time base `lhd lec` proves in
        "@abc",
        "@llvm-project//llvm:Support",
        "@rapidjson",
    ],
    alwayslink = True,  # static Pass_plugin registration
)

# The independent Python checkers, shared with //lhd/tests.
filegroup(
    name = "witness_checker",
    srcs = [
        "check_provenance.py",
        "check_witness.py",
        "summarize.py",
    ],
    visibility = ["//visibility:public"],
)

cc_binary(
    name = "measure_synth",
    srcs = ["measure_synth.cpp"],
    copts = COPTS,
    visibility = ["//lhd/tests:__pkg__"],
    deps = [
        "//pass/cost:host_mem",
        "//pass/cost:process_tree",
        "@rapidjson",
    ],
)

# ---------------------------------------------------------------------------
# C++ unit tests. One per source file, linking the whole pass library -- the
# pass/abc convention.
# ---------------------------------------------------------------------------

[cc_test(
    name = name,
    srcs = [name + ".cpp"],
    copts = COPTS,
    linkopts = ["-lz"],
    data = data,
    deps = [
        ":pass_synth",
        "//graph",
        "@abc",
        "@rapidjson",
        "@googletest//:gtest_main",
    ],
) for name, data in [
    ("abc_region_test", ["//lhd", "//inou/prp:abc_tests"]),
    ("abc_timing_test", []),
    ("abc_tmap_test", ["//inou/prp:abc_tests"]),
    ("abc_worker_test", ["//lhd", "//inou/prp:abc_tests"]),
    ("metrics_test", []),
    ("pass_synth_test", ["//inou/prp:abc_tests"]),
    ("provenance_test", []),
    ("resource_budget_test", []),
    ("template_cache_test", []),
    ("tmap_test", []),
    ("unate_test", []),
    ("witness_test", []),
]]

# ---------------------------------------------------------------------------
# Python checkers/smokes. The repo runs a `.py` directly as an sh_test src (see
# //lhd/tests:lhd_lsp_test); no `exec python3 ...` shell wrapper is needed.
# ---------------------------------------------------------------------------

sh_test(
    name = "witness_check_smoke",
    srcs = ["check_witness_test.py"],
    data = ["check_witness.py"],
)

sh_test(
    name = "provenance_check_smoke",
    srcs = ["check_provenance_test.py"],
    data = ["check_provenance.py"],
)

sh_test(
    name = "summary_check_smoke",
    srcs = ["summarize_test.py"],
    data = [
        "check_witness.py",
        "check_witness_test.py",
        "summarize.py",
    ],
)

sh_test(
    name = "encoding_codes_smoke",
    srcs = ["encoding_codes_smoke.py"],
    data = [
        ":abc_tmap_test",
        ":measure_synth",
        ":witness_checker",
        "//inou/prp:abc_tests",
        "//lhd",
    ],
)

sh_test(
    name = "measurement_smoke",
    srcs = ["measurement_smoke.py"],
    data = [
        ":measure_synth",
        "//inou/prp:abc_tests",
        "//lhd",
    ],
)

sh_test(
    name = "comparison_smoke",
    srcs = ["comparison_smoke.sh"],
    data = [
        "compare.py",
        ":measure_synth",
        "//inou/prp:abc_tests",
        "//lhd",
    ],
)

