load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("//tools:copt_default.bzl", "COPTS")

# Post-freeze provisional domino code (todo/livehd/2d-domplace.html). It lives
# outside pass/usyn so that editing it never changes kUsynSrcSalt and never
# misses the logical region cache; its products are keyed by this salt.
filegroup(
    name = "domplace_srcs",
    srcs = glob(
        [
            "*.cpp",
            "*.hpp",
        ],
        exclude = [
            "domplace_salt.hpp",
            "*_test.cpp",
        ],
    ),
    visibility = ["//visibility:public"],
)

genrule(
    name = "domplace_salt",
    srcs = [
        ":domplace_srcs",
        "//pass/liberty:timing_model_sources",
        "//pass/usyn:usyn_salt",
    ],
    outs = ["domplace_salt.hpp"],
    cmd = "h=$$(cat $(SRCS) | (shasum -a 256 2>/dev/null || sha256sum) | cut -c1-16); " +
          "printf '// Generated by //pass/domplace:domplace_salt -- DO NOT EDIT.\\n" +
          "// Content hash of pass/domplace + the Liberty timing model + //pass/usyn:usyn_salt:\\n" +
          "// the provisional domino producer identity for caches and provenance.\\n" +
          "#pragma once\\n#include <cstdint>\\n" +
          "namespace livehd::domplace { inline constexpr uint64_t kDomplaceSrcSalt = 0x%sULL; }\\n' \"$$h\" > $@",
    visibility = ["//visibility:public"],
)

# The stage schedule and the stable reason codes: data only, no dependencies.
cc_library(
    name = "contract",
    hdrs = [
        "reason.hpp",
        "stage_model.hpp",
        ":domplace_salt",
    ],
    copts = COPTS,
    includes = ["."],
    visibility = ["//visibility:public"],
)

# The named reference inverter and register family of the area model.
cc_library(
    name = "domino_reference",
    srcs = ["domino_reference.cpp"],
    hdrs = ["domino_reference.hpp"],
    copts = COPTS,
    includes = ["."],
    visibility = ["//visibility:public"],
    deps = [
        "//core",
        "//pass/liberty:liberty_dff",
        "//pass/liberty:timing_model",
        "//pass/usyn:usyn_logic",
    ],
)

cc_test(
    name = "domino_reference_test",
    size = "small",
    srcs = ["domino_reference_test.cpp"],
    copts = COPTS,
    deps = [
        ":domino_reference",
        "@googletest//:gtest_main",
    ],
)
