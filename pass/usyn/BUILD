load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//tools:copt_default.bzl", "COPTS")

# Sources outside the native pass.usyn closure: the legacy per-region flow
# (no longer reached from pass.usyn) and the LUT cover kept for
# //pass/domino:usyn_ab. Editing them must not change kUsynSrcSalt.
LEGACY_SRCS = [
    "evidence.cpp",
    "evidence.hpp",
    "lut_cover.cpp",
    "lut_cover.hpp",
    "metrics.cpp",
    "metrics.hpp",
    "usyn_region.cpp",
    "usyn_region.hpp",
]

# `usyn_salt.hpp` is excluded from the glob because it is this package's own
# generated OUTPUT; globbing a generated header back in as a source is a cycle.
filegroup(
    name = "mapper_srcs",
    srcs = glob(
        [
            "*.cpp",
            "*.hpp",
            "*.inc",
        ],
        exclude = [
            "usyn_salt.hpp",
            "*_test.cpp",
            "*_smoke.cpp",
            "measure_synth.cpp",
        ] + LEGACY_SRCS,
    ),
    visibility = ["//visibility:public"],
)

# Logical synthesis identity is independent of the optional mapping provider.
genrule(
    name = "usyn_salt",
    srcs = [
        ":mapper_srcs",
        "//pass/synth:synth_salt",
    ],
    outs = ["usyn_salt.hpp"],
    cmd = "h=$$(cat $(SRCS) | (shasum -a 256 2>/dev/null || sha256sum) | cut -c1-16); " +
          "printf '// Generated by //pass/usyn:usyn_salt -- DO NOT EDIT.\\n" +
          "// Content hash of pass/usyn + the //pass/synth:synth_salt header: the\\n" +
          "// unate-synthesis producer identity for caches and provenance.\\n" +
          "#pragma once\\n#include <cstdint>\\n" +
          "namespace livehd::usyn { inline constexpr uint64_t kUsynSrcSalt = 0x%sULL; }\\n' \"$$h\" > $@",
)

# Boolean synthesis has no graph, solver or mapping dependency. Keep this
# closure independently testable while replacing the legacy pass entry.
cc_library(
    name = "usyn_logic",
    srcs = [
        "decomposition.cpp",
        "endpoint.cpp",
        "endpoint_pairs.cpp",
        "function.cpp",
        "joint_endpoint.cpp",
        "residual.cpp",
        "npn4.cpp",
        "sop_factor.cpp",
        "unate.cpp",
        "xag.cpp",
        "xag_balance.cpp",
        "xag_choice.cpp",
        "xag_representations.cpp",
        "xag_sweep.cpp",
    ],
    hdrs = [
        "decomposition.hpp",
        "endpoint.hpp",
        "endpoint_pairs.hpp",
        "function.hpp",
        "joint_endpoint.hpp",
        "residual.hpp",
        "npn4.hpp",
        "sop_factor.hpp",
        "npn4_data.inc",
        "unate.hpp",
        "xag.hpp",
        "xag_balance.hpp",
        "xag_choice.hpp",
        "xag_representations.hpp",
        "xag_sweep.hpp",
    ],
    copts = COPTS,
    includes = ["."],
    visibility = ["//visibility:public"],
)

