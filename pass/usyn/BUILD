load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")
load("//tools:copt_default.bzl", "COPTS")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

# `usyn_salt.hpp` is excluded from the glob because it is this package's own
# generated OUTPUT; globbing a generated header back in as a source is a cycle.
filegroup(
    name = "mapper_srcs",
    visibility = ["//visibility:public"],
    srcs = glob(
        [
            "*.cpp",
            "*.hpp",
        ],
        exclude = [
            "usyn_salt.hpp",
            "*_test.cpp",
            "*_smoke.cpp",
            "measure_synth.cpp",
        ],
    ),
)

# The unate-synthesis code salt: this package PLUS //pass/abc:abc_salt (which
# itself folds //pass/synth:synth_salt), so usyn inherits the shared blaster
# and ABC identities transitively. abc_salt does NOT hash pass/usyn: an edit
# here must not cold-start the DEFAULT ABC incremental cache of every
# `lhd synth`/`lhd pass abc` user.
genrule(
    name = "usyn_salt",
    srcs = [
        ":mapper_srcs",
        "//pass/abc:abc_salt",
    ],
    outs = ["usyn_salt.hpp"],
    cmd = "h=$$(cat $(SRCS) | (shasum -a 256 2>/dev/null || sha256sum) | cut -c1-16); " +
          "printf '// Generated by //pass/usyn:usyn_salt -- DO NOT EDIT.\\n" +
          "// Content hash of pass/usyn + the //pass/abc:abc_salt header: the\\n" +
          "// unate-synthesis producer identity for caches and provenance.\\n" +
          "#pragma once\\n#include <cstdint>\\n" +
          "namespace livehd::usyn { inline constexpr uint64_t kUsynSrcSalt = 0x%sULL; }\\n' \"$$h\" > $@",
)

# ONE library per pass, as every other pass/ package does (pass/abc, pass/cprop,
# pass/opentimer, ...): the LUT cover, its region hook and the pass entry.
cc_library(
    name = "pass_usyn",
    srcs = glob(
        ["*.cpp"],
        exclude = [
            "*_test.cpp",
            "*_smoke.cpp",
            "measure_synth.cpp",
        ],
    ),
    hdrs = glob(
        ["*.hpp"],
        exclude = ["usyn_salt.hpp"],
    ) + [":usyn_salt"],
    copts = COPTS,
    includes = ["."],
    visibility = ["//visibility:public"],
    deps = [
        "//core",
        "//graph",
        "//pass/abc:pass_abc",
        "//pass/common:pass",
        "//pass/cost:host_mem",
        "//pass/cprop:pass_cprop",
        "//pass/synth",
        "@llvm-project//llvm:Support",  # provenance: SHA-256 of the archived inputs
        "@rapidjson",
    ],
    alwayslink = True,  # static Pass_plugin registration
)

# The independent provenance checker, shared with //lhd/tests.
filegroup(
    name = "provenance_checker",
    srcs = ["check_provenance.py"],
    visibility = ["//visibility:public"],
)

cc_binary(
    name = "measure_synth",
    srcs = ["measure_synth.cpp"],
    copts = COPTS,
    visibility = ["//lhd/tests:__pkg__"],
    deps = [
        "//pass/cost:host_mem",
        "//pass/cost:process_tree",
        "@rapidjson",
    ],
)

# ---------------------------------------------------------------------------
# C++ unit tests. One per source file, linking the whole pass library -- the
# pass/abc convention.
# ---------------------------------------------------------------------------

[cc_test(
    name = name,
    srcs = [name + ".cpp"],
    copts = COPTS,
    linkopts = ["-lz"],
    data = data,
    deps = [
        ":pass_usyn",
        "//graph",
        "@abc",
        "@rapidjson",
        "@googletest//:gtest_main",
    ],
) for name, data in [
    ("usyn_region_test", []),
    ("evidence_test", []),
    ("lut_cover_test", []),
    ("metrics_test", []),
    ("pass_usyn_test", ["//inou/prp:abc_tests"]),
    ("provenance_test", []),
    ("resource_budget_test", []),
    ("unate_test", []),
]]

# ---------------------------------------------------------------------------
# Python checkers/smokes. The repo runs a `.py` directly as an sh_test src (see
# //lhd/tests:lhd_lsp_test); no `exec python3 ...` shell wrapper is needed.
# ---------------------------------------------------------------------------

sh_test(
    name = "provenance_check_smoke",
    srcs = ["check_provenance_test.py"],
    data = ["check_provenance.py"],
)

sh_test(
    name = "measurement_smoke",
    srcs = ["measurement_smoke.py"],
    data = [
        ":measure_synth",
        "//inou/prp:abc_tests",
        "//lhd",
    ],
)

sh_test(
    name = "comparison_smoke",
    srcs = ["comparison_smoke.sh"],
    data = [
        "compare.py",
        ":measure_synth",
        "//inou/prp:abc_tests",
        "//lhd",
    ],
)

