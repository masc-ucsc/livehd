cc_library(
    name = "pass_usyn",
    srcs = glob(
        ["*.cpp"],
        exclude = [
            "*_test.cpp",
            "*_smoke.cpp",
            "measure_synth.cpp",
            "design_synth.cpp",
            "artifact.cpp",
            "cmos_cleanup.cpp",
            "decomposition.cpp",
            "endpoint.cpp",
            "endpoint_lnet.cpp",
            "endpoint_netlist.cpp",
            "endpoint_pairs.cpp",
            "function.cpp",
            "joint_endpoint.cpp",
            "native_cost.cpp",
            "npn4.cpp",
            "logical_region.cpp",
            "logical_cache.cpp",
            "logical_writer.cpp",
            "region_emit.cpp",
            "residual.cpp",
            "semantic_region.cpp",
            "sop_factor.cpp",
            "unate.cpp",
            "xag.cpp",
            "xag_balance.cpp",
            "xag_choice.cpp",
            "xag_representations.cpp",
            "xag_opt.cpp",
            "xag_sweep.cpp",
            "xag_lnet.cpp",
        ] + LEGACY_SRCS,
    ),
    hdrs = glob(
        ["*.hpp"],
        exclude = ["usyn_salt.hpp"] + LEGACY_SRCS,
    ) + [":usyn_salt"],
    copts = COPTS,
    includes = ["."],
    visibility = ["//visibility:public"],
    deps = [
        ":native_cost",
        ":usyn_lnet",
        ":usyn_logic",
        ":usyn_semantic",
        "//core",
        "//graph",
        "//pass/common:pass",
        "//pass/cost:host_mem",
        "//pass/cprop:pass_cprop",
        "//pass/synth",
        "@llvm-project//llvm:Support",  # provenance: SHA-256 of the archived inputs
        "@rapidjson",
    ],
    alwayslink = True,  # static Pass_plugin registration
)

