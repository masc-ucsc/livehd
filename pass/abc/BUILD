load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("//tools:copt_default.bzl", "COPTS")

# Mapper-engine identity for the persistent synthesis cache: this package, the
# shared synthesis salt (//pass/synth:synth_salt: the blasters, the memory and
# ware lowering, the partitioner, the register-cell pick, ...) and the @abc
# pin. Any implementation or ABC-pin change automatically invalidates mapped
# bodies; unrelated lhd rebuilds leave the cache warm. Hash the module pin
# conservatively via the workspace MODULE file and local patches because both
# define the @abc code.
#
# `abc_salt.hpp` is excluded from the glob because it is this rule's own
# OUTPUT; globbing a generated header back in as a source is a cycle.
filegroup(
    name = "mapper_srcs",
    visibility = ["//visibility:public"],
    srcs = glob(
        [
            "*.cpp",
            "*.hpp",
        ],
        exclude = [
            "abc_salt.hpp",
            "*test*.cpp",
            "*_smoke.cpp",
        ],
    ),
)

genrule(
    name = "abc_salt",
    visibility = ["//pass/usyn:__pkg__"],
    srcs = [
        ":mapper_srcs",
        "//pass/satopt:satopt_salt",
        "//pass/synth:synth_salt",
        "//:MODULE.bazel",
        "//packages:abc.patch",
    ],
    outs = ["abc_salt.hpp"],
    cmd = "h=$$(cat $(SRCS) | (shasum -a 256 2>/dev/null || sha256sum) | cut -c1-16); " +
          "printf '// Generated by //pass/abc:abc_salt -- DO NOT EDIT.\\n" +
          "// Content hash of pass/abc + the //pass/synth:synth_salt header + the @abc\\n" +
          "// pin: the ABC incremental-cache code salt (docs/opt_loop_incr.md L2).\\n" +
          "#pragma once\\n#include <cstdint>\\n" +
          "namespace livehd::abc { inline constexpr uint64_t kAbcSrcSalt = 0x%sULL; }\\n' \"$$h\" > $@",
)

cc_library(
    name = "pass_abc",
    srcs = glob(
        ["*.cpp"],
        exclude = ["*test*.cpp", "*_smoke.cpp"],
    ),
    hdrs = glob(
        ["*.hpp"],
        exclude = ["abc_salt.hpp"],
    ) + [":abc_salt"],
    copts = COPTS,
    includes = ["."],
    visibility = ["//visibility:public"],
    deps = [
        "//core",
        "//graph",
        "//pass/common:pass",
        "//pass/cprop:pass_cprop",
        "//pass/enableopt:pass_enableopt",
        "//pass/color:pass_color",
        "//pass/bitwidth:pass_bitwidth",
        "//pass/cost:host_mem",
        "//pass/liberty:liberty_dff",
        "//pass/partition:pass_partition",
        "//pass/semdiff:semdiff",
        "//pass/formal:formal",
        "//pass/satopt",
        "//pass/synth",
        "@abc",
        "@abseil-cpp//absl/container:node_hash_map",
        "@rapidjson",
    ],
    alwayslink = True,  # static Pass_plugin registration
)

cc_test(
    name = "abc_map_test",
    srcs = ["abc_map_test.cpp"],
    copts = COPTS,
    data = ["//inou/prp:abc_tests"],
    linkopts = ["-lz"],
    deps = [
        ":pass_abc",
        "//graph",
        "@googletest//:gtest_main",
        "@hhds//hhds:graph",
    ],
)

