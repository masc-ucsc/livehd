load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("//tools:copt_default.bzl", "COPTS")

# Mapper-engine identity for the persistent synthesis cache. Any implementation
# or ABC-pin change automatically invalidates mapped bodies; unrelated lhd
# rebuilds leave the cache warm. Hash the module pin conservatively via the
# workspace MODULE file because it is the source of the @abc revision.
#
# `pass/partition` is in the hash too: it decides region boundaries and boundary
# port names, and those ARE the shape of the cache key (docs/opt_loop_incr.md
# F8), so a partitioner change can invalidate a mapped body just as a mapper
# change can.
#
# `abc_salt.hpp` is excluded from the glob because it is this rule's own OUTPUT;
# globbing a generated header back in as a source is a cycle.
filegroup(
    name = "mapper_srcs",
    srcs = glob(
        [
            "*.cpp",
            "*.hpp",
        ],
        exclude = [
            "abc_salt.hpp",
            "*test*.cpp",
        ],
    ),
)

genrule(
    name = "abc_salt",
    srcs = [
        ":mapper_srcs",
        "//pass/partition:partition_srcs",
        "//:MODULE.bazel",
    ],
    outs = ["abc_salt.hpp"],
    cmd = "h=$$(cat $(SRCS) | (shasum -a 256 2>/dev/null || sha256sum) | cut -c1-16); " +
          "printf '// Generated by //pass/abc:abc_salt -- DO NOT EDIT.\\n" +
          "// Content hash of pass/abc + pass/partition + the @abc pin: the ABC\\n" +
          "// incremental-cache code salt (docs/opt_loop_incr.md L2).\\n" +
          "#pragma once\\n#include <cstdint>\\n" +
          "namespace livehd::abc { inline constexpr uint64_t kAbcSrcSalt = 0x%sULL; }\\n' \"$$h\" > $@",
)

cc_library(
    name = "pass_abc",
    srcs = glob(
        ["*.cpp"],
        exclude = ["*test*.cpp"],
    ),
    hdrs = glob(
        ["*.hpp"],
        exclude = ["abc_salt.hpp"],
    ) + [":abc_salt"],
    copts = COPTS,
    includes = ["."],
    visibility = ["//visibility:public"],
    deps = [
        "//graph",
        "//pass/common:pass",
        "//pass/cost:host_mem",
        "//pass/liberty:liberty_dff",
        "//pass/partition:pass_partition",
        "//pass/semdiff:semdiff",
        "@abc",
        "@abseil-cpp//absl/container:node_hash_map",
        "@rapidjson",
    ],
    alwayslink = True,  # static Pass_plugin registration
)

# The incremental-synthesis region digest (2opt-incr A): the cache-key
# contract. Links the full pass library (Region_body, node_util) — the ABC dep
# rides along unused.
cc_test(
    name = "abc_incr_test",
    srcs = ["abc_incr_test.cpp"],
    copts = COPTS,
    # ABC's io layer wants zlib; the lhd binary adds it the same way.
    linkopts = ["-lz"],
    deps = [
        ":pass_abc",
        "//graph",
        "@googletest//:gtest_main",
        "@hhds//hhds:graph",
    ],
)

# Functional unit test for the backend-agnostic adder/comparator builders
# (abc_arith.hpp), instantiated with a software bit model — no ABC dependency.
cc_test(
    name = "abc_arith_test",
    srcs = [
        "abc_arith.hpp",
        "abc_arith_test.cpp",
    ],
    copts = COPTS,
    includes = ["."],
    deps = ["@googletest//:gtest_main"],
)
