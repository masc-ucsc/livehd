load("@rules_cc//cc:defs.bzl", "cc_library")
load("//tools:copt_default.bzl", "COPTS")

# Timing-engine identity for the persistent STA reuse cache (sta_cache.hpp). Any
# change to how this pass builds the timing graph, walks it, or renders the
# report invalidates every cached analysis; unrelated lhd rebuilds leave the
# cache warm. `pass/partition` is in the hash because `hier=true` times the
# design its flattener produces, and MODULE.bazel because it pins @opentimer.
#
# Same shape and rationale as //pass/abc:abc_salt. `sta_salt.hpp` is excluded
# from the glob because it is this rule's own OUTPUT.
filegroup(
    name = "timer_srcs",
    srcs = glob(
        [
            "*.cpp",
            "*.hpp",
        ],
        exclude = [
            "sta_salt.hpp",
            "*test*.cpp",
        ],
    ),
)

genrule(
    name = "sta_salt",
    srcs = [
        ":timer_srcs",
        "//pass/partition:partition_srcs",
        "//:MODULE.bazel",
    ],
    outs = ["sta_salt.hpp"],
    cmd = "h=$$(cat $(SRCS) | (shasum -a 256 2>/dev/null || sha256sum) | cut -c1-16); " +
          "printf '// Generated by //pass/opentimer:sta_salt -- DO NOT EDIT.\\n" +
          "// Content hash of pass/opentimer + pass/partition + the @opentimer pin:\\n" +
          "// the STA reuse-cache code salt (docs/opt_loop_incr.md L2).\\n" +
          "#pragma once\\n#include <cstdint>\\n" +
          "namespace livehd::opentimer { inline constexpr uint64_t kStaSrcSalt = 0x%sULL; }\\n' \"$$h\" > $@",
)

cc_library(
    name = "pass_opentimer",
    srcs = glob(
        ["*.cpp"],
        exclude = ["*test*.cpp"],
    ),
    hdrs = glob(
        ["*.hpp"],
        exclude = ["sta_salt.hpp"],
    ) + [":sta_salt"],
    copts = COPTS,
    includes = ["."],
    visibility = ["//visibility:public"],
    deps = [
        "//core",
        "//graph",
        "//pass/common:pass",
        "//pass/partition:pass_partition",
        "//pass/semdiff:semdiff",
        "@hhds//hhds:graph",
        "@hlop//hlop:hlop",
        "@opentimer",
        "@rapidjson",
    ],
    alwayslink = True,
)
