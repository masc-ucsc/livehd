# pass.satopt: bounded, proof-backed logic simplification of an LGraph
# (todo/livehd/2s-satopt). One engine serves the standalone pass, compile's
# opt-in and pass.abc's synthesis copy. It calls no ABC: pass/abc registers its
# bit-level mux-fact prover (satopt_mux.hpp) when it is linked.

load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("//tools:copt_default.bzl", "COPTS")

# `satopt_salt.hpp` is excluded from the glob because it is this rule's own
# OUTPUT; globbing a generated header back in as a source is a cycle.
filegroup(
    name = "satopt_srcs",
    visibility = ["//visibility:public"],
    srcs = glob(
        [
            "*.cpp",
            "*.hpp",
        ],
        exclude = [
            "satopt_salt.hpp",
            "*_test.cpp",
        ],
    ),
)

# The code identity of every proof and rewrite satopt caches: this package,
# the shared synthesis salt (the blaster its mux-fact cones use, pass/formal's
# prover, cprop, bitwidth, ...), the cvc5 term encoder the prover builds on,
# and MODULE.bazel (the pinned cvc5 release decides every Proven verdict).
# //pass/abc:abc_salt folds this one in.
genrule(
    name = "satopt_salt",
    srcs = [
        ":satopt_srcs",
        "//pass/synth:synth_salt",
        "//pass/lec:lec_query_srcs",
        "//:MODULE.bazel",
    ],
    outs = ["satopt_salt.hpp"],
    visibility = ["//pass/abc:__pkg__"],
    cmd = "h=$$(cat $(SRCS) | (shasum -a 256 2>/dev/null || sha256sum) | cut -c1-16); " +
          "printf '// Generated by //pass/satopt:satopt_salt -- DO NOT EDIT.\\n" +
          "// Content hash of pass/satopt and the //pass/synth:synth_salt header: the\\n" +
          "// satopt proof and rewrite code identity.\\n" +
          "#pragma once\\n#include <cstdint>\\n" +
          "namespace livehd::satopt { inline constexpr uint64_t kSatoptSrcSalt = 0x%sULL; }\\n' \"$$h\" > $@",
)

cc_library(
    name = "satopt",
    srcs = glob(
        ["*.cpp"],
        exclude = ["*_test.cpp"],
    ),
    hdrs = glob(
        ["*.hpp"],
        exclude = ["satopt_salt.hpp"],
    ) + [":satopt_salt"],
    copts = COPTS,
    includes = ["."],
    visibility = ["//visibility:public"],
    deps = [
        "//core",
        "//graph",
        "//pass/bitwidth:pass_bitwidth",
        "//pass/common:pass",
        "//pass/cprop:pass_cprop",
        "//pass/formal:formal",
        "//pass/synth",
        "@abseil-cpp//absl/container:flat_hash_map",
        "@abseil-cpp//absl/container:flat_hash_set",
        "@abseil-cpp//absl/container:node_hash_map",
        "@rapidjson",
    ],
    alwayslink = True,  # static Pass_plugin registration
)

cc_test(
    name = "satopt_test",
    srcs = ["satopt_test.cpp"],
    copts = COPTS,
    linkopts = ["-lz"],  # pass/formal links pass/lec, whose cone prover uses ABC's io layer
    deps = [
        ":satopt",
        "//graph",
        "//pass/formal:formal",
        "@googletest//:gtest_main",
    ],
)

