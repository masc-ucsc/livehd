pub comb ALUControl::[lg="ALUControl", hdl](io_aluop:u1, io_itype:u1, io_funct7:u7, io_funct3:u3, io_wordinst:u1) -> (io_operation:u5) {
  mut _b2i_1 = 0
  mut _mux_2 = 0
  mut _mux_3 = 0
  mut _mux_4 = 0
  mut _mux_5 = 0
  mut casez_tmp = 0
  unique if io_funct3 == 0 {
    
    _b2i_1 = if io_funct7 == 0 { 1 } else { 0 }
    
    _mux_2 = if io_funct7 == 32 { (4 | (io_wordinst << 4))#[0..=4] } else { 31 }
    
    _mux_3 = if (io_itype | _b2i_1) != 0 { (7 | (io_wordinst << 4))#[0..=4] } else { _mux_2#[0..=4] }
    
    casez_tmp = _mux_3
  } elif io_funct3 == 1 {
    casez_tmp = 8 | (io_wordinst << 4)
  } elif io_funct3 == 2 {
    casez_tmp = 9
  } elif io_funct3 == 3 {
    casez_tmp = 1
  } elif io_funct3 == 4 {
    casez_tmp = 0
  } elif io_funct3 == 5 {
    
    _mux_4 = if io_funct7#[1..=6] == 16 { (3 | (io_wordinst << 4))#[0..=4] } else { 31 }
    
    _mux_5 = if io_funct7#[1..=6] == 0 { (2 | (io_wordinst << 4))#[0..=4] } else { _mux_4#[0..=4] }
    casez_tmp = _mux_5
  } elif io_funct3 == 6 {
    casez_tmp = 5
  } else {
    casez_tmp = 6
  }
  mut _mux_6:u5 = if io_aluop != 0 { casez_tmp#[0..=4] } else { 7 }
  io_operation = _mux_6
}
