pub mod StageReg_8::[lg="StageReg_8", hdl](clock:u1, reset:u1, io_in_mem_ctrl_memop:u2, io_in_wb_ctrl_toreg:u1, io_in_wb_ctrl_regwrite:u1, io_flush:u1) -> (io_data_mem_ctrl_memop:u2@[], io_data_wb_ctrl_toreg:u1@[], io_data_wb_ctrl_regwrite:u1@[]) {
  mut _mux_1 = 0
  reg reg_mem_ctrl_memop:u2
  reg reg_wb_ctrl_toreg:u1
  reg reg_wb_ctrl_regwrite:u1
  if reset != 0 {
    reg_mem_ctrl_memop = 0
    reg_wb_ctrl_regwrite = 0
    reg_wb_ctrl_toreg = 0
  } else {
    
    _mux_1 = if io_flush != 0 { 0 } else { io_in_mem_ctrl_memop#[0..=1] }
    reg_mem_ctrl_memop = _mux_1
    reg_wb_ctrl_regwrite = (~io_flush) & 1 & io_in_wb_ctrl_regwrite
    reg_wb_ctrl_toreg = (~io_flush) & 1 & io_in_wb_ctrl_toreg
  }
  io_data_mem_ctrl_memop = reg_mem_ctrl_memop
  io_data_wb_ctrl_regwrite = reg_wb_ctrl_regwrite
  io_data_wb_ctrl_toreg = reg_wb_ctrl_toreg
}
