pub comb ALU::[lg="ALU", hdl](io_operation:u5, io_inputx:u64, io_inputy:u64) -> (io_result:u64) {
  mut casez_tmp = 0
  unique if io_operation#[0..=3] == 0 {
    casez_tmp = io_inputx ^ io_inputy
  } elif io_operation#[0..=3] == 1 {
    casez_tmp = (if io_inputx < io_inputy { 1 } else { 0 }) | 0
  } elif io_operation#[0..=3] == 2 {
    casez_tmp = if ((io_operation >> 4) & 1) != 0 { (io_inputx#[0..=31] >> io_inputy#[0..=4])#sext[0..=31]#[0..=63] } else { (io_inputx >> io_inputy#[0..=5])#[0..=63] }
  } elif io_operation#[0..=3] == 3 {
    casez_tmp = if ((io_operation >> 4) & 1) != 0 { ((io_inputx#[0..=31]#sext[0..=31] >> io_inputy#[0..=4])#[0..=31]#sext[0..=31]#[0..=31])#sext[0..=31]#[0..=63] } else { (io_inputx#sext[0..=63] >> io_inputy#[0..=5])#[0..=63]#sext[0..=63]#[0..=63]#[0..=63] }
  } elif io_operation#[0..=3] == 4 {
    casez_tmp = if ((io_operation >> 4) & 1) != 0 { ((io_inputx#[0..=31] - io_inputy#[0..=31])#[0..=31])#sext[0..=31]#[0..=63] } else { (io_inputx - io_inputy)#[0..=63]#[0..=63] }
  } elif io_operation#[0..=3] == 5 {
    casez_tmp = io_inputx | io_inputy
  } elif io_operation#[0..=3] == 6 {
    casez_tmp = io_inputx & io_inputy
  } elif io_operation#[0..=3] == 7 {
    casez_tmp = if ((io_operation >> 4) & 1) != 0 { ((io_inputx#[0..=31] + io_inputy#[0..=31])#[0..=31])#sext[0..=31]#[0..=63] } else { (io_inputx + io_inputy)#[0..=63]#[0..=63] }
  } elif io_operation#[0..=3] == 8 {
    casez_tmp = if ((io_operation >> 4) & 1) != 0 { (((io_inputx#[0..=31] | 0) << io_inputy#[0..=4])#[0..=62])#sext[0..=31]#[0..=63] } else { (((io_inputx | 0) << io_inputy#[0..=5])#[0..=126])#[0..=63]#[0..=63] }
  } elif io_operation#[0..=3] == 9 {
    casez_tmp = (if io_inputx#sext[0..=63] < io_inputy#sext[0..=63] { 1 } else { 0 }) | 0
  } elif io_operation#[0..=3] == 10 {
    casez_tmp = (~(io_inputx | io_inputy))#[0..=63]
  } elif io_operation#[0..=3] == 11 {
    casez_tmp = (if io_inputx#sext[0..=63] >= io_inputy#sext[0..=63] { 1 } else { 0 }) | 0
  } elif io_operation#[0..=3] == 12 {
    casez_tmp = (if io_inputx >= io_inputy { 1 } else { 0 }) | 0
  } elif io_operation#[0..=3] == 13 {
    casez_tmp = (if io_inputx == io_inputy { 1 } else { 0 }) | 0
  } elif io_operation#[0..=3] == 14 {
    casez_tmp = (if io_inputx != io_inputy { 1 } else { 0 }) | 0
  } else {
    casez_tmp = 0
  }
  io_result = casez_tmp
}
