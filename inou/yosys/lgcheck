#!/bin/bash

if [ ${NO_CHECK}"x" == "1x" ]; then
  # disable check for performance monitoring
  exit 0
fi

if [ -x "bazel-bin/inou/yosys/yosys2" ]; then
  YOSYS="./bazel-bin/inou/yosys/yosys2"
elif [ -x "inou/yosys/yosys2" ]; then
  YOSYS="inou/yosys/yosys2"
elif [ -x "lgshell.runfiles/livehd/inou/yosys/yosys2" ]; then
  YOSYS="lgshell.runfiles/livehd/inou/yosys/"
else
  YOSYS=$(which yosys)
fi

CELLLIB=""
OPT_TOP=""
GOLD_TOP=""
GATE_TOP=""
GOLD=""
GATE=""
NORMALIZE_SPLIT_PORTS=0
DESCEND_ON_INCONCLUSIVE=0
GOLD_RTLIL_INPUT=""
GATE_RTLIL_INPUT=""
while true; do
  case "$1" in
  -r | --reference)
    case "$2" in
    "") shift 2 ;;
    *)
      GOLD=$2
      shift 2
      ;;
    esac
    ;;
  -i | --implementation)
    case "$2" in
    "") shift 2 ;;
    *)
      GATE=$2
      shift 2
      ;;
    esac
    ;;
  -l | --cell_library)
    case "$2" in
    "") shift 2 ;;
    *)
      CELLLIB=$2
      shift 2
      ;;
    esac
    ;;
  --yosys)
    case "$2" in
    "") shift 2 ;;
    *)
      YOSYS=$2
      shift 2
      ;;
    esac
    ;;
  --top)
    case "$2" in
    "") shift 2 ;;
    *)
      OPT_TOP=$2
      shift 2
      ;;
    esac
    ;;
  --reference_top | --gold_top)
    # top module name to select on the reference/gold side (overrides --top)
    case "$2" in
    "") shift 2 ;;
    *)
      GOLD_TOP=$2
      shift 2
      ;;
    esac
    ;;
  --implementation_top | --gate_top)
    # top module name to select on the implementation/gate side (overrides --top)
    case "$2" in
    "") shift 2 ;;
    *)
      GATE_TOP=$2
      shift 2
      ;;
    esac
    ;;
  --gold_reader | --reference_reader)
    # reader for the GOLD side: verilog (default; read_verilog -sv) | slang
    # (load the yosys-slang plugin and read_slang — needed for SystemVerilog
    # packed-struct sources, e.g. CIRCT/firtool output, that read_verilog
    # cannot parse). --slang_plugin is optional for older external Yosys builds.
    case "$2" in
    "") shift 2 ;;
    *)
      GOLD_READER=$2
      shift 2
      ;;
    esac
    ;;
  --gate_reader | --implementation_reader)
    # reader for the GATE side: verilog (default; read_verilog -sv) | slang.
    # Generated cgen Verilog is legal input to either frontend, but read_slang
    # scales much better on very large flattened expressions.
    case "$2" in
    "") shift 2 ;;
    *)
      GATE_READER=$2
      shift 2
      ;;
    esac
    ;;
  --slang_plugin)
    # path to the yosys-slang plugin (slang.so) for either slang reader
    case "$2" in
    "") shift 2 ;;
    *)
      SLANG_PLUGIN=$2
      shift 2
      ;;
    esac
    ;;
  --normalize_split_ports)
    # The reference has packed aggregate ports while cgen exposes their leaves
    # as escaped dotted ports. Build a wrapper from the two cached RTLIL port
    # lists before starting the equivalence budget.
    NORMALIZE_SPLIT_PORTS=1
    shift 1
    ;;
  --descend_on_inconclusive)
    # If this top exhausts the equivalence budget without a counterexample,
    # retry its direct module children from the already-read RTLIL. A child
    # that is also inconclusive recursively descends again.
    DESCEND_ON_INCONCLUSIVE=1
    shift 1
    ;;
  --gold_rtlil)
    GOLD_RTLIL_INPUT=$2
    shift 2
    ;;
  --gate_rtlil)
    GATE_RTLIL_INPUT=$2
    shift 2
    ;;
  "") break ;;
  *)
    argument=$1
    if [ ${argument:0:1} == "-" ]; then
      echo "Option $1 not recognized!"
      exit 5  # setup failure, NOT a refutation (exit 1 is reserved for a real CEX)
    else
      if [ "${GOLD}" == "" ]; then
        GOLD=$1
        shift 1
      else
        GATE=$1
        shift 1
      fi
    fi
    ;;
  esac
done

GOLD_READER=${GOLD_READER:-verilog}
GATE_READER=${GATE_READER:-verilog}
# Optional: only older external Yosys builds need a loadable read_slang.
SLANG_PLUGIN=${SLANG_PLUGIN:-}
for reader in "$GOLD_READER" "$GATE_READER"; do
  if [ "$reader" != "verilog" ] && [ "$reader" != "slang" ]; then
    echo "lgcheck: reader must be verilog|slang (got '$reader')"
    exit 5
  fi
done

# yosys-slang normally flattens during import. Keep occurrence-specialized
# module boundaries only when recursive fallback may need them; every proof
# strategy still explicitly flattens its selected top before comparison.
GOLD_HIER_FLAG=""
GATE_HIER_FLAG=""
if [ "$DESCEND_ON_INCONCLUSIVE" -eq 1 ]; then
  GOLD_HIER_FLAG="--best-effort-hierarchy"
  GATE_HIER_FLAG="--best-effort-hierarchy"
fi

# Slang can parse compilation units in parallel. Keep this independently
# tunable for constrained runners, while making large Minion/XiangShan inputs
# finish in practical time by default. This affects parsing only, not RTLIL.
LGCHECK_SLANG_THREADS=${LGCHECK_SLANG_THREADS:-8}
if ! [[ "$LGCHECK_SLANG_THREADS" =~ ^[1-9][0-9]*$ ]]; then
  echo "lgcheck: LGCHECK_SLANG_THREADS must be a positive integer (got '$LGCHECK_SLANG_THREADS')"
  exit 5
fi

if [ ! -f "${GATE}" ]; then
  echo "gate circuit ${GATE} not a valid file"
  exit 5
fi

if [ ! -f ${GOLD} ]; then
  echo "gold circuit ${GOLD} not a valid file"
  exit 5
fi

if [ ! -f "${YOSYS}" ]; then
  if [ -x "/usr/bin/yosys" ]; then
    YOSYS=/usr/bin/yosys
  elif [ -x "/usr/local/bin/yosys" ]; then
    YOSYS=/usr/local/bin/yosys
  else
    echo "lgcheck: unable to fix YOSYS path"
    exit 5
  fi
fi

# Per-side top defaults: an unset --reference_top/--implementation_top falls
# back to the shared --top, so plain `--top X` keeps working unchanged.
if [ "${GOLD_TOP}" == "" ]; then GOLD_TOP=$OPT_TOP; fi
if [ "${GATE_TOP}" == "" ]; then GATE_TOP=$OPT_TOP; fi

# cgen now emits FLAT Verilog module names (`fun3`) while goldens/callers may
# still pass the hierarchical internal name (`file.fun3`) — Pyrope keeps the
# `file.entity` graph name, Verilog flattens to the entity. Resolve each side's
# requested top against the modules ACTUALLY present in that file: keep an exact
# (bare or `\`-escaped) match, else fall back to the entity (after the last '.'),
# else leave it unchanged (yosys then reports a clear not-found). This makes
# flat<->dotted transparent on each side without every caller knowing the form.
resolve_top() {
  local f="$1" want="$2"
  [ -z "${want}" ] && { echo ""; return; }
  [ -f "${f}" ] || { echo "${want}"; return; }
  local re="${want//./\\.}"
  if grep -qE "^module[[:space:]]+\\\\?${re}[[:space:](]" "${f}" 2>/dev/null; then
    echo "${want}"; return
  fi
  local ent="${want##*.}"
  if [ "${ent}" != "${want}" ] && grep -qE "^module[[:space:]]+\\\\?${ent}[[:space:](]" "${f}" 2>/dev/null; then
    echo "${ent}"; return
  fi
  echo "${want}"
}
# A descendant cache contains occurrence-specialized names such as
# `ClockGate$ExuBlock.ClockGate` which deliberately do NOT exist in the source
# text. Resolving that request against the source used to fall back to the last
# dotted component (`ClockGate`) when it happened to be a real base module,
# then fail because the selected parent cache had pruned that base. The cache is
# authoritative on that side; source-name compatibility applies only when the
# source will actually be read.
if [ "$GOLD_RTLIL_INPUT" = "" ]; then
  GOLD_TOP=$(resolve_top "${GOLD}" "${GOLD_TOP}")
fi
if [ "$GATE_RTLIL_INPUT" = "" ]; then
  GATE_TOP=$(resolve_top "${GATE}" "${GATE_TOP}")
fi

fm_top=$OPT_TOP
if [ "${fm_top}" == "" ]; then
  fm_top=$GATE_TOP
fi
if [ "${fm_top}" == "" ]; then
  filename=$(basename -- "$GATE")
  fm_top="${filename%.*}"
  if [[ $fm_top =~ "long_" ]]; then
    fm_top=${fm_top:5}
  elif [[ $fm_top =~ "fixme_" ]]; then
    fm_top=${fm_top:6}
  fi
fi

if [ -z $FM_SHELL ]; then
  FM_SHELL=$(which fm_shell)
fi

if [ -x "${FM_SHELL}" ]; then
  echo "using formality"

  echo "
  set_app_var synopsys_auto_setup true
  set_app_var hdlin_ignore_parallel_case false
  set_app_var hdlin_ignore_full_case false
  read_sverilog -r  \"${GOLD}\"
  set_top ${GOLD_TOP:-$fm_top}
  read_sverilog -i  \"${GATE}\"
  set_top ${GATE_TOP:-$fm_top}
  match
  report_unmatched_points >> \"fm_${fm_top}_error.log\"
  if { ![verify] }  {
    report_failing_points >> \"fm_${fm_top}_error.log\"
    report_aborted >> \"fm_${fm_top}_error.log\"
    analyze_points -all >> \"fm_${fm_top}_error.log\"
  }
  exit
  " >fm_script_${fm_top}.tcl

  ${FM_SHELL} -64bit -f fm_script_${fm_top}.tcl | grep "Verification SUCCEEDED"
  if [ $? -eq 0 ]; then
    echo "5.Successfully matched ${GATE} with ${GOLD} top:${fm_top}"
    exit 0
  fi

  echo "WARN: formality failed to prove equivalency."
fi

echo "using yosys:"${YOSYS}

if [ ! -f ${YOSYS} ]; then
  echo "Yosys binary not found"
  exit 5
fi

# Select each side's top independently so the reference and implementation may
# use DIFFERENT module names (both are renamed to gold/gate before comparison).
GOLD_TOP_STR="-auto-top"
if [ "${GOLD_TOP}" != "" ]; then
  GOLD_TOP_STR="-top $GOLD_TOP"
fi
GATE_TOP_STR="-auto-top"
if [ "${GATE_TOP}" != "" ]; then
  GATE_TOP_STR="-top $GATE_TOP"
fi

# GOLD-side read command, shared by every strategy below. --gold_reader slang
# reads through built-in read_slang (SystemVerilog packed structs / '{...}
# patterns that read_verilog cannot parse); --no-proc leaves the RTLIL
# processes for the strategies' own `proc`.
gold_read_cmds() {
  # $1 = extra read_verilog flags position is unused; kept single-form
  if [ "${GOLD_RTLIL}" != "" ]; then
    # A descendant may reuse its parent's hierarchy cache. Reassert THIS
    # invocation's selected top before rename/flatten; otherwise Yosys keeps
    # the parent's top attribute and the child proof compares the wrong module.
    echo "read_rtlil ${GOLD_RTLIL}; hierarchy ${GOLD_TOP_STR}"
  elif [ "${GOLD_READER}" == "slang" ]; then
    if [ -n "${SLANG_PLUGIN}" ] && [ ! -f "${SLANG_PLUGIN}" ]; then
      echo "lgcheck: --gold_reader slang needs --slang_plugin <slang.so> (got '${SLANG_PLUGIN}')"
      exit 5
    fi
    GOLD_SLANG_TOP=""
    if [ "${GOLD_TOP}" != "" ]; then GOLD_SLANG_TOP="--top ${GOLD_TOP}"; fi
    # Match the permissive source-language settings used by the large RTL
    # generation flows. They affect whether legal project idioms elaborate,
    # not the resulting hardware: Minion needs both for forward declarations
    # and plain-bit assignments to enum fields.
    if [ -n "${SLANG_PLUGIN}" ]; then echo "plugin -i ${SLANG_PLUGIN}"; fi
    echo "read_slang ${GOLD_SLANG_TOP} ${SLANG_INC} -j ${LGCHECK_SLANG_THREADS} --allow-use-before-declare --relax-enum-conversions ${GOLD_HIER_FLAG} --no-proc ${GOLD}; hierarchy ${GOLD_TOP_STR}"
  else
    echo "read_verilog -sv -icells ${VLG_INC} ${GOLD}; hierarchy ${GOLD_TOP_STR}"
  fi
}

# GATE-side counterpart.  The first call reads the generated Verilog; after
# the one-time preparation below every proof strategy reloads the cached RTLIL
# instead of reparsing a large hierarchy.
gate_read_cmds() {
  if [ "${GATE_RTLIL}" != "" ]; then
    echo "read_rtlil ${GATE_RTLIL}; hierarchy ${GATE_TOP_STR}"
  elif [ "${GATE_READER}" == "slang" ]; then
    if [ -n "${SLANG_PLUGIN}" ] && [ ! -f "${SLANG_PLUGIN}" ]; then
      echo "lgcheck: --gate_reader slang needs --slang_plugin <slang.so> (got '${SLANG_PLUGIN}')"
      exit 5
    fi
    GATE_SLANG_TOP=""
    if [ "${GATE_TOP}" != "" ]; then GATE_SLANG_TOP="--top ${GATE_TOP}"; fi
    if [ -n "${SLANG_PLUGIN}" ]; then echo "plugin -i ${SLANG_PLUGIN}"; fi
    echo "read_slang ${GATE_SLANG_TOP} ${SLANG_INC} -j ${LGCHECK_SLANG_THREADS} --allow-use-before-declare --relax-enum-conversions ${GATE_HIER_FLAG} --no-proc ${GATE}; hierarchy ${GATE_TOP_STR}"
  else
    echo "read_verilog -sv -icells ${VLG_INC} ${GATE}; hierarchy ${GATE_TOP_STR}"
  fi
}

echo "checking GATE:$GATE (top:${GATE_TOP}) vs GOLD:$GOLD (top:${GOLD_TOP}) directory:$PWD"

# cgen output `include`s memory models (cgen_memory_*.v) that live in
# ware/rtl. Resolve the directory relative to this script (works both in a
# repo checkout and inside bazel runfiles) with a cwd-relative fallback.
SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"
VLG_INC=""
SLANG_INC=""
for d in "${SELF_DIR}/../../ware/rtl" "ware/rtl"; do
  if [ -d "$d" ]; then
    VLG_INC="-I$d"
    SLANG_INC="-I $d"
    break
  fi
done
if [ "${VLG_INC}" = "" ]; then
  for f in "${GATE}" "${GOLD}"; do
    d="$(cd "$(dirname "$f")" >/dev/null 2>&1 && pwd)"
    while [ "$d" != "/" ] && [ "$d" != "" ]; do
      if [ -d "$d/ware/rtl" ]; then
        VLG_INC="-I$d/ware/rtl"
        SLANG_INC="-I $d/ware/rtl"
        break
      fi
      d="$(dirname "$d")"
    done
    if [ "${VLG_INC}" != "" ]; then
      break
    fi
  done
fi

if [ "${CELLLIB}" != "" ]; then
  if [ ! -f ${CELLLIB} ]; then
    echo "cell library ${CELLLIB} not found"
    exit 5
  fi
  # lib="read_verilog -sv ${CELLLIB}"
  lib="read_liberty ${CELLLIB}"
fi

#exit 2

# Parse/elaborate each side exactly once, outside the equivalence budget.  This
# is important for large designs (Minion/XiangShan): source reading can take a
# long time and is not a solver timeout, while the historical flow reread both
# hierarchies for every proof strategy.  RTLIL preserves processes, memories,
# and hierarchy, so each strategy below can still run its own proc/memory/opt
# sequence unchanged.
GOLD_RTLIL=""
GATE_RTLIL=""
gold_rtlil="$PWD/lgcheck_gold.il"
gate_rtlil="$PWD/lgcheck_gate.il"
#
# The cache is an OPTIMIZATION, so a failed pre-read is NOT a verdict: fall back
# to the historical per-strategy source read and let the normal flow decide.
# Hard-failing here would turn every frontend limitation (read_verilog cannot
# parse a `'{…}` assignment pattern, for instance) into a `dependency` error on
# designs whose only honest answer is INCONCLUSIVE — the source of truth for
# "these two cannot be compared" stays the bounded miter's ERROR check below.
echo "INFO: preparing reference RTLIL (source-read time is outside the equivalence budget)"
if [ "$GOLD_RTLIL_INPUT" != "" ]; then
  if [ ! -f "$GOLD_RTLIL_INPUT" ]; then
    echo "lgcheck: cached reference RTLIL not found: $GOLD_RTLIL_INPUT"
    exit 5
  fi
  gold_rtlil_input=$(cd "$(dirname "$GOLD_RTLIL_INPUT")" && pwd)/$(basename "$GOLD_RTLIL_INPUT")
  # Select/prune the requested occurrence OUTSIDE the equivalence budget. The
  # parent cache retains every occurrence-specialized module, but also retains
  # the parent's top attribute; passing it through unchanged made a descendant
  # proof rename/flatten the parent again. A small selected cache is both the
  # correct design and dramatically cheaper for every proof strategy to load.
  gold_selected_rtlil="$PWD/lgcheck_gold_selected.il"
  if ! ${YOSYS} -p "read_rtlil ${gold_rtlil_input}; hierarchy ${GOLD_TOP_STR}; write_rtlil ${gold_selected_rtlil}" \
      >lgcheck_select_gold.log 2>lgcheck_select_gold.err; then
    echo "lgcheck: cached reference RTLIL does not contain/select top $GOLD_TOP"
    tail -20 lgcheck_select_gold.err
    exit 5
  fi
  GOLD_RTLIL="$gold_selected_rtlil"
  echo "INFO: reused cached reference RTLIL and selected $GOLD_TOP"
elif ${YOSYS} -p "$(gold_read_cmds); write_rtlil ${gold_rtlil}" >lgcheck_read_gold.log 2>lgcheck_read_gold.err; then
  GOLD_RTLIL="$gold_rtlil"
else
  echo "WARN: could not pre-read the reference design; each strategy re-reads the source"
  # Slang can print thousands of warnings after the actual error.
  grep -m20 -E '(^ERROR|: error:)' lgcheck_read_gold.err || true
  tail -20 lgcheck_read_gold.err
fi
echo "INFO: preparing implementation RTLIL (source-read time is outside the equivalence budget)"
if [ "$GATE_RTLIL_INPUT" != "" ]; then
  if [ ! -f "$GATE_RTLIL_INPUT" ]; then
    echo "lgcheck: cached implementation RTLIL not found: $GATE_RTLIL_INPUT"
    exit 5
  fi
  gate_rtlil_input=$(cd "$(dirname "$GATE_RTLIL_INPUT")" && pwd)/$(basename "$GATE_RTLIL_INPUT")
  gate_selected_rtlil="$PWD/lgcheck_gate_selected.il"
  if ! ${YOSYS} -p "read_rtlil ${gate_rtlil_input}; hierarchy ${GATE_TOP_STR}; write_rtlil ${gate_selected_rtlil}" \
      >lgcheck_select_gate.log 2>lgcheck_select_gate.err; then
    echo "lgcheck: cached implementation RTLIL does not contain/select top $GATE_TOP"
    tail -20 lgcheck_select_gate.err
    exit 5
  fi
  GATE_RTLIL="$gate_selected_rtlil"
  echo "INFO: reused cached implementation RTLIL and selected $GATE_TOP"
elif ${YOSYS} -p "$(gate_read_cmds); write_rtlil ${gate_rtlil}" >lgcheck_read_gate.log 2>lgcheck_read_gate.err; then
  GATE_RTLIL="$gate_rtlil"
else
  echo "WARN: could not pre-read the implementation design; each strategy re-reads the source"
  # Slang can print thousands of warnings after the actual error.
  grep -m20 -E '(^ERROR|: error:)' lgcheck_read_gate.err || true
  tail -20 lgcheck_read_gate.err
fi
BASE_GOLD_RTLIL="$GOLD_RTLIL"
BASE_GATE_RTLIL="$GATE_RTLIL"
BASE_GOLD_TOP="$GOLD_TOP"
BASE_GATE_TOP="$GATE_TOP"

# cgen deliberately makes aggregate ABI leaves explicit (for example
# \io_req.bits.op), while yosys-slang represents the original packed SV top as
# one vector port (io_req). Yosys' miter requires identical port lists. When
# requested, construct a gold-shaped gate wrapper from the cached RTLIL port
# declarations, then cache that combined hierarchy as the gate side. This work
# is elaboration/interface preparation, so it remains outside the 600-second
# equivalence budget below.
if [ "$NORMALIZE_SPLIT_PORTS" -eq 1 ]; then
  if [ "$GOLD_RTLIL" = "" ] || [ "$GATE_RTLIL" = "" ]; then
    echo "lgcheck: split-port normalization requires successful RTLIL preparation on both sides"
    exit 5
  fi
  adapter_tool="${SELF_DIR}/rtlil_split_port_adapter.py"
  if [ ! -f "$adapter_tool" ]; then
    echo "lgcheck: split-port adapter helper not found: $adapter_tool"
    exit 5
  fi
  gate_impl_top="__lgcheck_gate_impl"
  gate_adapter_top="__lgcheck_gate_adapter"
  gate_adapter_v="$PWD/lgcheck_gate_adapter.v"
  gate_adapted_rtlil="$PWD/lgcheck_gate_adapted.il"
  if ! python3 "$adapter_tool" \
      --gold "$GOLD_RTLIL" --gate "$GATE_RTLIL" \
      --gold-top "$GOLD_TOP" --gate-top "$GATE_TOP" \
      --impl-top "$gate_impl_top" --adapter-top "$gate_adapter_top" \
      --output "$gate_adapter_v"; then
    echo "lgcheck: unable to normalize split implementation ports"
    exit 5
  fi
  if ! ${YOSYS} -p "read_rtlil ${GATE_RTLIL}; hierarchy -top ${GATE_TOP}; rename -top ${gate_impl_top}; read_verilog -sv ${gate_adapter_v}; hierarchy -top ${gate_adapter_top}; write_rtlil ${gate_adapted_rtlil}" \
      >lgcheck_adapt_gate.log 2>lgcheck_adapt_gate.err; then
    echo "lgcheck: unable to elaborate the split-port adapter"
    tail -20 lgcheck_adapt_gate.err
    exit 5
  fi
  GATE_RTLIL="$gate_adapted_rtlil"
  GATE_TOP="$gate_adapter_top"
  GATE_TOP_STR="-top $GATE_TOP"
  echo "INFO: normalized split implementation ports through $gate_adapter_top"
fi

# One wall budget shared by all equivalence strategies, started only after both
# Verilog sides have been read.  A killed strategy falls through to the normal
# INCONCLUSIVE result (exit 2); a bounded-miter counterexample still exits 1.
LGCHECK_EQUIV_TIMEOUT="${LGCHECK_EQUIV_TIMEOUT:-600}"
if ! [[ "$LGCHECK_EQUIV_TIMEOUT" =~ ^[0-9]+$ ]]; then
  echo "lgcheck: LGCHECK_EQUIV_TIMEOUT must be a non-negative integer (got '$LGCHECK_EQUIV_TIMEOUT')"
  exit 5
fi
# A guessed internal correspondence can leave equiv_simple solving a very
# expensive false cut. Give each matching attempt a bounded share so it cannot
# consume the entire shared budget before temporal induction/BMC can run.
# The overall equivalence budget is unchanged; zero still disables all limits.
LGCHECK_HEURISTIC_TIMEOUT="${LGCHECK_HEURISTIC_TIMEOUT:-90}"
if ! [[ "$LGCHECK_HEURISTIC_TIMEOUT" =~ ^[0-9]+$ ]]; then
  echo "lgcheck: LGCHECK_HEURISTIC_TIMEOUT must be a non-negative integer (got '$LGCHECK_HEURISTIC_TIMEOUT')"
  exit 5
fi
LGCHECK_BMC_STEPS="${LGCHECK_BMC_STEPS:-6}"
# Failed correspondence guesses do not refute the public outputs. Reserve a
# bounded share for the final counterexample search, including solver startup,
# so a short shared budget cannot expire before that search even starts.
bmc_reserve=0
if [[ "$LGCHECK_BMC_STEPS" =~ ^[0-9]+$ ]] && [ "$LGCHECK_BMC_STEPS" -gt 0 ] \
    && [ "$LGCHECK_EQUIV_TIMEOUT" -gt 1 ]; then
  bmc_reserve=$(((LGCHECK_EQUIV_TIMEOUT + 3) / 4))
  [ "$bmc_reserve" -le 30 ] || bmc_reserve=30
fi
equiv_start=$SECONDS
# coreutils `timeout` is NOT guaranteed to exist: macOS ships none, and bazel's
# test PATH (/bin:/usr/bin:/usr/local/bin) does not carry the homebrew prefix
# where `timeout`/`gtimeout` live. Resolve it once; when it is absent fall back
# to a pure-bash watchdog rather than letting every strategy die with 127
# ("command not found"), which silently turned every equivalence check into an
# INCONCLUSIVE verdict.
TIMEOUT_BIN=""
for _t in timeout gtimeout; do
  if command -v "$_t" >/dev/null 2>&1; then
    TIMEOUT_BIN="$_t"
    break
  fi
done
run_equiv_yosys() {
  local heuristic=0
  local bmc=0
  if [ "$1" = --heuristic ]; then
    heuristic=1
    shift
  elif [ "$1" = --bmc ]; then
    bmc=1
    shift
  fi
  if [ "$LGCHECK_EQUIV_TIMEOUT" -eq 0 ]; then
    "$YOSYS" "$@"
    return
  fi
  local elapsed=$((SECONDS - equiv_start))
  local remaining=$((LGCHECK_EQUIV_TIMEOUT - elapsed))
  if [ "$bmc" -eq 0 ]; then
    remaining=$((remaining - bmc_reserve))
  fi
  if [ "$remaining" -le 0 ]; then
    return 124
  fi
  if [ "$heuristic" -eq 1 ] && [ "$LGCHECK_HEURISTIC_TIMEOUT" -gt 0 ] \
      && [ "$remaining" -gt "$LGCHECK_HEURISTIC_TIMEOUT" ]; then
    remaining=$LGCHECK_HEURISTIC_TIMEOUT
  fi
  if [ "$TIMEOUT_BIN" != "" ]; then
    "$TIMEOUT_BIN" --signal=TERM --kill-after=30s "$remaining" "$YOSYS" "$@"
    return
  fi
  # Portable watchdog: TERM the solver when the shared budget runs out, KILL it
  # if it ignores that, and report 124 so the caller sees a timeout (not a
  # refutation) exactly as coreutils `timeout` would. The watchdog polls in 1s
  # ticks, so it must be RETIRED explicitly once the solver returns -- simply
  # `wait`ing for it blocks until its next tick and added a flat second to every
  # yosys run (four per lgcheck, and lgcheck runs once per LEC: ~4s of pure sleep
  # on every check that took milliseconds of real work).
  local fired="$PWD/lgcheck_watchdog.$$"
  rm -f "$fired"
  "$YOSYS" "$@" &
  local ypid=$!
  (
    left=$remaining
    while [ "$left" -gt 0 ] && kill -0 "$ypid" 2>/dev/null; do
      sleep 1
      left=$((left - 1))
    done
    if kill -0 "$ypid" 2>/dev/null; then
      : >"$fired"
      kill -TERM "$ypid" 2>/dev/null
      grace=30
      while [ "$grace" -gt 0 ] && kill -0 "$ypid" 2>/dev/null; do
        sleep 1
        grace=$((grace - 1))
      done
      kill -KILL "$ypid" 2>/dev/null
    fi
  ) >/dev/null 2>&1 &
  local wpid=$!
  local rc=0
  wait "$ypid" || rc=$?
  # The solver is done; retire the watchdog instead of waiting out its tick. Its
  # verdict is already recorded: `$fired` is created BEFORE the TERM, so a run
  # the watchdog killed always leaves the marker behind.
  kill -TERM "$wpid" 2>/dev/null
  wait "$wpid" 2>/dev/null
  if [ -e "$fired" ]; then
    rc=124
    rm -f "$fired"
  fi
  return $rc
}
echo "INFO: starting equivalence checks (shared budget ${LGCHECK_EQUIV_TIMEOUT}s)"

yosys_read="$(gold_read_cmds); proc; bmuxmap; flatten; rename -top gold; design -stash gold;
            $(gate_read_cmds); proc; bmuxmap; flatten; rename -top gate; design -stash gate;
            design -copy-from gold -as gold gold; design -copy-from gate -as gate gate"
# In Yosys, an empty command (;; or ;;;) requests cleanup. Do not accidentally
# clean before memory lowering when no cell library was requested: that can
# discard correspondence names differently on the two sides.
if [ -n "${lib}" ]; then
  yosys_read="${yosys_read}; ${lib}"
fi

# Clock-domain guard. Every engine below except 1c and the bounded miter is
# CLOCK-BLIND: equiv_simple/equiv_induct/`sat -tempinduct` advance every
# flip-flop once per solver step whatever clock or edge drives it, and do not
# model latches. They PROVED posedge vs negedge registers, a register moved to
# another clock, a gated clock vs the ungated one, and a mixed-edge pipeline vs
# its edge-swapped twin. That abstraction is exact only when every state
# element of BOTH designs is clocked by the SAME edge of the SAME primary input
# (clock traced through buffers/inverters, the edge folded through each
# inversion, so a negedge register and a posedge netlist flop on `~clk` agree).
# Anything else (two clocks or edges, a derived/gated clock, a latch, an
# asynchronous-write memory, a constant clock) may only be decided by the
# clk2fflogic engines, stage 1c (proof) and the bounded miter (refutation).
# A helper failure is treated as "not single-domain": never a verdict.
CLOCK_BLIND_OK=0
ASYNC_FF=1  # unknown until the helper says otherwise
clock_domains_tool="${SELF_DIR}/clock_domains.py"
if [ -f "$clock_domains_tool" ] && ${YOSYS} -p "${yosys_read}; flatten gold gate;
    select -set lgc_state t:*ff* t:*FF* t:*latch* t:*LATCH* t:\$mem* t:\$_SR_* t:\$sr;
    select -set lgc_clock t:\$not t:\$_NOT_ t:\$buf t:\$pos t:\$_BUF_;
    setattr -set keep 1 @lgc_state; delete c:* @lgc_state %d @lgc_clock %d;
    opt_clean -purge; write_json lgcheck_clock_domains.json" \
    >lgcheck_clock_domains.log 2>&1 \
    && clock_domains=$(python3 "$clock_domains_tool" --json lgcheck_clock_domains.json); then
  echo "INFO: clock domains: ${clock_domains}"
  case "$clock_domains" in
  single*) CLOCK_BLIND_OK=1 ;;
  esac
  case "$clock_domains" in
  single+async* | multi+async*) ;;
  *) ASYNC_FF=0 ;;
  esac
else
  echo "WARN: could not extract the clock domains (see lgcheck_clock_domains.log)"
fi
if [ "$CLOCK_BLIND_OK" -eq 0 ]; then
  echo "INFO: state is not a single primary-input clock edge; clock-blind engines (1/1n/1r/1p/1m/2/4) skipped"
fi
# The guard is preparation, not an equivalence strategy: restart the budget.
equiv_start=$SECONDS
# Run a clock-blind strategy only when the guard allows it; a skipped strategy
# produces no log line, so its "proven" grep fails and the flow falls through.
run_clock_blind_yosys() {
  [ "$CLOCK_BLIND_OK" -eq 1 ] || return 125
  run_equiv_yosys "$@"
}

yosys_prep="proc; bmuxmap; memory -nomap; write_verilog trace0.v ; equiv_make gold gate equiv; write_verilog trace0b.v ; prep -flatten -top equiv; hierarchy -top equiv; hierarchy -check; flatten; proc; bmuxmap; opt_clean;"

