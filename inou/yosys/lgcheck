# Mapping can also change the meaning of a retained state name (for example,
# an inverted register encoding). An unproven internal name match must not
# prevent proving the public outputs. Read the unresolved pairs from Yosys JSON,
# hide their internal names, then rebuild and reprove the ENTIRE comparison.
# No previously proved cut is assumed, and rename -hide never hides ports.
# This is a new proof attempt, not deletion of failed obligations from a proof.
state_retry_names=$(python3 - <<'PYSTATE_RETRY'
import json
import re
from pathlib import Path
try:
    module = json.loads(Path("lgcheck1n.json").read_text())["modules"]["equiv"]
except (OSError, ValueError, KeyError):
    raise SystemExit(0)
unproven = set()
for cell in module.get("cells", {}).values():
    if cell.get("type") != "$equiv":
        continue
    connections = cell["connections"]
    for a, b in zip(connections["A"], connections["B"]):
        if a != b:
            unproven.add((a, b))
nets = module.get("netnames", {})
names = set()
for name, net in nets.items():
    if not name.endswith("_gold"):
        continue
    base = name[:-5]
    other = nets.get(base + "_gate")
    # Restrict to literal names; never interpolate Yosys selection wildcards.
    if other and re.fullmatch(r"[A-Za-z_][A-Za-z0-9_.$]*", base):
        if any((a, b) in unproven for a, b in zip(net["bits"], other["bits"])):
            names.add("w:" + base)
# Cgen encodes the source Memory name reversibly in its wrapper instance.
# memory_module.cpp preserves <source>._mem<word>_<bit> after mapping.
# Restore only existing pairs, without collisions or port changes. A fresh
# comparison below must prove every proposed memory state and public output.
memory_commands = []
ports = module.get("ports", {})
for name in nets:
    match = re.fullmatch(
        r"(.*?)__lhdmem_h([0-9a-f]+)_e\.data\[([0-9]+)\]_([0-9]+)_(gold|gate)", name
    )
    if not match:
        continue
    prefix, encoded, word, bit, side = match.groups()
    try:
        decoded = bytes.fromhex(encoded).decode("utf-8")
    except (ValueError, UnicodeError):
        continue
    old = name[:-(len(side) + 1)]
    new = f"{prefix}{decoded}._mem{word}_{bit}"
    other = "gate" if side == "gold" else "gold"
    if not re.fullmatch(r"[A-Za-z_][A-Za-z0-9_.$]*", new):
        continue
    if new + "_" + other not in nets or new + "_" + side in nets:
        continue
    if old in ports or new in ports:
        continue
    memory_commands += [f"cd {side}", f"rename {old} {new}", "cd .."]
Path("lgcheck_memory_names.ys").write_text(";\n".join(memory_commands))
print(" ".join(sorted(names)))
PYSTATE_RETRY
)
if [ -s lgcheck_memory_names.ys ]; then
  run_clock_blind_yosys --heuristic -p "${yosys_state_prep}; script lgcheck_memory_names.ys;
      equiv_make gold gate equiv; hierarchy -top equiv;
      equiv_simple -undef; equiv_induct -undef -seq 4; equiv_status -assert" \
    2>lgcheck1r.err | tee lgcheck1r.log | grep "Equivalence successfully proven!"
  if [ $? -eq 0 ]; then
    echo "1r.Successfully matched ${GATE} with ${GOLD} top:${OPT_TOP}"
    exit 0
  fi
fi

if [ -n "$state_retry_names" ]; then
  run_clock_blind_yosys --heuristic -p "${yosys_state_prep}; rename -hide ${state_retry_names};
      equiv_make gold gate equiv; hierarchy -top equiv;
      equiv_simple -undef; equiv_induct -undef -seq 4; equiv_status -assert" \
    2>lgcheck1p.err | tee lgcheck1p.log | grep "Equivalence successfully proven!"
