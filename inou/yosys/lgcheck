run_equiv_yosys --heuristic -p "${yosys_read}; memory; opt -full; clk2fflogic; opt -full;
    equiv_make gold gate equiv; hierarchy -top equiv;
    equiv_simple; equiv_induct -seq 4; equiv_status -assert" \
  2>lgcheck1c.err | tee lgcheck1c.log | grep "Equivalence successfully proven!"
