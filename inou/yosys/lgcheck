# Find a conventional reset input on the SELECTED gold module. This must be
# derived from that module's prepared RTLIL, not from the concatenated source:
# hierarchy descent checks one child at a time, and an unrelated parent/sibling
# can have a reset even when the child does not (Dino's
# DualIssueRegisterFile). Preserve the spelling because miter prefixes the
# shared input with `in_`, and preserve polarity so active-low designs actually
# traverse their reset path (Minion uses rst_ni).
reset_name=""
if [ "$GOLD_RTLIL" != "" ]; then
  rtlil_tool="${SELF_DIR}/rtlil_children.py"
  for candidate in reset reset_i rst rst_i reset_n reset_ni rst_n rst_ni resetn rstn; do
    if ! has_candidate=$(python3 "$rtlil_tool" --rtlil "$GOLD_RTLIL" --top "$GOLD_TOP" --has-input "$candidate"); then
      echo "lgcheck: could not inspect reset port of $GOLD_TOP"
      exit 5
    fi
    if [ "$has_candidate" = yes ]; then
      reset_name=$candidate
      break
    fi
  done
else
  # Cache preparation is best-effort. Retain the conservative historical
  # fallback only when no RTLIL is available to inspect.
  for candidate in reset reset_i rst rst_i reset_n reset_ni rst_n rst_ni resetn rstn; do
    if sed 's|//.*||' "${GOLD}" | grep -qw "$candidate"; then
      reset_name=$candidate
      break
    fi
  done
fi
if [ "$reset_name" != "" ]; then
  reset_assert=1
  reset_release=0
  case "$reset_name" in
  *_n | *_ni | resetn | rstn)
    reset_assert=0
    reset_release=1
    ;;
  esac
  reset_signal="in_${reset_name}"

  # Reset prologue of the temporal-induction stage: the miter's shared reset
  # is asserted in the first TEMPINDUCT_RESET_STEPS sat steps and the proof
  # starts AFTER them (`sat -tempinduct -seq N`: steps 1..N are a prefix whose
  # property is not checked). From step N+1 on the reset is a FREE input in
  # the base case, and the induction step never sees any reset constraint
  # (yosys does not copy -set-at into its induction instance).
  #
  # Why a `-seq` prefix and not plain `-set-at` (a FALSE PROOF: f^d PROVED
  # equal to f+d whenever the reset port was named rst): the tempinduct base
  # case adds yosys' simple-path constraint (force_unique_state: every state
  # of the checked window distinct). That is sound only when the inputs of
  # the window are free, because then the shortest counterexample is loop
  # free. With `-set-at 1 rst 1 -set-at 2 rst 0` inside the window, the
  # zero-initialized state at step 1 and the reset state at step 2 are the
  # SAME state, so every base case of length >=2 was UNSAT (vacuously
  # "proven") and the induction step then closed by exhausting the small
  # state space. With the prefix the unique-state window begins after the
  # reset, where every input is free again. (`-set-at 0` was a no-op: sat
  # timesteps are 1-based.)
  #
  # 2d-reg fix: the prior `-set in_reset 1` applied the constraint to EVERY
  # temporal-induction timestep (not just cycle 0/1), pinning reset high
  # forever — so every reset-bearing register stayed at its reset value and
  # ANY two such circuits proved trivially equivalent (a vacuous pass:
  # add-vs-sub "matched"). Use per-cycle `-set-at` so reset is high only at
  # cycles 0 and 1 and the induction step runs with reset free (normal
  # operation), where a real difference is actually observable.
  TEMPINDUCT_RESET_STEPS=2
  RESET_STMT="-seq ${TEMPINDUCT_RESET_STEPS}"
  for ((t = 1; t <= TEMPINDUCT_RESET_STEPS; t++)); do
    RESET_STMT+=" -set-at ${t} ${reset_signal} ${reset_assert}"
  done
else
  RESET_STMT=""
fi

# Clock inputs of the SELECTED gold module (only needed to drive a reset). The
# bounded check below runs under clk2fflogic, where a sat step is a global-
# clock tick and the design clock is an ordinary free input: holding reset for
# a few steps does NOT reset a synchronous-reset register unless the clock
# actually rises while reset is asserted. picorv32 (sync resetn) false-refuted
# because the solver kept in_clk low for the whole reset window, so the
# "post-reset" comparison started from the power-on state. Trace the clock
# pins of the gold state cells back to input ports; fall back to conventional
# names when the RTLIL cache is unavailable or hierarchical.
clock_names=()
if [ "$reset_name" != "" ]; then
  if [ "$GOLD_RTLIL" != "" ]; then
    if ! clock_list=$(python3 "${SELF_DIR}/rtlil_children.py" --rtlil "$GOLD_RTLIL" --top "$GOLD_TOP" --clock-inputs); then
      echo "lgcheck: could not inspect clock ports of $GOLD_TOP"
      exit 5
    fi
    for clk_candidate in $clock_list; do
      clock_names+=("$clk_candidate")
    done
    if [ "${#clock_names[@]}" -eq 0 ]; then
      for clk_candidate in clk clock clk_i clock_i i_clk clk_in aclk; do
        if [ "$(python3 "${SELF_DIR}/rtlil_children.py" --rtlil "$GOLD_RTLIL" --top "$GOLD_TOP" --has-input "$clk_candidate")" = yes ]; then
          clock_names+=("$clk_candidate")
          break
        fi
      done
    fi
  else
    for clk_candidate in clk clock clk_i clock_i i_clk clk_in aclk; do
      if sed 's|//.*||' "${GOLD}" | grep -qw "$clk_candidate"; then
        clock_names+=("$clk_candidate")
        break
      fi
    done
  fi
fi

# Primary hardware inputs are defined bit vectors, as in cvc5 and the BMC
# check below. Allowing X inputs makes equivalent mux/gate implementations
# disagree only in undefined propagation and prematurely fails the base case.
run_clock_blind_yosys -p " $(gold_read_cmds); proc; bmuxmap; opt -keepdc; flatten ; rename -top gold; prep -top gold ; design -stash gold;
              $(gate_read_cmds); proc; bmuxmap; opt -keepdc; flatten ; rename -top gate; prep -top gate ; design -stash gate;
              design -copy-from gold -as gold gold
              design -copy-from gate -as gate gate

              miter -equiv -flatten -make_outputs -ignore_gold_x gold gate miter
              hierarchy -top miter
              memory_map
              opt_clean
              write_verilog trace2.v
              sat -tempinduct-def -timeout 90 -prove trigger 0 ${RESET_STMT} -set-init-zero -set-def-inputs -show-ports miter
              " \
  2>lgcheck2.err | tee lgcheck2.log | grep "proven: SUCC"
if [ $? -eq 0 ]; then
  echo "2.Successfully matched ${GATE} with ${GOLD} top:${OPT_TOP}"
  exit 0
fi

