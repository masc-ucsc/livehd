// A runtime index can exceed the 4 lanes (idx is u3), so the programmer masks it:
// a memory port address must be PROVEN inside [0, size) at compile time (an
// unmasked `lanes[idx]` is the compile error tests/errors/mem_address_overflow.prp).
// array_oob_runtime_test.sh checks the masked read wraps like the mask says.
pub comb array_oob_runtime(idx:U3) -> (o:U8) {
  mut lanes:[4]U8 = 0
  lanes[0] = 0x11
  lanes[1] = 0x22
  lanes[2] = 0x33
  lanes[3] = 0x44
  o = lanes[idx & 3]
}
