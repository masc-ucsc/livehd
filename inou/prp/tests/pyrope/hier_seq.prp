/*
:name: hier_seq
:type: lgraph compile
*/

// Sequential 3-level hierarchy fixture for the color / partition / abc passes.
//
//   top -> stage_unit (x2) -> delayer (two per stage_unit)
//
// A clean 2-deep pipeline: `delayer` is 1 cycle, `stage_unit` adds its own
// flop for 2 cycles total, `top` combines two stage_units. Flops live in
// `delayer` (reg r) and `stage_unit` (reg r), so `pass color synth` must split
// each def at its registers, and the named flops exercise abc seq=true
// flop-name preservation (`= 0` is Pyrope's implicit synchronous reset: the
// registers map to DFF cells `r_<bit>`, `\a.d1.r_<bit>` under a whole-design
// flatten). The shared `m` value also gives acyclic coloring a
// real internal fanout, independent of frontend width/sign wrappers. Registers
// only store (no narrowing) because runtime wrap/sat has no tolg lowering yet.

mod delayer(din:u8) -> (q:u8@[1]) {
  reg r:u8 = 0
  q = r
  r = din
}

mod stage_unit(din:u8, k:u8) -> (y:u8@[2]) {
  const m = din & k
  const n = m ^ k
  stage[1] d1 = delayer(din=m)
  stage[1] d2 = delayer(din=n)
  reg r:u8 = 0
  y = r
  r = d1 ^ d2
}

mod top(din:u8, k1:u8, k2:u8) -> (o:u9@[2]) {
  stage[2] a = stage_unit(din=din, k=k1)
  stage[2] b = stage_unit(din=din, k=k2)
  o = a + b
}
