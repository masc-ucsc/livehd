/*
:name: abc_flat_names
:type: lgraph compile
*/

// Whole-design-flatten flop-name preservation fixture for `pass abc`.
//
// Every register is declared WITHOUT an initializer, so it carries neither an
// init nor a reset. Under register=true each maps to per-bit plain DFF cells
// that must keep the ORIGINAL hierarchical name (`\a.r_<bit>`); a Liberty
// without a DFF cell rebuilds one multi-bit native flop `a.r` instead. Never
// anonymous per-bit __rinit/__r/g<id> flops: the LEC leans on that name
// correspondence.

mod holder(din:u8) -> (q:u8@[1]) {
  reg r:u8
  q = r
  r = din
}

mod top(din:u8, k1:u8, k2:u8) -> (o:u9@[1]) {
  stage[1] a = holder(din=din & k1)
  stage[1] b = holder(din=din | k2)
  o = a + b
}
