// p2v2p fuzz find (2026-10-08): cprop splits the sum into (s >> 2) + y over a
// 3-bit signed s; the one-bit SIGNED shift result (0/-1) was emitted as a bare
// bit select (0/+1).
pub comb sra_signed_bit(i0:S9, i2:U16, i3:U12) -> (o1:U3) {
  mut t0:U5 = 0
  sat t0 = (i0#sext[1..=3] + ((i3 << 2) & i2))
  wrap o1 = t0
}
