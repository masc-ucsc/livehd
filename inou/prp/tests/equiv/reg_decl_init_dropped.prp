/*
:name: reg_decl_init_dropped
:type: equiv
:verilog_top: reg_decl_init_dropped
:pyrope_top: reg_decl_init_dropped
*/
// The golden RTL has a power-on value and no reset. Keep a nil declaration
// and explicitly attach resetless initial contents; `= 1` would instead request
// a reset value and introduce a different interface.
pub mod reg_decl_init_dropped::[timecheck=false](clk:Clock, we:U1, a:U2, d:U4) -> (q:U4@[], full_n:U1@[]) {
  reg mem:[4]U4:[ordering="old"]
  reg internal_full_n:U1:[initial=1, reset_pin=false] = nil
  if we != 0 {
    mem[a] = d
  }
  internal_full_n = we
  q = mem[a]
  full_n = internal_full_n
}
