/*
:name: generic_top_default
:type: lec
:lec_top: generic_top_default
*/

// The original template remains callable with explicit bindings, including
// from inside its own default specialization.
pub mod generic_top_default<N=2>(a:u8) -> (y:u9@[0]) {
  if N == 2 {
    y = generic_top_default<N=3>(a=a)
  } else {
    y = a + N
  }
}
