// The library defines its OWN `inc` (a 4-bit mask): a lambda generic bound by
// a caller must still dispatch to the CALLER's `inc`, never this one.
comb inc(v:U8) -> (o:U8) { o = v & 0x0F }
comb dec(v:U8) -> (o:U8) { o = v & 0x0F }
pub comb apply<F>(a:U8) -> (r:U8) {
  r = F(v=a)
}
pub mod m<F>(a:U8) -> (r:U8@[0]) {
  r = F(v=a)
}
pub comb applyv(f, a:U8) -> (r:U8) {
  r = f(v=a)
}
