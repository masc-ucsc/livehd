/*
:name: latch_match_exhaustive
:type: equiv
:verilog_top: latch_match_exhaustive
:pyrope_top: latch_match_exhaustive
*/

// The empty else is unreachable: both values of the selector write q.
pub mod latch_match_exhaustive(sel:U1, a:U4, b:U4) -> (q:U4@[]) {
  reg q:U4:[latch=true]
  match sel {
    == 0 {
      q = a
    }
    == 1 {
      q = b
    }
    else {
    }
  }
}
