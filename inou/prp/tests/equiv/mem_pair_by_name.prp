/*
:name: mem_pair_by_name
:type: lec
:lec_top: mem_pair_by_name
*/
// Reference for the mem_pair_by_name group: lhd lec pairs same-shape memories
// by NAME (pass/lec query.cpp's memory-correspondence builder), and by
// occurrence order only among the memories a name cannot pair -- the same name
// correspondence it uses for flops. `ma` and `mb` have the same shape and no
// reset, and every write lands in both at once, so they differ only in their
// power-on contents, which the pairing decides.
//   _1 declares them in the other order: the same design, must PROVE.
//   _2 also swaps the two reads, so `qa` reads the memory named `mb`. That is
//      the reference with `ma` and `mb` renamed: under name correspondence
//      (as for a flop name swap) it must REFUTE. Paired by occurrence order,
//      the reference `ma` met this side's `mb` (the first memory of the shape
//      on each side), crossing the name correspondence: it came back PROVEN.
pub mod mem_pair_by_name(w:Bool, a:U2, d:U8, ra:U2) -> (qa:U8@[0], qb:U8@[0]) {
  reg ma:[4]U8:[ordering="old"] = nil
  reg mb:[4]U8:[ordering="old"] = nil
  if w {
    ma[a] = d
    mb[a] = d
  }
  qa = ma[ra]
  qb = mb[ra]
}
