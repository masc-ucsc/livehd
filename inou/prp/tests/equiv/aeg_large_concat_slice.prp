/*
:name: aeg_large_concat_slice
:set: compile.cprop.engine=classic
:type: lec
*/
// A shared pack with more than 64 lanes, read across two partial byte lanes.
// Every byte has its own producer so adjacent slices cannot collapse the pack first.
pub comb top(a:U640, b:U8) -> (y:U8, whole:U640) {
  mut packed:U640 = 0
  // Explicit lanes keep this a pack rather than a compact loop.
  packed#[0..<8] = a#[0..<8] ^ b
  packed#[8..<16] = a#[8..<16] ^ b
  packed#[16..<24] = a#[16..<24] ^ b
  packed#[24..<32] = a#[24..<32] ^ b
  packed#[32..<40] = a#[32..<40] ^ b
  packed#[40..<48] = a#[40..<48] ^ b
  packed#[48..<56] = a#[48..<56] ^ b
  packed#[56..<64] = a#[56..<64] ^ b
  packed#[64..<72] = a#[64..<72] ^ b
  packed#[72..<80] = a#[72..<80] ^ b
  packed#[80..<88] = a#[80..<88] ^ b
  packed#[88..<96] = a#[88..<96] ^ b
  packed#[96..<104] = a#[96..<104] ^ b
  packed#[104..<112] = a#[104..<112] ^ b
  packed#[112..<120] = a#[112..<120] ^ b
  packed#[120..<128] = a#[120..<128] ^ b
  packed#[128..<136] = a#[128..<136] ^ b
  packed#[136..<144] = a#[136..<144] ^ b
  packed#[144..<152] = a#[144..<152] ^ b
  packed#[152..<160] = a#[152..<160] ^ b
  packed#[160..<168] = a#[160..<168] ^ b
  packed#[168..<176] = a#[168..<176] ^ b
  packed#[176..<184] = a#[176..<184] ^ b
  packed#[184..<192] = a#[184..<192] ^ b
  packed#[192..<200] = a#[192..<200] ^ b
  packed#[200..<208] = a#[200..<208] ^ b
  packed#[208..<216] = a#[208..<216] ^ b
  packed#[216..<224] = a#[216..<224] ^ b
  packed#[224..<232] = a#[224..<232] ^ b
  packed#[232..<240] = a#[232..<240] ^ b
  packed#[240..<248] = a#[240..<248] ^ b
  packed#[248..<256] = a#[248..<256] ^ b
  packed#[256..<264] = a#[256..<264] ^ b
  packed#[264..<272] = a#[264..<272] ^ b
  packed#[272..<280] = a#[272..<280] ^ b
  packed#[280..<288] = a#[280..<288] ^ b
  packed#[288..<296] = a#[288..<296] ^ b
  packed#[296..<304] = a#[296..<304] ^ b
  packed#[304..<312] = a#[304..<312] ^ b
  packed#[312..<320] = a#[312..<320] ^ b
  packed#[320..<328] = a#[320..<328] ^ b
  packed#[328..<336] = a#[328..<336] ^ b
  packed#[336..<344] = a#[336..<344] ^ b
  packed#[344..<352] = a#[344..<352] ^ b
  packed#[352..<360] = a#[352..<360] ^ b
  packed#[360..<368] = a#[360..<368] ^ b
  packed#[368..<376] = a#[368..<376] ^ b
  packed#[376..<384] = a#[376..<384] ^ b
  packed#[384..<392] = a#[384..<392] ^ b
  packed#[392..<400] = a#[392..<400] ^ b
  packed#[400..<408] = a#[400..<408] ^ b
  packed#[408..<416] = a#[408..<416] ^ b
  packed#[416..<424] = a#[416..<424] ^ b
  packed#[424..<432] = a#[424..<432] ^ b
  packed#[432..<440] = a#[432..<440] ^ b
  packed#[440..<448] = a#[440..<448] ^ b
  packed#[448..<456] = a#[448..<456] ^ b
  packed#[456..<464] = a#[456..<464] ^ b
  packed#[464..<472] = a#[464..<472] ^ b
  packed#[472..<480] = a#[472..<480] ^ b
  packed#[480..<488] = a#[480..<488] ^ b
  packed#[488..<496] = a#[488..<496] ^ b
  packed#[496..<504] = a#[496..<504] ^ b
  packed#[504..<512] = a#[504..<512] ^ b
  packed#[512..<520] = a#[512..<520] ^ b
  packed#[520..<528] = a#[520..<528] ^ b
  packed#[528..<536] = a#[528..<536] ^ b
  packed#[536..<544] = a#[536..<544] ^ b
  packed#[544..<552] = a#[544..<552] ^ b
  packed#[552..<560] = a#[552..<560] ^ b
  packed#[560..<568] = a#[560..<568] ^ b
  packed#[568..<576] = a#[568..<576] ^ b
  packed#[576..<584] = a#[576..<584] ^ b
  packed#[584..<592] = a#[584..<592] ^ b
  packed#[592..<600] = a#[592..<600] ^ b
  packed#[600..<608] = a#[600..<608] ^ b
  packed#[608..<616] = a#[608..<616] ^ b
  packed#[616..<624] = a#[616..<624] ^ b
  packed#[624..<632] = a#[624..<632] ^ b
  packed#[632..<640] = a#[632..<640] ^ b
  y = packed#[318..<326]
  whole = packed
}
