/*
:name: blocking_ff_state
:type: equiv
:verilog_top: blocking_ff_state
:pyrope_top: blocking_ff_state
*/
// Native Slang must retain the two registers written in separate processes.
pub mod blocking_ff_state::[timecheck=false](clk:u1, d:u1) -> (q:u1@[]) {
  reg sync_0:u1
  reg sync_1:u1
  sync_0 = d
  sync_1 = sync_0
  q = sync_1
}
