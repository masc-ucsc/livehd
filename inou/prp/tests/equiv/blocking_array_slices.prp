/*
:name: blocking_array_slices
:type: equiv
:verilog_top: blocking_array_slices
:pyrope_top: blocking_array_slices
*/
pub mod blocking_array_slices(clk:Clock, en:U1, addr:U1, din:U4, ra:U1) -> (q:U4@[]) {
  reg mem:[2]U4:[ordering="old"] = nil
  reg q:U4 = nil
  q = mem[ra]
  if en != 0 {
    mem[addr] = din
    if addr == ra { q = din }
  }
}
