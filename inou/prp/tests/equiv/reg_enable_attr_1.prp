/*
:name: reg_enable_attr_1
*/

// The `enable=` attribute is not a new semantic: the same flop written with
// both guards spelled as plain `if`s must be the SAME design. LEC'd against
// reg_enable_attr.prp by prp-lec-reg_enable_attr_1.
pub mod gate(clk:Clock, rst:Reset, g:U1, s:U1, d:U8) -> (q:U8@[0]) {
  reg r:U8:[clock_pin=clk, reset_pin=rst] = 0
  if g != 0 and s != 0 {
    r = d
  }
  q = r
}
