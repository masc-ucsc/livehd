/*
:name: packed_variable_modifiers
:type: equiv
*/
comb packed_variable_modifiers(a:S4, b:S4) -> (s:S8, high:S4, count:U4, parity:U1, any:U1, all:U1) {
  mut p:[2]S4 = 0
  p[0] = a
  p[1] = b
  s = p#sext[..]
  high = p#sext[4..]
  count = p#+[..]
  parity = p#^[..]
  any = p#|[..]
  all = p#&[0..=7]
}
