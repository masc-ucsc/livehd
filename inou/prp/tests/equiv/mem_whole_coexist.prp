/*
:name: mem_whole_coexist
:type: equiv
:verilog_top: mem_whole_coexist.coexist
:pyrope_top: coexist
*/

// A whole-array `update` (`arr = inp`) COEXISTING with a per-entry write
// (`arr[waddr] = wdata` under `we`). The per-entry write comes later in program
// order, so it wins for the entry it touches (mem_bulk_vs_entry_order has the
// other order). The reads come first and see the committed contents.
pub mod coexist(inp:U80, waddr:U3, wdata:U10, we:Bool, idx:U3) -> (r:U10@[0], allout:U80@[0]) {
  reg arr:[8]U10 = nil
  r = arr[idx]
  allout = arr
  arr = inp
  if we {
    arr[waddr] = wdata
  }
}
