/*
:name: phase_clock_gate_chain
:type: equiv
:verilog_top: phase_clock_gate_chain
:pyrope_top: phase_clock_gate_chain
*/

// Normalized Pyrope side of the golden's two hierarchical glitch-free clock
// gates. A clock is structural and is never read or combined as data here.
// Clock_cell recognition must translate the Verilog chain to the root-clock
// register enable `en0 & en1` before comparing the two representations.
pub mod phase_clock_gate_chain::[timecheck=false](clk:Clock, en0:U1, en1:U1, d:U3) -> (q:U3@[]) {
  reg state:U3:[clock_pin=clk]
  if en0 != 0 and en1 != 0 {
    state = d
  }
  q = state
}
