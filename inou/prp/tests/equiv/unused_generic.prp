/*
:name: unused_generic
:type: equiv
:verilog_top: leaf
:pyrope_top: leaf
:compile_top: leaf
*/

pub mod leaf<N=1>(a:U8) -> (y:U8@[]) {
  reg value:U8 = nil
  wrap value = a + N
  y = value
}
pub mod select<FAST=false>(a:U8) -> (y:U8@[]) {
  if FAST { y = leaf<N=2>(a=a) }
  else { y = leaf(a=a) }
}
