/*
:name: ram_loop_counter
:type: equiv
:verilog_top: ram_loop_counter
:pyrope_top: ram_loop_counter
*/

// Independent reference: retain the data latch and the observable counter.
// The private RAM loop counter needs no state. Descending and zero-trip
// loops in the Verilog also expose their terminal values in exit_values.
pub mod ram_loop_counter(en:Bool, sel:Bool, d:U4) -> (q:U4@[0], seen:S32@[0], exit_values:U8@[0]) {
  reg r0_dout_tmp:U4:[latch=true] = nil
  reg b:S32:[latch=true] = nil
  if en {
    r0_dout_tmp = d
    if sel { b = 3 } else { b = 5 }
  }
  q = r0_dout_tmp
  seen = b
  exit_values = 0ub11110101
}
