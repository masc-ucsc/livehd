/*
:name: latch_match_partial
:type: equiv
:verilog_top: latch_match_partial
:pyrope_top: latch_match_partial
*/

// Two arms do not cover a two-bit selector: retain the real hold path.
pub mod latch_match_partial(sel:u2, a:u4, b:u4) -> (q:u4@[]) {
  reg state:u4:[latch=true]
  match sel {
    == 0 { state = a }
    == 1 { state = b }
    else {}
  }
  q = state
}
