/*
:name: loop_roll_flat_2
:set: compile.unroll=true
:lec_expect: refuted
:lec_grep_not: MATCHED \(semdiff compact-vs-unrolled virtual-occurrence fold
*/
// Negative control: same surviving lane shape and count, different descriptor
// start. The virtual fold must compare the inferred ordinal constants and
// decline; the ordinary solver then refutes 4*x-domain lanes 1..4 vs 0..3.
pub mod top(x:U8, y:U8) -> (z:U10@[0]) {
  mut acc:U10 = 0
  for i in 1..<5 {
    acc = acc + (if x > i { y } else { 0 })
  }
  z = acc
}
