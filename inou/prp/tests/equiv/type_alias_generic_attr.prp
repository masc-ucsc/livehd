/*
:name: type_alias_generic_attr
:type: equiv
:verilog_top: type_alias_generic_attr
:pyrope_top: type_alias_generic_attr
*/

// A named scalar alias passed through a generic must preserve the input
// width for a.[bits] and for the specialized module's ports.
type Elem_T = s4

mod add<T>::[timecheck=false](a:T, b:T) -> (y:T@[0]) {
  reg y_r = 0
  y = y_r
  const full = a + b
  y_r = full#[0..=(a.[bits] - 1)]
}

pub mod type_alias_generic_attr::[timecheck=false](a:s4, b:s4) -> (y:s4@[0]) {
  y = add<Elem_T>(a=a, b=b)
}
