/*
:name: phase_two_clock_ports
:type: equiv
:verilog_top: phase_two_clock_ports
:pyrope_top: phase_two_clock_ports
*/

// Flat twin of the golden's two-clock-port cell. Both of the cell's clock ports
// are bound to `clk`, so the whole design has ONE root; `fall` is a negedge reg
// and reads `rise` in the SAME source period, after the rise batch committed it.
// See the golden .v for why the clock analysis has to be design-wide.
pub mod phase_two_clock_ports::[timecheck=false](clk:Clock, d:U3) -> (q:U3@[]) {
  reg rise:U3:[clock_pin=clk]
  reg fall:U3:[clock_pin=clk, posclk=false]
  rise = d
  fall = rise
  q = fall
}
