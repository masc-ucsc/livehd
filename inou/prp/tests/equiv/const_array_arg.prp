/*
:name: const_array_arg
:type: equiv
:verilog_top: const_array_arg
:pyrope_top: const_array_arg
*/
// Independent XOR equations for two four-column binary matrices.
pub comb const_array_arg(data:U4) -> (result:U8) {
  mut a:U4 = 0
  mut b:U4 = 0
  if data#[0] != 0 { a = a ^ 9; b = b ^ 1 }
  if data#[1] != 0 { a = a ^ 6; b = b ^ 4 }
  if data#[2] != 0 { a = a ^ 3; b = b ^ 8 }
  if data#[3] != 0 { a = a ^ 12; b = b ^ 2 }
  result = (a << 4) | b
}
