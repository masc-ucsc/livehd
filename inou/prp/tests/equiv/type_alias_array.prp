/*
:name: type_alias_array
:type: equiv
:verilog_top: type_alias_array.top
:pyrope_top: top
*/

// A sized scalar alias remains a type when nested below an array type. Both W
// and Elem_T are compile-time declarations; the array must lower as two signed
// four-bit elements rather than reaching tolg with an unresolved type ref.
comptime const W = 4
type Elem_T = signed(bits=W)

pub comb top(x:s4) -> (y:s4) {
  mut values:[2]Elem_T = 0
  values[0] = x
  y = values[0]
}
