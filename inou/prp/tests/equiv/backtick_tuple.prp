// Reference for the backtick_tuple group: tuple-type field names, tuple
// literal keys and field reads, spelled plainly.
const bt_pair = (f1:U4, f2:U4)
pub mod backtick_tuple(a:U4, b:U4) -> (y:U4@[0], z:U4@[0]) {
  mut t:bt_pair = (f1=a, f2=b)
  y = t.f1
  z = t.f2
}
