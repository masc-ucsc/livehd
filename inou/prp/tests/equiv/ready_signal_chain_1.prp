/*
:name: ready_signal_chain_1
:type: equiv
:verilog_top: ready_signal_chain_1
:pyrope_top: ready_signal_chain_1
*/
// Independent acyclic equations; the SV has concurrent generated bit drivers.
pub comb ready_signal_chain_1(down:U1, valid:U4, sel:U2) -> (ready:U5, selected:U1, mirrored:U5) {
  const r4:U1 = down
  const r3:U1 = r4 | ((valid#[3]) ^ 1)
  const r2:U1 = r3 | ((valid#[2]) ^ 1)
  const r1:U1 = r2 | ((valid#[1]) ^ 1)
  const r0:U1 = r1 | ((valid#[0]) ^ 1)
  ready = r0 | (r1 << 1) | (r2 << 2) | (r3 << 3) | (r4 << 4)
  selected = ready#[sel]
  mirrored = ready
}
