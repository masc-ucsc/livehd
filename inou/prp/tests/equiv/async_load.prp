/*
:name: async_load
:type: equiv
:verilog_top: async_load
:pyrope_top: async_load
*/

// The asynchronous value is a live expression, independent of the clocked D.
pub mod async_load(clk:Clock, aload:Reset, din_load:U8, din:U8) -> (q:U8@[]) {
  wire load_value:U8
  reg state:U8:[clock_pin=clk, posclk=false, reset_pin=aload, async=true, initial=ref load_value]
  load_value = din_load ^ 0x5a
  state = din
  q = state
}
