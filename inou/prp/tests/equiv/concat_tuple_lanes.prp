/*
:name: concat_tuple_lanes
:type: equiv
:verilog_top: concat_tuple_lanes.top
:pyrope_top: top
*/

// A named bundle has no implicit bit order: its keys are canonicalized by
// name, so `concat(p)` is deliberately rejected (covered by
// tests/errors/concat_named_bundle_lane.prp). The programmer controls the
// layout by selecting fields as separate lanes. These two outputs prove that
// dotted field lanes retain their DECLARED widths and that changing their
// explicit order changes the packed layout.
pub comb top(p:(hi:u4, lo:s3), c:u2) -> (zt:u9, zd:u9) {
  zt = concat(p.lo, p.hi, c)   // lo in [8:6], hi in [5:2]
  zd = concat(p.hi, p.lo, c)   // hi in [8:5], lo in [4:2]
}
