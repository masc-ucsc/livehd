/*
:name: matched_filter_tb
:type: simulation
*/
// AUTO-GENERATED by gen_equiv_tb.py -- differential sim regression.
// Drives `top` with the same LCG stimulus as matched_filter_tb.v for 1000 cycles and
// checks the output signature against the Icarus-Verilog golden.
const top = import("matched_filter.top")

test matched_filter.sig {
  mut acc = top
  mut s   = 0x1234567890ABCDEF
  mut sig = 0
  tick 1000 {
    s = s * 6364136223846793005 + 1442695040888963407
    acc.x = s & 0xf
    s = s * 6364136223846793005 + 1442695040888963407
    acc.c_in = s & 0xf
    s = s * 6364136223846793005 + 1442695040888963407
    acc.load = s & 0x1
    acc.reset = clock < 4
    step
    if clock >= 4 {
      sig = sig * 1099511628211 + (acc.y & 0xfff)
    }
  }
  assert((sig & 0x3FFFFFFFFFFFFFFF) == 2424868315254929680, "signature mismatch vs iverilog golden matched_filter")
}
