/*
:name: generic_tuple_register
:type: equiv
:verilog_top: generic_tuple_register
:pyrope_top: generic_tuple_register
:state_match_flatten: true
*/

// Imported generic tuple ports, a nested named layout, forward bundle wires,
// a subtuple actual, and two specializations with different shapes.
// Whole output reads must observe q while conditional writes update din.
const cell = import("generic_tuple_register/cell.cell")
type Payload = (payload:(data:U8, valid:U1), tag:U2)
type Small = (data:U8, valid:U1)

pub mod generic_tuple_register(`clock`:Clock, `reset`:U1, a:U8, v:U1, tag:U2, flush:U1, enable:U1)
  -> (q:U8@[], valid:U1@[], t:U2@[]) {
  wire first_out:Payload = nil
  const input = (const payload=(const data:U8=a, const valid:U1=v), const tag:U2=tag)
  const first = cell<Payload>(`clock`=`clock`, `reset`=`reset`, data=input, flush=flush, enable=enable)
  first_out = first.out
  const second = cell<Small>(`clock`=`clock`, `reset`=`reset`, data=first_out.payload, flush=flush, enable=enable)
  q = second.out.data
  valid = second.out.valid
  t = first_out.tag
}
