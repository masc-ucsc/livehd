/*
:name: bit_selected_clocks
:type: equiv
:verilog_top: bit_selected_clocks
:pyrope_top: bit_selected_clocks
*/
// Scalar reference for independently clocked bits of a packed register.
pub mod bit_selected_clocks(clk:Clock, gate0:U1, gate1:U1, gate2:U1, gate:U1, clr_:Reset, data:U3, enable:U3) -> (q:U3@[]) {
  const c0 = Clock(clock_pin=clk, enable=(gate0 & gate) != 0)
  const c1 = Clock(clock_pin=clk, enable=(gate1 & gate) != 0)
  const c2 = Clock(clock_pin=clk, enable=(gate2 & gate) != 0)
  reg q__bit0:U1:[clock_pin=c0, reset_pin=clr_, async=true, negreset=true] = 0
  reg q__bit1:U1:[clock_pin=c1, posclk=false, reset_pin=clr_, async=true, negreset=true] = 1
  reg q__bit2:U1:[clock_pin=c2, reset_pin=clr_, async=true, negreset=true] = 0
  if (enable & 1) != 0 { q__bit0 = data & 1 }
  if (enable & 2) != 0 { q__bit1 = (data >> 1) & 1 }
  if (enable & 4) != 0 { q__bit2 = (data >> 2) & 1 }
  q = q__bit0 | (q__bit1 << 1) | (q__bit2 << 2)
}
