/*
:name: loop_helper_priority
:type: equiv
:pyrope_top: top
:verilog_top: top
*/
// RenameBuffer cleanup reproducer: a counted loop in an inlined comb.
// Previously failed with undefined 'inl1_*.valid_count.__loop0'; merely
// preserving that name also incorrectly folded the loop's carry to zero.
// Both call sites must retain the conditional accumulator updates.
comb valid_count(valid:U8) -> (count:U4) {
  count = 0
  for lane in 0..<8 {
    if valid#[0] != 0 and valid#[lane] != 0 { count = lane + 1 }
  }
}
pub comb top(a:U8, b:U8) -> (x:U4, y:U4) {
  x = valid_count(a)
  y = valid_count(b)
}
