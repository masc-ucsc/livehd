/*
:name: reg_attr_override
:type: equiv
:verilog_top: reg_attr_override.blink
:pyrope_top: blink
*/

// 2d-reg — per-reg flop-attr overrides beat the upass.reset_style flag
// (default sync): `async=true` selects an asynchronous reset and
// `reset_pin=rst_n` binds the declared `Reset` input, active-low
// through `negreset=true` (a reset's name carries no polarity since
// ruling 52), so no implicit reset input is minted.
pub mod blink(rst_n:Reset, en:Bool) -> (q:U8@[0]) {
  reg r:U8:[async=true, reset_pin=rst_n, negreset=true] = 5
  if en and r < 200 {
    wrap r = r + 1
  }
  q = r
}
