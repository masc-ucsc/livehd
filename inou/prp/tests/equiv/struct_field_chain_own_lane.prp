/*
:name: struct_field_chain_own_lane
:type: equiv
:verilog_top: struct_field_chain_own_lane_top
:pyrope_top: top
:gold_reader: slang
*/

// Pyrope side of the per-field write-chain false comb loop (CONTAINED-lane
// leg). See the golden .v for the shape being regressed: the interesting
// direction is the Verilog ROUND TRIP (prp-v2prp2v-struct_field_chain_own_lane),
// which reads that golden through the slang front end. This ordering is the
// one the disjoint-lane skip alone cannot dissolve -- it needs the read to
// re-base onto the writing Set_mask's `value`.
//
// Field-wise: rm = s_i; typ = (s_i == 1) ? 0 : i_i; o = {typ, rm, s_i}.
pub comb top(i_i:u2, s_i:u2) -> (o:u6) {
  mut typ:u2 = 0
  if s_i != 1 {
    typ = i_i
  }
  o = (typ << 4) | (s_i << 2) | s_i
}
