/*
:name: varargs_add
:type: equiv
:verilog_top: varargs_add.top
:pyrope_top: top
*/

// Task 1p — a var-args `comb` is INLINED at the call site: the leftover
// named actuals gather into `x` and are read by field name. The golden
// is the equivalent fixed-arity adder.
comb add1(...x) -> (r) {
  r = x.a + x.b + x.c
}

pub comb top(a:U8, b:U8, c:U8) -> (z:U9) {
  wrap z = add1(a=a, b=b, c=c)
}
