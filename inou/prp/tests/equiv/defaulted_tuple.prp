/*
:name: defaulted_tuple
:type: equiv
:verilog_top: top
:pyrope_top: top
*/

type Decode = (mut add:Bool = nil, mut sub:Bool = nil, mut rd:U5 = nil)
pub mod top(clk:Clock, resetn:Bool, opcode:U2, rd:U5) -> (add:Bool@[], sub:Bool@[], dest:U5@[]) {
  reg instr:Decode = nil
  instr.add = resetn and (opcode == 0)
  instr.sub = resetn and (opcode == 1)
  instr.rd = rd
  add = instr.add
  sub = instr.sub
  dest = instr.rd
}
