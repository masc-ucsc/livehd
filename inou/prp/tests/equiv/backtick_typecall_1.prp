/*
:name: backtick_typecall
:type: lec
:lec_top: backtick_typecall
*/
// Every type-call key (bits/max/min) and attribute read escaped. Before the
// front end canonicalized source names at its one text accessor,
// `Unsigned(`bits`=2)` left the width unset and this pair refuted.
pub mod backtick_typecall(a:U8) -> (y:U8@[0], w:U8@[0], z:U8@[0], v:U8@[0]) {
  mut t:Unsigned(`bits`=2)        = a#[0..<2]
  mut m:Unsigned(`max`=5)         = 1
  mut s:Signed(`min`=-4, `max`=3) = 1
  y = t.[`bits`]
  w = m.[`bits`]
  z = s.[`bits`]
  v = t + m
}
