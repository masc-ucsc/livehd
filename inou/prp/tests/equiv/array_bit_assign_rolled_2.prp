/*
:name: array_bit_assign_rolled_2
:lec_grep_not: negative-shift
*/
// The same rolled nested `for` as array_bit_assign_rolled_1.prp, pinning its
// OTHER spurious warning: "negative-shift: shift amount may be negative (range
// [-4, 3])" on `matrix[i]#[j] = ~a#[i] & 1`. The lifted loop's index port is
// declared with the full SIGNED range of its width, so `#[j]` (a `1 << j`)
// looks possibly negative although `j in 0..<4` is never negative. The lifted
// index must carry its real [first, last] range (or a non-negative fact). The
// pair proves today; only the grep fails. `lhd lec` echoes both sides' compile
// diagnostics as JSON lines (with their `code`), which is what
// `:lec_grep_not:` reads.
pub mod array_bit_assign_rolled(a:U4) -> (q:U4@[0], r:U4@[0]) {
  mut matrix:[4]U4 = 0
  for i in 0..<4 {
    for j in 0..<4 {
      if i < j {
        matrix[i]#[j] = a#[j]
      } elif i > j {
        matrix[i]#[j] = ~a#[i] & 1
      }
    }
  }
  q = matrix[2]
  r = matrix[1]
}
