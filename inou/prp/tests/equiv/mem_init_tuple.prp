/*
:name: mem_init_tuple
:type: equiv
:verilog_top: mem_init_tuple.regi2
:pyrope_top: regi2
:name_match_only: false
*/

// 1a-mem — a tuple-literal reg-array initializer packs per entry onto the
// Memory `init` pin (entry 0 in the low bits): power-on contents, same
// mechanism as a mut array's initializer, and the per-entry RESET value too
// (`= <literal>` says the same thing on an array that it says on a scalar reg).
// The module therefore mints the implicit reset it never names, and every
// entry is restored to its own value in ONE cycle of reset (the memory's
// whole-array reset pin). The async memory read lands @[0].
pub mod regi2(a:u8, i:u2, we:bool) -> (z:u8@[0]) {
  reg t:[4]u8 = (1,2,3,4)
  if we {
    t[i] = a
  }
  z = t[i]
}
