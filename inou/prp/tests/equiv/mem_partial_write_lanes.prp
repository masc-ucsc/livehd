/*
:name: mem_partial_write_lanes
:type: equiv simulation
:verilog_top: mem_partial_write_lanes
:pyrope_top: mem_partial_write_lanes
*/
// Memory PARTIAL writes `mem[a]#[lo..<hi] = v` lower to a write-MASKED port
// (the memory's `wensize` lanes), not to a read-modify-write: no old-value read
// port, and the cell's last-port-wins lanes merge several partial writes of
// one entry in one cycle. That merge is the language rule in EVERY ordering
// (docs 08-memories: a partial write updates the entry as the earlier writes
// of the cycle left it); ordering governs only what a same-cycle USER read
// sees. The read-modify-write lowering once lost it under ordering="old": its
// old-value reads saw the committed entry, so only the last lane survived.
//
//   P  "program": qp0 is read before the writes (committed), qp1 after them
//   O  "old":     qo sees the committed entry
//   F  "fwd":     qf, placed before the writes, still sees all of them
//   N  "none":    a colliding read is undefined, so qn only reads when idle
//   R  default ("program"), whole-entry + runtime-position writes: `#[k]` and
//      `#[j..+4]` have no constant lane, so R takes single-bit lanes
// The lanes of P/O/F/N are 2 bits wide: the half-word writes and the [2..<6]
// write share 2-bit boundaries (wensize 2).
pub mod mem_partial_write_lanes(we0:Bool, we1:Bool, we2:Bool, we3:Bool, a:U2, b:U2, c:U2, x:U4, y:U4, z:U4, w:U8, k:U3, j:U2, bv:U1, nib:U4, ra:U2)
  -> (qp0:U8@[0], qp1:U8@[0], qo:U8@[0], qf:U8@[0], qn:U8@[0], qr:U8@[0]) {
  reg P:[4]U8:[ordering="program"] = nil
  reg O:[4]U8:[ordering="old"] = nil
  reg F:[4]U8:[ordering="fwd"] = nil
  reg N:[4]U8:[ordering="none"] = nil
  reg R:[4]U8 = nil

  qp0 = P[ra]
  qf  = F[ra]
  if we0 {
    P[a]#[0..<4] = x
    O[a]#[0..<4] = x
    F[a]#[0..<4] = x
    N[a]#[0..<4] = x
  }
  if we1 {
    P[b]#[4..<8] = y
    O[b]#[4..<8] = y
    F[b]#[4..<8] = y
    N[b]#[4..<8] = y
  }
  if we2 {
    P[c]#[2..<6] = z
    O[c]#[2..<6] = z
    F[c]#[2..<6] = z
    N[c]#[2..<6] = z
  }
  qp1 = P[ra]
  qo  = O[ra]
  const nread = N[ra]
  qn = if we0 or we1 or we2 { 0 } else { nread }

  if we3 { R[c] = w }
  if we0 { R[a]#[k] = bv }
  if we1 { R[b]#[j..+4] = nib }
  qr = R[ra]
}

// Four cycles fill entries 0..3 with two half-word writes each; cycle 4 writes all
// three lanes of entry 1 (0xA low half, 0xB high half, then 0xC over bits
// 2..5): the entry must end 0xB2 in every ordering. The sampled outputs
// read the state after each clock edge.
test mem_partial_write_lanes.merge {
  mut d = mem_partial_write_lanes
  const we  = [1, 1, 1, 1, 1, 0]
  const we2 = [0, 0, 0, 0, 1, 0]
  const ad  = [0, 1, 2, 3, 1, 1]
  const xs  = [0, 1, 2, 3, 0xA, 0]
  const ys  = [4, 5, 6, 7, 0xB, 0]
  const e   = [0x40, 0x51, 0x62, 0x73, 0xB2, 0xB2]
  tick 6 {
    d.we0 = we[clock] == 1
    d.we1 = we[clock] == 1
    d.we2 = we2[clock] == 1
    d.we3 = clock == 0
    d.a   = ad[clock]
    d.b   = ad[clock]
    d.c   = ad[clock]
    d.ra  = ad[clock]
    d.x   = xs[clock]
    d.y   = ys[clock]
    d.z   = 0xC
    d.w   = 0x55
    d.k   = 7
    d.j   = 2
    d.bv  = 1
    d.nib = 0xF
    step
    assert(d.qp0 == e[clock])
    assert(d.qp1 == e[clock])
    assert(d.qo == e[clock])
    assert(d.qf == e[clock])
    if we[clock] == 0 {
      assert(d.qn == e[clock])
    }
    // R: entry 0 is 0x55, then bit 7 set, then bits 2..5 set: 0xFD.
    if clock == 0 {
      assert(d.qr == 0xFD)
    }
  }
}
