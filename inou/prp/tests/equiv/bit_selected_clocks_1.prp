/*
:name: bit_selected_clocks_1
:type: equiv
:verilog_top: bit_selected_clocks
:pyrope_top: bit_selected_clocks
*/
// Scalar reference for independently clocked bits of a packed register. The
// per-bit registers carry the bus-expansion names (core/bus_name.hpp) the
// slang reader gives the bits it splits: `q[0]`, `q[1]`, `q[2]`.
pub mod bit_selected_clocks(clk:U1, gate0:U1, gate1:U1, gate2:U1, gate:U1, clr_:Reset, data:U3, enable:U3) -> (q:U3@[]) {
  wire c0:U1 = (clk & gate0) & gate
  wire c1:U1 = (clk & gate1) & gate
  wire c2:U1 = (clk & gate2) & gate
  reg `q[0]`:U1:[clock_pin=c0, reset_pin=clr_, async=true, negreset=true] = 0
  reg `q[1]`:U1:[clock_pin=c1, posclk=false, reset_pin=clr_, async=true, negreset=true] = 1
  reg `q[2]`:U1:[clock_pin=c2, reset_pin=clr_, async=true, negreset=true] = 0
  if (enable & 1) != 0 { `q[0]` = data & 1 }
  if (enable & 2) != 0 { `q[1]` = (data >> 1) & 1 }
  if (enable & 4) != 0 { `q[2]` = (data >> 2) & 1 }
  q = `q[0]` | (`q[1]` << 1) | (`q[2]` << 2)
}
