/*
:name: aeg_tree_cmp_same
:set: compile.aegraph.rules_disable=group:arith+group:div+group:mask+group:mux+group:shift
:type: lec
*/
// PYROPE-vs-PYROPE group, the fixture of the tree aegraph (upass/aeg, todo 2a-treeaeg): once the shared sum reads one name, comparing it with itself is a constant.
// A `mod`: the step rewrites only a body tolg alone reads (a comb's body is inlined and cached as walked).
// REFERENCE = every rule group off, so the tree step still shares and forwards but rewrites nothing; `_1` = the rules on.
pub mod top(a:U8, b:U8) -> (e:Bool@[0], l:Bool@[0], g:Bool@[0]) {
  e = (a + b) == (b + a)
  l = (a + b) < (b + a)
  g = (a - b) > (a - b)
}
