/*
:name: wire_cond_driver
:type: equiv
:verilog_top: wire_cond_driver.wcond
:pyrope_top: wcond
*/

// 2c-wire — a `wire` may be driven CONDITIONALLY, as long as it is driven only
// ONCE. A `wire` is a single-driver net: wherever that one assignment sits, it
// is still the whole definition of the net, so the wire carries that value on
// EVERY path — identical to writing the assignment unconditionally. The `if`
// below has no `else`, and `o` (read outside it) is `a + 1` regardless of `c`.
// This replaces the old `wire_incomplete` error test, which required coverage.
pub comb wcond(a:U8, c:Bool) -> (o:U8) {
  wire w:U8 = nil
  if c {
    wrap w = a + 1
  }
  o = w
}
