/*
:name: aeg_pack_slice_lanes
:set: compile.cprop.engine=classic
:type: lec
*/
// PYROPE-vs-PYROPE group, the fixture of the aegraph post step that folds a slice of
// a packed value into the pack's own lanes (Cprop::do_post, scalar_get_mask_packed).
// Reduced from XiangShan's fpsqrt_r16_block: a sparse bit pack (an Or of shifted 1-bit
// fields) is written into a wire, sliced to 54 bits, shifted and packed again into two
// 55-bit lanes. Bitwidth removes the `#[0..<54]` masks because the unpacked Or's range
// is tighter than 54 bits; when the slice is folded into a Concat only AFTER that, the
// Concat declares its full 55-bit window and the shifted lane driver comes out 56 bits
// wide: an internal "Concat lane ... occupies 56 bits but its declared window is 55".
// This is the REFERENCE, compiled by the classic engine; `aeg_pack_slice_lanes_1.prp`
// is the same source compiled by the e-graph engine.
pub comb top(m:(e12:U1, e11:U1, e10:U1, e9:U1, e8:U1, e7:U1, e6:U1, e5:U1, e4:U1, e3:U1, e2:U1, e1:U1, e0:U1)) -> (y:U110, z:U112) {
  wire mask_csa_ext:U112 = nil
  wire mask_rt_ext:U110 = nil
  mask_csa_ext = (mask_csa_ext#[0..<56]#[2..<56] << 56) | (((m.e12 & 1) << 50) | ((m.e11 & 1) << 46) | ((m.e10 & 1) << 42) | ((m.e9 & 1) << 38) | ((m.e8 & 1) << 34) | ((m.e7 & 1) << 30) | ((m.e6 & 1) << 26) | ((m.e5 & 1) << 22) | ((m.e4 & 1) << 18) | ((m.e3 & 1) << 14) | ((m.e2 & 1) << 10) | ((m.e1 & 1) << 6) | ((m.e0 & 1) << 2))
  mask_rt_ext = (mask_rt_ext#[0..<55]#[2..<55] << 55) | mask_csa_ext#[0..<56]#[0..<55]
  const _GEN_5__w1 = mask_rt_ext#[55..<0x6e]#[0..<54] << 1
  const _GEN_2__w1 = mask_csa_ext#[0..<56]#[0..<54] << 2
  const _GEN_3__w1 = mask_rt_ext#[0..<55]#[0..<54] << 1
  const _GEN_6__w1 = (_GEN_5__w1#[0..<55] << 55) | _GEN_3__w1#[0..<55]
  y = _GEN_6__w1
  z = mask_csa_ext
}
