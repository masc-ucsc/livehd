/*
:name: unsigned_slice_zext
:type: equiv
*/
// `Unsigned(x)` of an already-unsigned x is the identity, and a bit window
// wider than the value is a plain ZERO extension -- `a#[0..=7]` of a 2-bit 3
// is still 3. `Unsigned(s)` of a signed s keeps its bit pattern.
comb unsigned_slice_zext(x:U3, s:S4) -> (y:U8, z:U8, w:U4) {
  const a = 3
  const b = a#[0..=7]
  cassert(b == a)
  y = Unsigned(x)#[0..=7]
  z = (Unsigned(x)#[0..=7]) + 1
  w = Unsigned(s)#[0..=3]
}
