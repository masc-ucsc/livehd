/*
:name: conditional_latch_call
:type: equiv
:verilog_top: conditional_latch_call.top
:pyrope_top: top
*/

// Latches have no clock edge to suppress, so a conditional instance must
// transport activation into the callee and AND it with the latch enable.
mod inner(gate:Bool, d:U8) -> (q:U8@[0]) {
  reg l:U8:[latch=true]
  q = l
  if gate {
    l = d
  }
}

pub mod top(active:Bool, gate:Bool, d:U8) -> (q:U8@[0]) {
  q = 0
  if active {
    q = inner(gate=gate, d=d)
  }
}
