/*
:name: comb_array_const_index_read
:type: equiv
:verilog_top: comb_array_const_index_read
:pyrope_top: top
:verilog_check_timeout: 20
*/

// `:verilog_check_timeout:` -- lgcheck's `sat -tempinduct` cannot close this
// 8x3 register file with runtime read AND write addresses, so its leg spent
// the full 240s default on every run to print "inconclusive, NOT a fail".
// Nothing is lost by capping it: a real divergence still comes back fast (a
// one-XOR corruption of the emitted netlist refutes in 0.9s), and the leg that
// actually guards this regression is the native `lhd lec` above, which PROVES.

// Pyrope twin: the comb array `d` is copied out of `q` entry by entry with
// CONSTANT indices, which is exactly what pass/prp_writer emits for the
// golden's `d = q` / `q <= d` (Pyrope has no runtime whole-array assignment).
// The const-indexed READ of a written comb-array entry is the regression — see
// the golden .v.

// prp-style-allow likely-unrolled-loop
pub mod top(clk_i:Clock, en_i:U1, wa_i:U3, wd_i:U3, ra_i:U3) -> (rd_o:U3@[]) {
  reg q:[8]U3:[ordering="old", clock_pin=clk_i]
  mut d:[8]U3 = 0
  d[0] = q[0]
  d[1] = q[1]
  d[2] = q[2]
  d[3] = q[3]
  d[4] = q[4]
  d[5] = q[5]
  d[6] = q[6]
  d[7] = q[7]
  d[wa_i] = wd_i
  if en_i != 0 {
    for x in 0..<8 {
      q[x] = d[x]
    }
  }
  rd_o = q[ra_i]
}
