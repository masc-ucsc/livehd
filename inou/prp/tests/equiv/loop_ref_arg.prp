/*
:name: loop_ref_arg
:type: equiv
:verilog_top: loop_ref_arg
:pyrope_top: loop_ref_arg
:lec_top: loop_ref_arg
*/
// A loop body whose only write to an outer variable is a call writing it back
// through `ref`: `addby(ref m, ...)`, and the UFCS form `n.bump(...)` of a
// `ref self` comb. The loop roller's carry analysis saw only stores, so the
// rolled `__loop0` got no carry port for `m`, and `s` came out constant 0
// (silently: the equivalent unrolled loop was right). Such a loop now stays
// unrolled, so rolled and unrolled compile agree (_1 is the unrolled side).
comb addby(ref x:U8, by:U8) -> () {
  wrap x = x + by
}
comb bump(ref self:U8, by:U8) -> () {
  wrap self = self + by
}
pub mod loop_ref_arg(a:U4, b:U4) -> (s:U8@[0], t:U8@[0]) {
  mut m:U8 = 0
  for i in 0..<4 {
    addby(ref m, by=U8(a#[i]))
  }
  s = m
  mut n:U8 = 3
  for i in 0..<4 {
    n.bump(by=U8(b#[i]) << i)
  }
  t = n
}
