/*
:name: loop_runtime_break
:type: equiv
:verilog_top: loop_runtime_break.top
:pyrope_top: top
*/
// A `break` whose condition is only known at RUNTIME is LEGAL Pyrope: the loop
// bound is still comptime, so the hardware is the priority structure the golden
// spells out — iteration `i` contributes iff no earlier iteration's condition
// held. Same shape as `if cond { <mod call> }`, which is what the conditional
// replicated Sub (todo_loop_cond_sub.md rule 13, the per-replica `next_active`
// chain) exists to express.
//
// Rolling is forced here: the lifted body returns `next_active`, realization
// chains it between occurrences, and carried values bypass inactive lanes.

pub mod top(stop:u8) -> (total:u12@[0]) {
  mut acc:u12 = 0
  for i in 0..<8 {
    if stop#[i] { break }
    acc = acc + 1
  }
  total = acc
}
