/*
:name: initializer_scope_runtime
:type: lec
:lec_top: top
*/

// Initializer scopes preserve outer writes and runtime expression results.
pub mod top(x:U4, en:Bool) -> (a:U4@[], b:U4@[], c:U4@[], d:U4@[]) {
  a = if en { x } else { x ^ 1 }
  b = if x == 0 { 2 } elif x == 1 { 3 } else { x }
  c = if en { x ^ 2 } else { x ^ 3 }
  d = if x == 0 { 5 } else { x }
}
