/*
:name: phase_posneg_pipeline
:type: equiv
:verilog_top: phase_posneg_pipeline
:pyrope_top: phase_posneg_pipeline
*/

// Phase-order regression: `rise` commits first and `fall` consumes that new
// value later in the same source period. Conversely, `rise` sees the `fall`
// value committed in the preceding period. Rise and fall may sample different
// values of d; a formal scheduler must not collapse them into one input sample.
pub mod phase_posneg_pipeline::[timecheck=false](clk:Clock, d:U4) -> (rise_o:U4@[], fall_o:U4@[]) {
  reg rise:U4:[clock_pin=clk]
  reg fall:U4:[clock_pin=clk, posclk=false]

  wrap rise = fall + d
  fall = rise ^ d

  rise_o = rise
  fall_o = fall
}
