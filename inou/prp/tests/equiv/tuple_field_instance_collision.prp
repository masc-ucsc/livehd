/*
:name: tuple_field_instance_collision
:type: equiv
:verilog_top: tuple_field_instance_collision
:pyrope_top: tuple_field_instance_collision
*/
comb field_collision_child(a:U8) -> (rdata:U8, regOut:(value:U8)) {
  rdata = a
  regOut.value = a
}

// Field labels must not type the later instance or inherit the earlier local's range.
pub comb tuple_field_instance_collision(a:U8) -> (y:U8, z:U8, q:U8) {
  const narrow:U1 = 1
  wire io:(mtopi:U8, narrow:U8, `a.b`:U8) = nil
  const value = io.mtopi
  mut mtopi = field_collision_child::[name=mtopi](a=value)
  io.mtopi = a
  io.narrow = a
  io.`a.b` = a
  y = mtopi.rdata
  z = io.narrow ^ narrow
  q = io.`a.b`
}
