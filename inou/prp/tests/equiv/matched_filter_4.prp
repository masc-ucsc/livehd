/*
:name: matched_filter_4
:type: lec
*/
// The same matched filter with the products copied through VALUE iteration
// over the array (`for p in prods`, the tuple-iteration entry point of the
// unroller; `enumerate()` is documented but not implemented) and the node
// loop running over the FULL width with a comptime `continue` past the live
// half. Same hardware, LEC'd against the base.
comptime const N     = 8
comptime const LOG2N = 3

// `timecheck=false`: a FIR mixes delays by design — the sample register is a
// pipeline stage (cycle 1) and the coefficient register is state (cycle 0),
// and the product needs both. The cycle typechecker has no delay-line notion.
mod tap::[timecheck=false](x_in:s4, c_in:s4, load:bool) -> (x_out:s4@[0], c_out:s4@[0], p:s8@[0]) {
  reg x_r:s4 = 0
  reg c_r:s4 = 0
  x_out = x_r
  c_out = c_r
  p     = x_r * c_r
  x_r = x_in
  if load { c_r = c_in }
}

mod add_node(a:s12, b:s12) -> (s:s12@[0]) {
  reg s_r:s12 = 0
  s = s_r
  wrap s_r = a + b
}

pub mod top(x:s4, c_in:s4, load:bool) -> (y:s12@[0]) {
  mut xs:s4 = x
  mut cs:s4 = c_in
  mut prods:[N]s8 = 0
  for i in 0..<N {
    const t  = tap(x_in=xs, c_in=cs, load=load)
    xs       = t.x_out
    cs       = t.c_out
    prods[i] = t.p
  }
  mut v:[N]s12 = 0
  mut k = 0
  for p in prods {
    v[k] = p
    k += 1
  }
  // In-place pairwise reduction: level lvl folds the first N>>lvl live
  // entries into the first N>>(lvl+1).  Reads (2j, 2j+1) always sit at or
  // beyond the write index j, so program order never clobbers a live input.
  for lvl in 0..<LOG2N {
    for j in 0..<N {
      if j >= (N >> (lvl + 1)) {
        continue
      }
      v[j] = add_node(a=v[2 * j], b=v[2 * j + 1])
    }
  }
  y = v[0]
}

