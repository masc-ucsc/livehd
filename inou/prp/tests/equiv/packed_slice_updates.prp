      dep#[78..=83] = data#[78..=83] ^ (data#[84..=89] ^ (data#[90..=95] ^ data#[0..=5]))
    } elif dep#[78..=83] != 0 {
      dep#[82..=83] = (dep#[78..=83]#[4..=5] & 1) << 1
      dep#[80..=81] = (dep#[78..=83]#[2..=3] & 1) << 1
      dep#[78..=79] = (dep#[78..=83]#[0..=1] & 1) << 1
    }
    if ((wake >> 12) & 1) != 0 {
      dep#[72..=77] = data#[72..=77] ^ (data#[78..=83] ^ (data#[84..=89] ^ (data#[90..=95] ^ data#[0..=5])))
    } elif dep#[72..=77] != 0 {
