  if not (reset != 0) {
    if ((wake >> 15) & 1) != 0 {
      dep#[90..=95] = data#[90..=95] ^ data#[0..=5]
    } elif dep#[90..=95] != 0 {
      dep#[94..=95] = (dep#[90..=95]#[4..=5] & 1) << 1
