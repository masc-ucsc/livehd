// Independent packed lanes load neighbor-XOR data or age their two-bit tags.
// Generated from the golden RTL. The emitter must keep every lane-update
// accumulator in one always_comb block even with intervening tag reads.
// The independent oracle is required: native Slang can merge the illegal
// overlapping procedural drivers back into the intended packed update.
pub mod packed_slice_updates::[timecheck=false](clock:u1, reset:u1, wake:u16, data:u96) -> (q:u96@[]) {
  reg dep:u96:[initial=0, reset_pin=ref reset, async=true]
