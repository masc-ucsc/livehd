    } elif dep#[18..=23] != 0 {
      dep#[22..=23] = (dep#[18..=23]#[4..=5] & 1) << 1
      dep#[20..=21] = (dep#[18..=23]#[2..=3] & 1) << 1
      dep#[18..=19] = (dep#[18..=23]#[0..=1] & 1) << 1
    }
    if ((wake >> 2) & 1) != 0 {
      dep#[12..=17] = data#[12..=17] ^ (data#[18..=23] ^ (data#[24..=29] ^ (data#[30..=35] ^ (data#[36..=41] ^ (data#[42..=47] ^ (data#[48..=53] ^ (data#[54..=59] ^ (data#[60..=65] ^ (data#[66..=71] ^ (data#[72..=77] ^ (data#[78..=83] ^ (data#[84..=89] ^ (data#[90..=95] ^ data#[0..=5])))))))))))))
