/*
:name: ready_signal_slices
:type: equiv
:verilog_top: ready_signal_slices
:pyrope_top: ready_signal_slices
*/
pub comb ready_signal_slices(d:U4, sel:U3) -> (q:U8, signed_q:S8, picked:U1) {
  const low:U2 = d#[0..=1]
  const high:U2 = d#[2..=3]
  q = low | (low << 2) | (high << 4) | (high << 6)
  wrap signed_q = q
  picked = q#[sel]
}
