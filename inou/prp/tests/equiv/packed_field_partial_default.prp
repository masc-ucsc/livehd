/*
:name: packed_field_partial_default
:type: equiv
:set: formal.solver=lgyosys formal.lec.normalize_split_ports=true
:verilog_top: packed_field_partial_default
:pyrope_top: packed_field_partial_default
*/
// In-place RTL partial writes must retain their preceding whole-field value.
// Wide zero and nonzero defaults expose lost bases and unwanted sign fill.
pub comb packed_field_partial_default(sel:U1, x:U40, a:U2, b:U2) -> (out:(zero:U256, seeded:U256)) {
  const low = if sel != 0 { x } else { (a << 5) | (b << 3) }
  const seed = (1 << 200) | 0x123456789abcdef0
  out.zero = low
  out.seeded = if sel != 0 { (seed & ~0xffffffffff) | x } else { (seed & ~0x7f) | low }
}
