/*
:name: async_reset_concat_1
:type: equiv
:verilog_top: async_reset_concat
:pyrope_top: async_reset_concat
*/
// Same Pyrope reference as async_reset_concat.prp, paired with the NVDLA
// concatenation spelling so both Verilog forms run through the native reader.
pub mod async_reset_concat(clk:u1, clr_:u1, d:u1) -> (q:u1@[]) {
  reg q:u1:[clock_pin=ref clk, reset_pin=ref clr_, async=true, negreset=true] = 0
  reg d0:u1:[clock_pin=ref clk, reset_pin=ref clr_, async=true, negreset=true] = 0
  q = d0
  d0 = d
}
