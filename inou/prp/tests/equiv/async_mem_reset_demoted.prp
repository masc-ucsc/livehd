// Asynchronous active-low reset clears every memory entry immediately.
// Keep the independent Verilog golden's reset edge semantics: a synchronous
// clear in the clocked body would pass native cycle LEC but fail the Yosys oracle.
pub mod async_mem_reset_demoted::[timecheck=false](clk:Clock, rstn:U1, we:U1, a:U2, d:U4) -> (q:U4@[]) {
  reg mem:[4]U4:[ordering="old", reset_pin=rstn, negreset=true, async=true] = 0
  q = 0ub????
  if rstn != 0 and we != 0 {
    mem[a] = d
  }
  q = mem[a]
}
