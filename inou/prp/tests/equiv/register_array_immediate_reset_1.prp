/*
:name: register_array_immediate_reset_1
:lec_expect: proven
*/
// Desired spelling: an indexed `reg` array whose initializer is its reset
// value. Asserting `reset` (async here) clears ALL four entries in ONE cycle,
// exactly like the packed `u32` register of the base fixture; reset wins over
// an enabled write, and unselected entries hold. `all_data` reads the whole
// bank so a partially restored array cannot hide in an unread entry.
pub mod top::[timecheck=false](
  clock:u1, reset:u1, we:u1, waddr:u2, data:u8, raddr:u2
) -> (q:u8@[], all_data:u32@[]) {
  reg bank:[4]u8:[ordering="old", reset_pin=ref reset, async=true] = 0
  q = bank[raddr]
  all_data = bank#[..]
  if we != 0 { bank[waddr] = data }
}
