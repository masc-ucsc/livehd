/*
:name: generic_interface_width_1
:lec_expect: proven
*/
// Desired spelling: specialize width expressions in INPUT and OUTPUT types.
// The default and nondefault instance must keep independent widths. Every
// input/output bit matters; silently narrowing either port cannot pass.
mod lane_xor<LANES=1>(
  a:Unsigned(bits=LANES * 4), b:Unsigned(bits=LANES * 4)
) -> (y:Unsigned(bits=LANES * 4)@[0]) {
  y = a ^ b
}
// The selected top must materialize its DEFAULT port widths without a caller
// from which to infer them. Matching concrete callers alone can hide this gap.
pub mod top<LANES=3>(
  a4:U4, b4:U4, a12:Unsigned(bits=LANES * 4), b12:Unsigned(bits=LANES * 4)
) -> (y4:U4@[0], y12:Unsigned(bits=LANES * 4)@[0]) {
  mut small = lane_xor(a=a4, b=b4)
  mut large = lane_xor<LANES=LANES>(a=a12, b=b12)
  y4 = small.y
  y12 = large.y
}
