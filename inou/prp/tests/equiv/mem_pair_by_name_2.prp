/*
:name: mem_pair_by_name_2
:type: lec
:lec_top: mem_pair_by_name
:lec_expect: refuted
*/
// Declared in the other order AND with the two reads swapped: `qa` now reads
// the memory named `mb`. This is the reference with `ma` and `mb` renamed, so
// it must REFUTE under lhd lec's name correspondence (a flop name swap refutes
// the same way). Paired by occurrence order, the reference `ma` met this
// side's `mb` (both first of their shape), crossing that correspondence, and
// the pair came back PROVEN.
pub mod mem_pair_by_name(w:Bool, a:U2, d:U8, ra:U2) -> (qa:U8@[0], qb:U8@[0]) {
  reg mb:[4]U8:[ordering="old"] = nil
  reg ma:[4]U8:[ordering="old"] = nil
  if w {
    ma[a] = d
    mb[a] = d
  }
  qa = mb[ra]
  qb = ma[ra]
}
