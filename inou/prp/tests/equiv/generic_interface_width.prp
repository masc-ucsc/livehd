/*
:name: generic_interface_width
:type: equiv
:pyrope_top: top
:verilog_top: top
:lec_top: top
:lec_grep: PROVEN equivalent
*/
// Working spelling: callers supply concrete port types.
mod lane_xor<Word=U4>(a:Word, b:Word) -> (y:Word@[0]) {
  y = a ^ b
}
pub mod top(a4:U4, b4:U4, a12:U12, b12:U12) -> (y4:U4@[0], y12:U12@[0]) {
  mut small = lane_xor<Word=U4>(a=a4, b=b4)
  mut large = lane_xor<Word=U12>(a=a12, b=b12)
  y4 = small.y
  y12 = large.y
}
