/*
:name: mem_two_wr_prio
:type: equiv
:verilog_top: mem_two_wr_prio
:pyrope_top: mem_two_wr_prio
*/
// Clocked-array semantics anchor (lhdsuite array_problem.md): two guarded
// writes in one always_ff block, later write wins on a same-address collision.
// This .prp is the VERBATIM `lhd compile mem_two_wr_prio.v --emit-dir pyrope:`
// output (headers added): the front end resolves Verilog's in-process write
// ordering into two explicit write ports of one Memory cell, whose storage
// priority is last-port-wins — so `we1`'s write beats `we0`'s on a
// same-address collision, matching the golden. `ordering="old"` is what the
// Verilog reader emits (the async read sees committed state, never this
// cycle's writes). The round trip PROVES.
pub mod mem_two_wr_prio::[timecheck=false](clk:Clock, we0:U1, we1:U1, wa0:U2, wd0:U2, wa1:U2, wd1:U2, raddr:U2) -> (rdata:U2@[]) {
  reg mem:[4]U2:[ordering="old"]
  rdata = 0ub??
  if we0 != 0 {
    mem[wa0] = wd0
  }
  if we1 != 0 {
    mem[wa1] = wd1
  }
  rdata = mem[raddr]
}
