/*
:name: inline_tuple_scope
:type: equiv
:pyrope_top: inline_tuple_scope
:verilog_top: inline_tuple_scope
*/

comb inline_tuple_leaf(a:U8) -> (q:U8) {
  wire io:(x:U8, y:U8, z:U8) = nil
  io.x = a
  io.y = (io.x + 1)#[0..=7]
  io.z = io.y ^ 3
  q = io.z
}

// The Verilog-to-Pyrope leg emits the leaf into an imported sibling file.
// Its three-field `io` and both call sites must keep independent layouts
// and values despite sharing the caller's two-field variable name.
pub comb inline_tuple_scope(a:U8, b:U8) -> (q:U8) {
  wire io:(a:U8, b:U8) = nil
  io.a = a
  io.b = b
  const left = inline_tuple_leaf(io.a)
  const right = inline_tuple_leaf(io.b)
  q = left ^ right
}
