/*
:name: loop_roll_flat_3
:set: compile.upass.roll=false
:lec_expect: refuted
:lec_set: formal.lec.semdiff=structural
:lec_grep_not: MATCHED \(semdiff compact-vs-unrolled virtual-occurrence fold
*/
// Negative control: one lane is missing. Complete live-cone accounting and the
// additive term multiset must reject the count mismatch before solver fallback.
pub mod top(x:u8, y:u8) -> (z:u10@[0]) {
  mut acc:u10 = 0
  for i in 0..<3 {
    acc = acc + (if x > i { y } else { 0 })
  }
  z = acc
}
