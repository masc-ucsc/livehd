/*
:name: mem_sw_sr_data
:type: equiv
:verilog_top: mem_sw_sr_data
:pyrope_top: mem_sw_sr_data
*/
// Clocked-array semantics anchor (lhdsuite array_problem.md): sync write +
// sync read (data register) — READ-FIRST on a same-address collision (the
// registered read captures the OLD entry). This .prp is the VERBATIM
// `lhd compile mem_sw_sr_data.v --emit-dir pyrope:` output (headers added):
// reg array with ordering="none" (no write->read forwarding) + registered rdata
// reproduces read-first exactly, and the round trip PROVES.
pub mod mem_sw_sr_data::[timecheck=false](clk:u1, we:u1, waddr:u2, wdata:u2, raddr:u2) -> (rdata:u2@[]) {
  reg rdata:u2
  reg mem:[4]u2:[ordering="none"]
  if we != 0 {
    mem[waddr] = wdata
  }
  rdata = mem[raddr]
}
