/*
Negative control: the sum's five bits zero-extended, so a negative sum reads
back positive. semdiff is off so the memory encoder decides the pair.
:lec_expect: refuted
:lec_set: formal.lec.semdiff=none
*/
pub mod signed_mem_din::[timecheck=false](clk:Clock, we:U1, wa:U2, ra:U2, a:S4, b:S4) -> (q:S8@[]) {
  reg mem:[4]S8:[ordering="old"]
  if we != 0 {
    const s = a + b
    mem[wa] = s#[0..=4]
  }
  q = mem[ra]
}
