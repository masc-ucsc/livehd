// Generic middle level for ../generic_depth_default_import.prp: instantiated by
// the top with its DEFAULT generics, it specializes both leaves explicitly.
const sub_lo = import("gd_sub.sub_lo")
const sub_hi = import("gd_sub.sub_hi")

const cfg = import("gd_cfg")

pub mod mid<N=4, lane=cfg.byteLane>(a:Unsigned(bits=N*lane.width))
    -> (lo:Unsigned(bits=lane.width)@[], hi:Unsigned(bits=lane.width)@[]) {
  lo = sub_lo<N=lane.count, W=lane.width>(a=a)
  hi = sub_hi<N=lane.count, W=lane.width>(a=a)
}
