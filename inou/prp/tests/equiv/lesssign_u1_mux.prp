/*
:name: lesssign_u1_mux
:type: equiv
:verilog_top: lesssign_u1_mux
:pyrope_top: lesssign_u1_mux
*/

// Width-contract fixture: clock/reset/comparison are u1, a four-arm selector
// is u2, and the selected data remains exactly u3.
pub mod lesssign_u1_mux::[timecheck=false](clk:Clock, reset:Reset, sel:U2, d0:U3, d1:U3, d2:U3, d3:U3) -> (q:U3@[], zero:U1@[]) {
  reg state:U3:[initial=0, reset_pin=reset, clock_pin=clk]
  state = match sel {
    == 0 { d0 }
    == 1 { d1 }
    == 2 { d2 }
    else { d3 }
  }
  q = state
  zero = U1(state == 0)
}
