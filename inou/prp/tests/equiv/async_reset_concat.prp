/*
:name: async_reset_concat
:type: equiv
:verilog_top: async_reset_concat
:pyrope_top: async_reset_concat
*/
// Both stages reset asynchronously to zero when clr_ falls.
// Read d0 before updating it so q captures the previous stage value.
pub mod async_reset_concat(clk:Clock, clr_:Reset, d:U1) -> (q:U1@[]) {
  reg q:U1:[clock_pin=clk, reset_pin=clr_, async=true, negreset=true] = 0
  reg d0:U1:[clock_pin=clk, reset_pin=clr_, async=true, negreset=true] = 0
  q = d0
  d0 = d
}
