/*
:name: selfref_slice_assign
:type: equiv
:verilog_top: selfref_slice_assign
:pyrope_top: selfref_slice_assign
*/
// The Verilog golden uses three concurrent partial drivers that read sibling
// slices. This independent direct expression states their settled value:
// w[3:2]=hi, w[1]=hi[0], and w[0]=~hi[0]. Source order must not affect it.
pub comb selfref_slice_assign::[timecheck=false](hi:u2) -> (q:u4) {
  q = (hi << 2) | ((hi & 1) << 1) | ((~hi) & 1)
}
