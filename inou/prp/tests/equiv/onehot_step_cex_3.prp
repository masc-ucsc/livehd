/*
:name: onehot_step_cex_3
:lec_expect: refuted
*/
// Negative control: the same proven assume must not hide a REACHABLE
// difference (this grant drops request bit 0 when it is granted).
pub mod onehot_step_cex(clk:Clock, rst:Reset, req:U4) -> (grant:U4@[0]) {
  reg last:U4 = 1
  assume(last#+[..] == 1)
  if req != 0 {
    last = ((last << 1) | (last >> 3))#[0..<4]
  }
  grant = req & last & 0xE
}
