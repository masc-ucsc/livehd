/*
:name: latch_enable_attr_1
*/

// The latch `enable=` attribute is not a new semantic: the same latch with both
// guards spelled as one `if` must be the SAME design. LEC'd against
// latch_enable_attr.prp by prp-lec-latch_enable_attr_1.
pub mod gate(en:Bool, g:U1, d:U8) -> (q:U8@[0]) {
  reg l:U8:[latch=true]
  if g != 0 and en {
    l = d
  }
  q = l
}
