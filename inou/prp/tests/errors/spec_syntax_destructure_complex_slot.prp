/*
:name: spec_syntax_destructure_complex_slot
:type: error
:error: destructuring slot is a name
*/
// qa.md Appendix §7: "Destructuring: ... ERRORS: complex entries `(a.b, c[1]) = f()`, ..."
// (Q29 answer "1,2 legal; 3,4,5 error", item 3).
comb g() -> (p, q) { p = 1; q = 2 }
mut a = (mut b = 0)
mut c:[2]U8 = 0
(a.b, c[1]) = g()   // locate_error_here
