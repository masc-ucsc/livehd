// qa.md Appendix §7: "Destructuring: ... ERRORS: ... targets rooted at a call/expression
// (`f(x).a = 3`, `(a+b).c = 3`)." (Q29 option "1,2 legal; 3,4,5 error", item 5).
comb f(x) -> (a) { a = x }
mut x = 0
f(x).a = 3   // locate_error_here
