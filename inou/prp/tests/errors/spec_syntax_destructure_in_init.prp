/*
:name: spec_syntax_destructure_in_init
:type: error
:error: destructuring assignment
*/
// qa.md Appendix §7: "ERRORS: ... destructuring inside an expression or init clause
// (`const q = ((a, b) = g())`, `if (a, b) = f(); a {}`)" (Q29, item 4).
comb g() -> (a, b) { a = true; b = 2 }
mut a = false
mut b = 0
if (a, b) = g(); a { }   // locate_error_here
