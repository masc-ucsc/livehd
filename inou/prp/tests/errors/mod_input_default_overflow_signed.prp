/*
:name: mod_input_default_overflow_signed
:type: error
:error: the default of input `b` of `m` \(value -20\) does not fit its declared range \[-8, 7\]
:help: change the default, or widen the input's type
*/

// Signed twin of mod_input_default_overflow.prp: `b:S4 = -20` was wired as
// `.b(4'shc)` (-4) at a call that omits `b`.

mod m(a:S8, b:S4 = -20) -> (o:S8@[0]) {
  wrap o = a + b
}

pub mod mod_input_default_overflow_signed(a:S8) -> (o:S8@[0]) {
  const k = m(a=a)   // locate_error_here
  o = k.o
}
