/*
:name: spec_syntax_tick_step_dot_field
:type: error
:error: 'step' is reserved, so it cannot be a name
:help: backticks
*/
// Owner ruling 99 (spec-audit Q42): `tick`/`step` are reserved everywhere,
// also as a field after `.`: write x.`step`.
mut x = (mut `step` = 0)
x.step = 1   // locate_error_here
