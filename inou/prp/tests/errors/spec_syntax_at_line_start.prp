/*
:name: spec_syntax_at_line_start
:type: error
:error: a line cannot start with '@'
*/
// qa.md Q39 item 6 / Appendix §8: "a line starting with `@` (also inside an if condition)
// -> error" (`if x1\n@[1] == 1 {}`; docs 02-basics.md "a line starting with `@` is an error").
mod spec_syntax_at_line_start(x1:U8) -> (o:U8@[1]) {
  stage[1] d = x1
  if d
  @[1] == 1 { o = 1 } else { o = 0 }   // locate_error_here
}
