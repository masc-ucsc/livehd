/*
:name: comb_arg_wide_shift
:type: error
:tolg: 1
:error: argument .a. \(unbounded range\) in call to .low4. may not fit its declared range \[0, 15\]
:help: an argument never narrows implicitly
*/
// User ruling 2026-09-27 (argument width) for an actual too WIDE for any
// derived range: `x << n` with n:U8 may not fit `a:U4`. It used to bind
// silently, and the inlined comb returned the whole shifted value while its
// own module (`low4`) has a 4-bit port.
comb low4(a:U4) -> (o:U4) {
  o = a
}

pub mod comb_arg_wide_shift(x:U4, n:U8) -> (y:U64@[0]) {
  y = low4(a=x << n)   // locate_error_here
}
