/*
:name: stage_needs_value
:type: error
:tolg: 1
:error: declared but never stored
*/

// A `stage[N] t` declaration with no initializer is legal (qa.md Q39 item 7: the value
// arrives from a later assignment), but a stage that is never stored would silently drop
// its delay, so it is an error.
mod f(a:U8) -> (x:U8@[0]) {
  stage[2] t   // locate_error_here
  x = a
}
