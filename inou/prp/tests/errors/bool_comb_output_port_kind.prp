/*
:name: bool_comb_output_port_kind
:type: error
:tolg: 1
:error: cannot assign (boolean|integer) value to .(q|r). \(it is (integer|boolean)\)
*/

// User ruling 2026-09-27 (2): the `comb` twin of bool_output_port_kind.prp. A
// comb OUTPUT is a typed destination like a typed local: a `Bool` into a `U1`
// output needs `U1(x)`, and an integer bit into a `Bool` output needs
// `Bool(x)` (or `x != 0`). Today the store check cannot see the output's
// declared kind, so both lines compile silently.
//
// Legal spelling: `q = U1(w)` and `r = Bool(v#[0])`.

pub comb bool_comb_output_port_kind(v:U4) -> (q:U1, r:Bool) {
  const w:Bool = v != 0
  q = w        // locate_error_here
  r = v#[0]    // locate_error_here
}
