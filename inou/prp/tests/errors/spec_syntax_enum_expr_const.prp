/*
:name: spec_syntax_enum_expr_const
:type: error
:error: expression form `enum\(...\)`
*/
// qa.md Appendix §7: "the expression form `enum(...)` (`const Color = enum(...)`,
// `type V = enum(...)`) is an ERROR -- rewrite those doc examples as declarations."
// (Q30 "Declaration only").
const Color = enum(red, green)   // locate_error_here
cassert(Color.red != Color.green)
