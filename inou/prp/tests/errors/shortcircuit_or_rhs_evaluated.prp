/*
:name: shortcircuit_or_rhs_evaluated
:type: error
:error: modulo by zero
:help: guard the divisor
*/

// 2c-shortcircuit, the NEGATIVE side. `or` only skips its right operand when
// the LEFT one is already TRUE (02-basics.md, "Evaluation order"). Here the
// left operand is comptime FALSE, so the right operand IS evaluated and the
// illegal `% 0` must still be reported. The twin positive case (`N == 0 or …`,
// which must compile clean) is ../equiv/short_circuit.prp.

const N = 0
pub mod top(a:u8) -> (y:u8@[0]) {
  cassert(N != 0 or (64 % N == 0)) // locate_error_here
  y = a
}
