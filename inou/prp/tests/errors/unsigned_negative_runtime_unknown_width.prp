/*
:name: unsigned_negative_runtime_unknown_width
:type: error
:error: reinterpret needs a fully-typed input
:help: give the operand a sized type
*/

// Same rule on a RUNTIME value: `n` is inferred from an s4 and then widened by
// the subtraction, so it can be negative and has no declared bit width.
// (A non-negative operand needs no width -- `Unsigned()` is then the identity.)
comb neg_runtime(a:S4) -> (y:U8) {
  mut n = a
  n = n - 1
  y = Unsigned(n)  // locate_error_here
}
