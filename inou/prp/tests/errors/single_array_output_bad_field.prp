/*
:name: single_array_output_bad_field
:type: error
:tolg: 1
:error: unknown field `w` on instance `x`
:help: the instance's fields are its outputs: v
*/

// `x[3]` reads a lane of a child's single ARRAY output (sim/array_output_port_index.prp),
// but `x.w` names an output the child does not have. It used to be read as an
// array index ("Pyrope array index w is outside [0, 4)"), then failed only in
// lnast.tolg ("instance result has no output named 'w'"); ruling 24 makes it
// an error at the read (upass.constprop).
mod rows(a:U4) -> (v:[4]U4@[0]) {
  v = 0
  v[3] = a
}
pub mod single_array_output_bad_field(a:U4) -> (r:U4@[0]) {
  const x = rows(a=a)
  r = x.w   // locate_error_here
}
