/*
:name: loop_break_result_overflow
:type: error
:error: may not fit its declared range
*/
// A ROLLED loop with a `break` leaves with ANY iteration's value: `acc` ends
// in [20, 200], so narrowing it into a U5 needs `wrap`, exactly as its
// loop-free twin (loop_break_result_overflow_ref.prp) does. The roller used to
// publish only the LAST iteration's carry-out ([20, 20]), so this narrowing
// compiled silently and truncated.
pub comb loop_break_result_overflow(x:U4) -> (o:U5) {
  mut acc:U8 = 0
  mut seen:U1 = 0
  for i in 0..<4 {
    seen = seen | U1(acc == 15)
    acc = 200 - i * 60
    if x#[i] == 1 { break }
  }
  o = acc  // locate_error_here
}
