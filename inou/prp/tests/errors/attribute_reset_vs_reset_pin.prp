/*
:name: attribute_reset_vs_reset_pin
:type: error
:error: there is no .reset. attribute: a reset is declared by its type
:help: reset_pin=
*/

// There is no `reset` (or `clock`) attribute: since ruling 52 a reset is
// declared by its TYPE (`rst:Reset`), not by a `rst::[reset]` classification.
// With `=value` the user almost surely meant the per-register pin override
// `reset_pin=<wire>`.

mut rst = false
reg r:U8:[reset=ref rst] = 0  // locate_error_here
