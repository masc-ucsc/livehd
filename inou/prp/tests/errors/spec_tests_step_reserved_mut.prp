/*
:name: spec_tests_step_reserved_mut
:type: error
:error: step
*/
// Spec: docs 05b "Running cycles (tick)": "`tick` and `step` are reserved
// words. Like the other reserved words, they cannot be bound as a name (a
// declaration, a parameter, or a loop variable), so `const tick = 1` and
// `mut step = 1` are errors".
//
// Rule pinned: declaring a variable named `step` is an error.

pub comb spec_srm(a:U8) -> (y:U8) {
  mut step = 1           // locate_error_here
  y = a
}
