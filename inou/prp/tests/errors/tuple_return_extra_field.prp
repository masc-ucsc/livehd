/*
:name: tuple_return_extra_field
:type: error
:error: names unknown field .extra.
*/

// The call returns every field of Control plus `extra`. A whole-tuple
// assignment must reject that extra field, not silently discard it.
// Use `mut` so wire driver counting cannot mask the shape mismatch.
type Control = (op:u2, valid:u1)

comb unpack_control(bits:u4) -> (op:u2, valid:u1, extra:u1) {
  op = bits#[0..=1]
  valid = bits#[2]
  extra = bits#[3]
}

pub comb tuple_return_extra_field(bits:u4) -> (result:u2) {
  mut control:Control = nil
  control = unpack_control(bits=bits)
  result = control.op
}
