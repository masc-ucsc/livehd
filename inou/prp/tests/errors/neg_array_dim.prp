/*
:name: neg_array_dim
:type: error
:error: outside the index range
:help: declared index range
*/
// An array declared over a negative index range takes signed indices
// (08-memories.md "Array index": `mut x3:[-8..<7]U3 = nil`), so `a[-4]` is
// its first entry -- but an index below the range is still out of bounds.
mut a:[-4..<4]S5 = nil
a[-4] = 3
a[-5] = 3   // locate_error_here
