/*
:name: clkrst_clock_output_const
:type: error
:tolg: 1
:error: `Clock` output `o` is driven by a constant: a Clock is never a constant
*/
// docs 07-typesystem: a Clock is never bound to a constant -- a `Clock`
// output included (an instance's register clocked through it would never
// tick in the emitted Verilog).
mod kc() -> (o:Clock@[0]) {
  o = true
}
pub mod clkrst_clock_output_const(d:U8) -> (q:U8@[1]) {
  const k = kc()
  reg r:U8:[clock_pin=k.o] = 0
  q = r
  r = d
}
