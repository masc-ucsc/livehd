/*
:name: reduce_string
:type: error
:error: strings are opaque and have no bit vector
:help: numeric value or an ordered packed aggregate
*/
// A bit reduction needs an integer/boolean operand. A string has no bits to
// reduce, so `s#|[...]` is a compile error.
comb foo() -> (z:u1) {
  const s = "hello"
  z = s#|[0..=2]   // locate_error_here
}
