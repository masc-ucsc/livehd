/*
:name: spec_syntax_enum_expr_type
:type: error
:error: expression form `enum\(...\)`
*/
// qa.md Appendix §7: "the expression form `enum(...)` (`const Color = enum(...)`,
// `type V = enum(...)`) is an ERROR" -- the type-alias spelling is rejected too.
type V = enum(a, b)   // locate_error_here
cassert(V.a != V.b)
