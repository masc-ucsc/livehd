/*
:name: spec_clock_mem_const_clock
:type: error
:tolg: 1
:error: (clocked by a constant|never (bound to )?a constant|constant)
*/
// SPEC (clock lane): a memory port whose clock is a constant is a compile
// error in every front end (same rule as registers).
//   ruling 42 (2026-09-29): "A MEMORY read/write port whose clock is constant
//     or unconnected is a compile error in EVERY front end (same rule as
//     registers, 27/41), naming the memory and port."
//   qa.md Appendix 6: "A Clock can never be bound to a constant"
//   docs 04b: "reg counter6::[clock_pin=true]=0       // error: a Clock is never a constant"
pub mod spec_clock_mem_const_clock(clk:Clock, we:Bool, wa:U2, wd:U8, ra:U2) -> (q:U8@[0]) {
  reg m:[4]U8:[clock_pin=true] = nil   // locate_error_here
  if we { m[wa] = wd }
  q = m[ra]
}
