/*
:name: reg_clock_from_logic
:type: error
:tolg: 1
:error: `clk` is a `Clock`, and a Clock is not data \(operator `\^`\)
*/
// A flop clocked by a data-merging op. `wire gclk = clk ^ inv; always
// @(posedge gclk)` is the programmable-polarity clock idiom (Xilinx RAM128X1D
// uses exactly it). Ruling 81 (qa Q26): derived, inverted and muxed clocks are
// not supported -- the only derived clock is the gate `Clock(clock_pin=clk,
// enable=en)` -- so in Pyrope, where `clk` is a `Clock`, the XOR is a
// clock-as-data error.
pub mod reg_clock_from_logic::[timecheck=false](clk:Clock, inv:Bool, d:U1) -> (q:U1@[]) {
  reg q:U1:[clock_pin=gclk] = 0
  wire gclk:Bool = nil
  gclk = clk ^ inv   // locate_error_here
  q = d
}
