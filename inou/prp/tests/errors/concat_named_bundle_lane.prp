/*
:name: concat_named_bundle_lane
:type: error
:error: named bundle with multiple fields, which has no bit order
:help: select the fields explicitly in the order you want
*/

// Named-bundle equality is by key, independent of spelling order. Packing the
// whole bundle would therefore expose the compiler's canonical alphabetical
// key order as a surprising bit layout. Select the fields explicitly instead:
// `(x.lo, x.hi)#[..]` or `(x.hi, x.lo)#[..]`.
comb concat_named_bundle_lane() -> (z:U12) {
  const x = (const hi:U4=3, const lo:U8=2)
  z = x#[..]
}
