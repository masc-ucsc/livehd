/*
:name: style_single_destination_conditional
:type: style
:style: single-destination-conditional
:help: branch order
*/
// An exhaustive if/elif/else whose branches each only assign the same name is an
// `if` expression.
comb f(sel:U1, a:U8, b:U8) -> (o:U8) {
  if sel {  // locate_style_single-destination-conditional
    o = a
  } else {
    o = b
  }
}
