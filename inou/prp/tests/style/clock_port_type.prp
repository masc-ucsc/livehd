/*
:name: style_clock_port_type
:type: style
:style: clock-port-type
:message: named like a clock
:help: Clock
*/
// `clock` is a plain U1 and never read: the registers bind the implicit clock,
// not this port. Clocks bind by type, not by name, so declare it `Clock`.
pub mod m(clock:U1, rst:Reset, din:U8) -> (dout:U8@[]) {  // locate_style_clock-port-type
  reg q:U8 = 0
  dout = q
  q = din
}
