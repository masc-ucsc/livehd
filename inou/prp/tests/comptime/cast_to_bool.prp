/*
:name: cast_to_bool
:type: comptime
:verifier_pass: 5
:verifier_fail: 0
*/

// `Bool(x)` on an integer is `x != 0` (NOT restricted to 0/1 —
// 04-variables.md `Bool(33)` is true); a bool operand is identity. An
// undefined/nil operand is a compile error (see errors/cast_bool_undefined).
cassert(Bool(33)   == true)
cassert(Bool(0)    == false)
cassert(Bool(-1)   == true)
cassert(Bool(1) == true)
cassert(Bool(true) == true)
