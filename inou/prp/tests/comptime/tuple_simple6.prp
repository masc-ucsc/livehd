/*
:name: tuple_simple6
:type: parsing lnast comptime
:verifier_pass: 6
:verifier_fail: 0
*/

// A tuple is all-named or all-unnamed (03-bundle.md).
mut x = (const a:U32 = 3, const b = 4)

cassert(x == (a=3,b=4))
cassert(x == (b=4,a=3))
cassert(x == (...(a=3), ...(b=4)))
cassert(x != (a=3,foo=4))

mut y = (mut 5, 6)
y[0] += 5
cassert(y == (10,6))
cassert(y[1] == 6)
