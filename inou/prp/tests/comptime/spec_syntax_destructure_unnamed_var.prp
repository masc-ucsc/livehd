/*
:name: spec_syntax_destructure_unnamed_var
:type: comptime
:verifier_pass: 2
:verifier_fail: 0
*/
// qa.md Appendix §8: "destructuring a NAMED tuple binds each bare slot by name match ... ;
// destructuring an UNNAMED tuple binds by position". Named-vs-unnamed is a property of the
// right-hand side VALUE, not of its spelling: an unnamed tuple held in a variable still has
// no names to match, so its slots bind by position like the literal `(1, 2)` does.
const t = (1, 2)
const (a, b) = t

cassert(a == 1)
cassert(b == 2)
