/*
:name: spec_syntax_destructure_rename
:type: comptime
:verifier_pass: 2
:verifier_fail: 0
*/
// qa.md Appendix §7: "Destructuring: legal = ... rename slots `(x=dox.b, y=dox.c) = dox(a=3)`,
// `(v=deep.payload.inner.value) = deep(a=3)`" (Q29 item 1).
comb dox(a) -> (b, c) { b = a + 1; c = a + 2 }
comb deep(a) -> (payload, code) { payload = (const inner = (const value = a + 1)); code = a + 10 }

mut x = 0
mut y = 0
(x=dox.b, y=dox.c) = dox(a=3)
mut v = 0
(v=deep.payload.inner.value) = deep(a=3)

cassert(x == 4 and y == 5)
cassert(v == 4)
