/*
:name: typesys_range
:type: comptime
:verifier_pass: 15
:verifier_fail: 0
*/

// Corner cases for entry 1v (LNAST basic typesystem + min/max upass).
// Declared-type-only policy: `.[max]`/`.[min]` derive from the declared type
// and un-annotated values return nil. `.[bits]` also derives from the declared
// type, except that an untyped COMPTIME integer is as wide as its value (user
// ruling 2026-09-27, docs 04b "Integer Bitwidth").

// Untyped comptime: no envelope, but 3 needs 2 bits.
const a = 3
cassert(a.[max] == nil)
cassert(a.[min] == nil)
cassert(a.[bits] == 2)

// Inferred range from a small mut updated by constant adds.
mut b:U10 = 1
b = b + 1
b = b + 1
cassert(b == 3)
cassert(b.[max] >= 3)

// Bounded type: declared max/min envelope derives bits.
// (`:[range=…]`/`Signed(range=…)` are compile errors — see errors/readonly_attr_range.)
const c:Signed(max=15, min=0) = 5
cassert(c.[bits] == 4)
cassert(c.[max] == 15)
cassert(c.[min] == 0)

// Bool: bits=1, max=1, min=0.
const t:Bool = true
cassert(t.[bits] == 1)
cassert(t.[max] == 1)
cassert(t.[min] == 0)

// String: size works.
const s = "abc"
cassert(s.[size] == 3)
cassert(s.[bits] == nil)

// Arithmetic narrows the *effective* range to the declared type's bound,
// not to the runtime expression's value.
mut d:Signed(max = 15) = 1
d = d + 14
cassert(d == 15)
cassert(d.[max] == 15)
