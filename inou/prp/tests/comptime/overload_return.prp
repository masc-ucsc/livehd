/*
:name: overload_return
:type: comptime
:verifier_pass: 2
:verifier_fail: 0
*/

// 2f-overload — dispatch honors the RETURN side. Among candidates that accept
// the call on their inputs, the one whose OUTPUTS bind to how the result is
// consumed is selected (06-functions.md §"Binding return values") — so "can
// handle" is the whole `c = f(args)`, not just the call. A destructure can skip an input-matching candidate whose outputs do not bind.
// A whole-result binding accepts multiple outputs as a named tuple.

comb mk_one(a:signed) -> (r:signed)          { r = a }
comb mk_two(a:signed) -> (p1:signed, p2:signed) { p1 = a ; p2 = a + 1 }

const mk  = [mk_one, mk_two]   // single-output first
const rev = [mk_two, mk_one]   // multi-output first

const (p1, p2) = mk(a=5)
cassert(p1 == 5 and p2 == 6)   // destructure (fields p1,p2) → mk_two; mk_one's lone `r` cannot bind

const v = rev(a=9)
cassert(v.p1 == 9 and v.p2 == 10) // whole bind accepts the first candidate, mk_two
