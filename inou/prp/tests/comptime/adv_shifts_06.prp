/*
:name: adv_shifts_06
:type: comptime
:verifier_pass: 10
:verifier_fail: 0
*/

// Shift-by-tuple builds a one-hot set of bits (1 << each element OR'd together)
// (merged with the former adv_bitwise_18 and adv_int_prec_16: the doc one-hot
// example `1 << (1,4,3) == 0ub01_1010` of 04-variables.md and the extra tuple shapes)
const a = 1 << (0,)            // single-element tuple, bit 0 set
cassert(a == 1)
const b = 1 << (0, 1, 2, 3)    // bits 0..3 -> 0b1111 == 15
cassert(b == 15)
const c = 1 << (4,)            // bit 4
cassert(c == 16)
const d = 1 << (1, 4, 3)       // bits 1,3,4 -> 0ub01_1010 == 26
cassert(d == 0ub01_1010)
cassert(d == 26)

// more tuple shapes (was adv_bitwise_18)
cassert((1 << (0,1,2)) == 0ub111)
cassert((1 << (3,)) == 8)
cassert((1 << (1,2)) == 0ub110)

// '<<' (prio 3) binds tighter than '==' (prio 4), and tuple shifts OR with plain
// shifts (was adv_int_prec_16)
const b2 = (1 << 3) | (1 << 0)
cassert(b2 == 9)
const c2 = 1 << (0, 7)
cassert(c2 == 0ub1000_0001)
