/*
:name: mut_cycle_rebind
:type: comptime
:verifier_pass: 1
:verifier_fail: 0
*/

// Task 1r/1q — `@[NAME]` timing slots resolve file-scope comptime integers:
// `f` lands at cycle 2 and `g` at cycle 3. (This test used to exercise the
// declaration-time capture of ONE file-scope `mut` re-assigned between the two
// lambdas; ruling 2026-09-27 #4 removed it -- a lambda sees only the COMPTIME
// bindings of its enclosing scopes -- so each slot reads its own comptime
// const.) The cassert keeps the verifier honest about a discharged check.
comptime const delay_f = 2
mod f(a:U8) -> (x:U8@[delay_f]) { stage[2] x = a }
comptime const delay_g = 3
mod g(a:U8) -> (x:U8@[delay_g]) { stage[3] x = a }

cassert(delay_g == 3)
