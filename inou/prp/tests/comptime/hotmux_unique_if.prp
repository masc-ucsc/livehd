/*
:name: hotmux_unique_if
:type: comptime
:verifier_pass: 10
:verifier_fail: 0
*/

// Corner cases beyond formux.prp:
//   - `unique if` with no `elif` (single guarded arm), default fall-through
//   - `unique if` with three arms and an `else` (explicit default)
//   - __hotmux with a single active control per call (covers each slot), plus
//     the all-controls-zero case with and without a trailing default pin
//   - __mux (not __hotmux) compared against unique-if to confirm both fold

// Single-arm unique if (no elif). When cond is false, res keeps init.
comb code_single(cond:bool, a:u32, b:u32) -> (res:u32) {
  mut res = a
  unique if cond {
    res = b
  }
}

cassert(code_single(cond=true, a=100, b=200) == 200)
cassert(code_single(cond=false, a=100, b=200) == 100)

// Three-arm unique if with default else (mutually exclusive guaranteed).
comb code_three(c0:bool, c1:bool, c2:bool, a:u8, b:u8, c:u8, d:u8) -> (res:u8) {
  mut res = d
  unique if c0 {
    res = a
  } elif c1 {
    res = b
  } elif c2 {
    res = c
  }
}

cassert(code_three(c0=true, c1=false, c2=false, a=1, b=2, c=3, d=9) == 1)
cassert(code_three(c0=false, c1=true, c2=false, a=1, b=2, c=3, d=9) == 2)
cassert(code_three(c0=false, c1=false, c2=true, a=1, b=2, c=3, d=9) == 3)
cassert(code_three(c0=false, c1=false, c2=false, a=1, b=2, c=3, d=9) == 9)

// Direct __hotmux walk: interleaved (control, value) pairs sweep each slot.
cassert(__hotmux(p0=1, p1=10, p2=0, p3=20, p4=0, p5=30) == 10)
cassert(__hotmux(p0=0, p1=10, p2=0, p3=20, p4=1, p5=30) == 30)
// Every control zero: the trailing default pin, or 0 when there is none.
cassert(__hotmux(p0=0, p1=10, p2=0, p3=20, p4=99) == 99)
cassert(__hotmux(p0=0, p1=10, p2=0, p3=20) == 0)
