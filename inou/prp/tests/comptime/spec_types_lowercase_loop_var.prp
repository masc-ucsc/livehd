/*
:name: spec_types_lowercase_loop_var
:type: comptime
:verifier_pass: 1
:verifier_fail: 0
*/

// Former lowercase type spellings are ordinary identifiers (07-typesystem.md).
pub comb spec_types_lowercase_loop_var(a:U8) -> (o:U8) {
  mut acc:U8 = 0
  for u4 in 0..<3 {
    wrap acc = acc + a
  }
  o = acc
}

cassert(spec_types_lowercase_loop_var(a=2) == 6)
