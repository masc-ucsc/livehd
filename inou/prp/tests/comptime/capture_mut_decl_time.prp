/*
:name: capture_mut_decl_time
:type: comptime
:verifier_pass: 2
:verifier_fail: 0
*/

// A lambda sees only the COMPTIME bindings of its enclosing scopes (ruling
// 2026-09-27 #4), so a free file-scope `mut` is no longer captured at the
// lambda declaration point: it is passed as an input, and each call sees the
// value the `mut` holds AT THE CALL (2, then 10 after the re-assignment).
mut mut_var = 2
comb add_mut(a:U8, m:U8)->(x:U9) { x = a + m }
cassert(add_mut(a=20, m=mut_var) == 22)
mut_var = 10
cassert(add_mut(a=30, m=mut_var) == 40)
