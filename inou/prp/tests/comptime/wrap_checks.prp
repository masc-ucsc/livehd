/*
:name: wrap_checks
:type: parsing lnast comptime
:verifier_pass: 27
:verifier_fail: 0
*/

// ---- wrap_checks ----
{
mut x:U8 = 255
cassert(x==255)
wrap x = 0xCAFE
cassert(x == 0xFE)

mut y:S4 = -1
cassert(y==-1)
wrap y = 0xCAFE  // 0sb0..._1111_1110
cassert(y == 0sb1110 == -2)
}

// ---- wrap_trivial ----
{
mut x:U12 = 0

wrap x = 0xFEAD

cassert(x == 0xEAD)
}

// ---- wrap_complex ----
{
mut x:S8 = 0
mut z:U8 = 0

wrap x =0sb1001_0111_1111
cassert(x == 0sb0111_1111)
wrap z =0sb1001_0111_1111
cassert(z == 0sb0111_1111)

wrap x =0sb1001_1101_0011
cassert(x == 0sb1101_0011)
wrap z =0sb1001_1101_0011
cassert(z == 0ub1101_0011)
cassert(z ==0sb01101_0011)

sat x =0sb1001_1101_0011
cassert(x == 0sb1000_0000)
sat z =0sb1001_1101_0011
cassert(z == 0)

sat x =0sb0001_1101_0011
cassert(x == 0sb0111_1111)
sat z =0sb0001_1101_0011
cassert(z == 0ub1111_1111)
cassert(z ==0sb01111_1111)
}

// ---- phase5_wrap_sticky ----
{
// Task 1t — `wrap` / `sat` are per-statement prefix modifiers: each one
// narrows a single assignment to the lhs's declared type. They lower to a
// `wrap|sat(v=…, type=<lhs>)` library call (no sticky `:[wrap]` attribute and
// no `.[wrap]` / `.[saturate]` read form).

mut w:U4 = 0
wrap w = 0xFF
cassert(w == 0xF)
wrap w = 0x10
cassert(w == 0)

mut x:U4 = 0
wrap x = 0xFF                // per-statement wrap
cassert(x == 0xF)

sat x = 0xFF                 // per-statement saturate
cassert(x == 0xF)            // 0xF is U4 max

mut y:S4 = 0
sat y = 100
cassert(y == 7)              // S4 max

sat y = -100
cassert(y == -8)             // S4 min
}

// ---- adv_wrap_sat_06 ----
{
// `sat` clamps to the declared max/min (07-typesystem.md / 04b-attributes.md:
// "saturate clamps to the declared max/min"). For power-of-two-width types
// (uN/sN) the implementation clamps to the declared bounds exactly. (Custom
// `Signed(min,max)` ranges do NOT yet clamp under sat in the lowering — the
// 'int' type that once expressed those custom ranges is removed — so this test
// exercises the power-of-two bounds where sat is correct.) Every cassert below
// is the documented, correct clamped result.
mut a:U4 = 0
sat a = 50
cassert(a == 15)           // clamp to declared max=15 (U4)

mut b:U4 = 0
sat b = -3
cassert(b == 0)            // clamp to declared min=0 (U4)

mut c:S4 = 0
sat c = 100
cassert(c == 7)            // clamp to declared max=7 (S4)

mut d:S4 = 0
sat d = -99
cassert(d == -8)           // clamp to declared min=-8 (S4)

mut e:U8 = 0
sat e = 300
cassert(e == 255)          // clamp to declared max=255 (U8)

mut f:S8 = 0
sat f = -200
cassert(f == -128)         // clamp to declared min=-128 (S8)
}
