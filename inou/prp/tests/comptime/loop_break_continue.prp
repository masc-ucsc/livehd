/*
:name: loop_break_continue
:type: comptime
:verifier_pass: 18
:verifier_fail: 0
*/

// ---- loop_break_continue ----
{
// break / continue / non-termination in comptime loops (2f-loop_unroll).
// `while true`/`loop` lower to a recomputed `1==1` ref so the body folds each
// iteration and the break-guard resolves; continue skips the rest of the
// current iteration; the non-termination check tracks body progress vars.

// break in `while true`
mut a = 0
while true { a += 1; if a >= 5 { break } }
cassert(a == 5)

// break in `loop {}` (accumulates a factorial)
mut f = 1
mut k = 0
loop { k += 1; f = f * k; if k >= 5 { break } }
cassert(f == 120 and k == 5)

// continue in a `for`
mut s = 0
for i in 0..<5 { if i == 2 { continue }; s = s + i }
cassert(s == 8)             // 0+1+3+4

// continue in a `while`
mut sum2 = 0
mut j = 0
while j < 5 { j += 1; if j == 3 { continue }; sum2 = sum2 + j }
cassert(sum2 == 1 + 2 + 4 + 5)

// late-flipping exit flag must NOT trip the non-termination check
mut done = false
mut n = 0
while not done { n += 1; if n == 8 { done = true } }
cassert(n == 8)
cassert(done)
}

// ---- adv_loop_break_continue ----
{
// Two loop-unroll defects (same upass-runner mechanism):
// 1. `continue` inside a comptime-unrolled `for` is a no-op (skipped iteration still runs).
mut s = 0
for i in 0..<5 {
  if i == 2 { continue }
  s = s + i
}
cassert(s == 8)              // 0+1+3+4 (i==2 skipped)

// 2. a break-only-exit loop (`while true`/`loop`) must iterate until the break,
//    not run the body once.
mut a = 0
while true {
  a += 1
  if a >= 5 { break }
}
cassert(a == 5)
}

// ---- adv_loops_while_02 ----
{
// `loop { ... break }` is `while true` with an explicit break. do-while shape:
// the body runs at least once before the exit condition is checked.
mut a = 0
mut prod = 1
loop {
  a += 1
  prod = prod * a
  if a >= 5 { break }
}
cassert(prod == 120)  // 5! = 120
cassert(a == 5)
}

// ---- adv_loops_while_13 ----
{
// Boolean-state while: terminate when a bool flag flips. bool/int never mix.
mut done = false
mut n = 0
while not done {
  n += 1
  if n == 8 {
    done = true
  }
}
cassert(n == 8)
cassert(done)

// Build a result from the loop, asserted at top level.
mut bits = 0
mut p = 0
while p < 4 {
  bits = bits | (1 << p)
  p += 1
}
cassert(bits == 0ub1111)
}

// ---- adv_loops_for_02 ----
{
// A pair binding `for (index, value) in t` IS the enumerate: index first
// (position), value second (05b-statements.md). The body runs once per element,
// so the index-sum is 0+1+2+3 = 6 and the value-sum is 10+20+30+40 = 100.
mut bund = (10, 20, 30, 40)

mut idx_sum = 0
for (index, i) in bund {
  idx_sum = idx_sum + index
}
cassert(idx_sum == 6)

mut val_sum = 0
for (index, i) in bund {
  val_sum = val_sum + i
}
cassert(val_sum == 100)
}

// ---- adv_mix_loop_accum_11 ----
{
// A pair binding `for (index, value) in t` enumerates (index first, value
// second) — 05b-statements.md. The body accumulates over each element.
const bund = (1,2,3,4)
mut sum_via_index = 0
for (index, v) in bund {
  sum_via_index = sum_via_index + bund[index]
}
cassert(sum_via_index == 10)

mut sum_via_val = 0
for (index, v) in bund {
  sum_via_val = sum_via_val + v
}
cassert(sum_via_val == 10)

mut idx_acc = 0
for (index, v) in bund {
  idx_acc = idx_acc + index
}
cassert(idx_acc == 6)
}
