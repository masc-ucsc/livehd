/*
:name: fcall3
:type: comptime
:verifier_pass: 1
:verifier_fail: 0
*/
// A lambda sees only COMPTIME bindings of its enclosing scopes (ruling
// 2026-09-27 #4): `b` must be a `comptime const` to be read in the body.
comptime const b = 3
comb fcall3(a:U3) -> (res:S4) {
  wrap res = a + b
}
cassert(fcall3(a=1) == 4)
