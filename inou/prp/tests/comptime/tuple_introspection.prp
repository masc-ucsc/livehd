/*
:name: tuple_introspection
:type: comptime
:verifier_pass: 12
:verifier_fail: 0
*/
const a = (const b=1, const c:U32=2)
cassert(a.[size] == 0)
cassert(a.[fields] == ('b', 'c'))
cassert(a.[id] == 'a')
cassert(a.b.[id] == 'b')
cassert(a['c'].[id] == 'c')
const unnamed = (7, 9)
cassert(unnamed.[size] == 2)
cassert(unnamed.[fields] == ())
const named = (const z=3, const a=1)
cassert(named.[size] == 0)
cassert(named.[fields] == ('a', 'z'))
const empty = ()
cassert(empty.[size] == 0)
cassert(empty.[fields] == ())
cassert((0..<10000 step 3).[size] == 3334)
