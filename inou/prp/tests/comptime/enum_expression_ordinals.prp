/*
:name: enum_expression_ordinals
:type: parsing lnast comptime
:verifier_pass: 13
:verifier_fail: 0
*/
const c = 1
enum test1 = (a=c, b, c, d=10+c, e)
cassert(test1.a == 1)
cassert(test1.b == 2)
cassert(test1.c == 3)
cassert(test1.d == 11)
cassert(test1.e == 12)
cassert(c == 1)
cassert(String(c) == "1")
const negative = -3
enum Sgn:Signed = (a=negative, b, c, d)
cassert(Sgn.a == -3)
cassert(Sgn.b == -2)
cassert(Sgn.c == -1)
cassert(Sgn.d == 0)
enum hex = (a=0xf, b)
cassert(hex.a == 15)
cassert(hex.b == 16)
