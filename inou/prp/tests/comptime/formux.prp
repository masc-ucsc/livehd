/*
:name: formux
:type: comptime
:verifier_pass: 4
:verifier_fail: 0
*/

comb code1(cond1:bool, cond2:bool, a:u32, b:u32, c:u32) -> (res:u32) {
  mut res = a
  unique if cond1 {
    res = b
  } elif cond2 {
    res = c
  } // no res in else
}

comb code2(cond1:bool, cond2:bool, a:u32, c:u32, b:u32) -> (res:u32) {
  // RTL equivalent — one (control, value) pair per arm
  const s0 = cond2 and !cond1
  const s1 = cond1
  const s2 = !cond1 and !cond2
  mut res = __hotmux(p0=s0, p1=c, p2=s1, p3=b, p4=s2, p5=a)
  // Priority makes the controls one-hot for all four condition combinations.
}

for cond1 in (true, false) {
  for cond2 in (true, false) {
    mut r1 = code1(cond1,cond2,a=1,b=2,c=3)
    const (a,b,c) = (1,2,3)
    mut r2 = code2(cond1,cond2,a,b,c)

    cassert(r1==r2)
  }
}
