/*
:name: backtick_print
:type: comptime
:verifier_pass: 1
:verifier_fail: 0
*/
// `puts` == puts and `print` == print: escaped builtin callees (and escaped
// parameter/output names) behave exactly like comb_print.prp.
comb hello(`x`) -> (`y`) {
  `puts`("hello {x}")
  `print`("tail {`x`}")
  y = `x` + 1
}
const y = hello(`x`=3)
`cassert`(y == 4)
