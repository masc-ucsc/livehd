/*
:name: spec_syntax_destructure_rename_named_var
:type: comptime
:verifier_pass: 2
:verifier_fail: 0
*/
// qa.md Appendix §8: "destructuring a NAMED tuple binds each bare slot by name match (slot
// name == field name) or `slot=field`; destructuring an UNNAMED tuple binds by position".
// docs 03-bundle.md: "An explicit `local = source.path` slot binds the selected RHS field
// path to local `local`." A named tuple held in a variable (not a call) is a named RHS too.
const t = (const a = 1, const b = (const c = 5))
const (x=a, y=b.c) = t

cassert(x == 1)
cassert(y == 5)
