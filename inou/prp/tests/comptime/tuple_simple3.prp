const x = 1

cassert(x == x[0] == 1)

const y = (const foo=3)

cassert(y.foo == y == 3 == ((((3)))))

const z = (4,true)

cassert(z[0] == 4 == (((4))))
cassert(z != (4, false))
cassert(z != (5, true))
cassert(z == (4, true))
