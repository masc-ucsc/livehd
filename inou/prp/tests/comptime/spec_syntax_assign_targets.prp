/*
:name: spec_syntax_assign_targets
:type: comptime
:verifier_pass: 5
:verifier_fail: 0
*/
// qa.md Appendix §4: "Assignment targets: names, fields, selectors, bit-selects, and tuple
// destructuring of names `(a, b) = fcall()` (legal as a STATEMENT)." (Q20: "`(a,b) = fcall()`
// is legal as a statement (not expression)").
comb g() -> (a, b) { a = 7; b = 9 }

mut n = 0
n = 3                        // name
mut t = (mut a = 1, mut b = 2)
t.a = 5                      // field
mut arr:[4]U8 = 0
arr[2] = 7                   // selector
mut w:U8 = 0
w#[0..=3] = 0xF              // bit-select
mut a = 0
mut b = 0
(a, b) = g()                 // destructuring of names, as a statement

cassert(n == 3)
cassert(t.a == 5)
cassert(arr[2] == 7)
cassert(w == 15)
cassert(a == 7 and b == 9)
