/*
:name: tuple_simple
:type: parsing lnast comptime
:verifier_pass: 3
:verifier_fail: 0
*/

// A tuple is all-named or all-unnamed (03-bundle.md): positions and names live in
// separate tuples.
const u = (1,3)
const t = (const b=2,const d=4)

cassert((u[0] + u[1]) == u[0] + u[1] == 1 + 3 == 4)

cassert(u[0]+u[1]+t.b+t.d == 1+2+3+4 == u[0]+t.b+u[1]+t.d)
cassert(u[0]+u[1]+t['b']+t['d'] == 1+2+3+4)
