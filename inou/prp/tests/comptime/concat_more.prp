/*
:name: concat_more
:type: parsing lnast comptime
:verifier_pass: 44
:verifier_fail: 0
*/

// ---- concat_more ----
{
{
  const lhs = (const a=1,const b=2)
  const rhs = (const c=3,const d=4)
  const got = (...lhs, ...rhs)

  cassert(got == (a=1,b=2,c=3,d=4))
  cassert(got.a + got.d == 5)
  cassert(got.b + got.c == 5)
}

{
  const lhs = (const cfg=(const lo=1,const hi=2), const tag=7)
  const rhs = (const cfg=(const bar=3,const extra=4), const out=8)
  const got = (...lhs, ...rhs)

  cassert(got.cfg.lo == 1)
  cassert(got.cfg.hi == 2)
  cassert(got.cfg has 'bar' and got.cfg.bar == 3)
  cassert(got.cfg has 'extra' and got.cfg.extra == 4)
  cassert(got.tag + got.out == 15)
}

{
  const got = (...(lane=(zero=0)), ...(lane=(one=1)), ...(lane=(two=2)))

  cassert(got.lane == (zero=0,one=1,two=2))
  cassert(got.lane has 'one' and got.lane has 'two')
}

{
  const named = (...(a=1), ...(b=2), ...(c=3))
  cassert(named.a + named.b + named.c == 6)

  const got = (...(10,), ...(20,30), ...(40,))
  cassert(got[0] == 10)
  cassert(got[1] + got[2] + got[3] == 90)
}

{
  const base = (const left=1, const mid=(const x=2))
  const tail = (const right=3, const last=4)
  const got = (const head=0, ...base, const marker=9, ...tail)

  cassert(got == (head=0,left=1,mid=(x=2),marker=9,right=3,last=4))
  cassert(got.mid.x == 2)
  cassert(got.head + got.left + got.right + got.last == 8)
}

{
  const got = (5, ...(6,), 7)

  cassert(got == (5,6,7))
  cassert(got[0] + got[1] + got[2] == 18)
}

{
  const got = (...(a=2, b=nil), ...(a=2, b=10, c=3))

  cassert(got.a == 2)
  cassert(got.b == 10)
  cassert(got.c == 3)
}

{
  // Overlapping concat by choice: nil-out the slots that the other side wins.
  mut a = (mut f1:U32=1, mut f2:U32=2)
  mut b = (mut f1:U32=3, mut f2:U32=4)
  a.f1 = nil
  b.f2 = nil
  const x = (...a, ...b)
  cassert(x.f1==3 and x.f2==2)
}
}

// ---- tuple_concat ----
{
cassert((...(a=1,c=3), ...(b=2,d=4)) == (a=1, c=3, b=2, d=4))
cassert((...(1,2), ...(2,nil,5)) == (1,2,2,nil,5))
cassert((...(x=1), ...(a=2,b=5)) == (x=1,a=2,b=5))

// unknown bits survive a splice
const unknown_concat = (...(x=1,b=2), ...(y=0sb?,z=3))
cassert(unknown_concat.x == 1 and unknown_concat.b == 2 and unknown_concat.z == 3
        and "{unknown_concat.y:b}" == "{0sb?:b}")

cassert((1,...(3,4),6) == (1,3,4,6))
}

// ---- adv_splice_append ----
{
// 05b-statements.md array-builder idiom (replaces `++=`): rebuild with `...`.
mut acc:[] = nil
for i in 0..<5 {
  acc = (...acc, i)
}
cassert(acc == (0, 1, 2, 3, 4))
cassert(acc[3] == 3)
}

// ---- adv_splice_callarg ----
{
// 03-bundle.md: call-argument spread `foo(a=1, ...rest)` fills the remaining params.
comb foo_sum(a, b, c) -> (r) { r = a + b + c }
const rest = (const b = 2, mut c = 3)
cassert(foo_sum(a = 1, ...rest) == 6)
}

// ---- adv_splice_extend ----
{
// 03-bundle.md: extend a tuple by splicing it into a new literal with extra fields.
const y  = (mut ff = 1, const zz = 3)
const y2 = (...y, const qq = 2)
// y2 = (ff=1, zz=3, qq=2): the splice keeps the field NAMES, so compare by
// name (a named tuple never equals a positional one; see tuple_simple5).
cassert(y2 == (ff = 1, zz = 3, qq = 2))
cassert(y2.qq == 2)
cassert(y2.ff == 1)
}

// ---- adv_splice_merge ----
{
// 03-bundle.md: `(...a, ...b)` splices/merges both tuples' fields into a new tuple.
const a = (mut x = 1, mut y = 2)
const b = (const z = 3)
const c = (...a, ...b)
cassert(c == (const x = 1, const y = 2, const z = 3))
// the spliced tuple keeps its field NAMES — a named tuple never compares
// equal to a positional one (`c == (1,2,3)` is false; see tuple_simple5).
cassert(c == (x = 1, y = 2, z = 3))
cassert(c.z == 3)
}

// ---- spec_calls_splice_call_args ----
{
// docs 03-bundle.md: "Because `...` splices fields at its position, it can also
// insert in the middle of a literal and add arguments to a function call":
// `cassert(foo(a=1, ...rest) == 6)   // same as foo(a=1, b=2, c=3)`.
// qa.md Appendix §8: the argument list is a named tuple; named ++ named merges.

comb foo(a, b, c) -> (r) { r = a * 100 + b * 10 + c }

const rest = (const b=2, mut c=3)
cassert(foo(a=1, ...rest) == 123)
cassert(foo(...rest, a=4) == 423)
}

// ---- spec_calls_splice_named ----
{
// qa.md Appendix §8: "named ++ named merges (overlapping names are an error, as
// today)".
// docs 03-bundle.md: `const ccat1 = (...a, ...b)` ==
// `(const a=1, const b=2, const c=3)`; a same-named nested tuple merges its
// subfields recursively.

const a = (mut a=1, mut b=2)
const b = (const c=3)
const ccat1 = (...a, ...b)
cassert(ccat1 == (const a=1, const b=2, const c=3))
const ccat2 = (...a, const d=20, ...b)
cassert(ccat2.d == 20 and ccat2.c == 3 and ccat2.a == 1)
const deep = (...(const cfg=(const lo=2), const c=3), ...(const cfg=(const hi=20), const d=30))
cassert(deep.cfg.lo == 2 and deep.cfg.hi == 20 and deep.d == 30)
}

// ---- spec_calls_splice_unnamed ----
{
// qa.md Appendix §8: "Splice `x = (...foo, ...bar)` concatenates: unnamed ++
// unnamed appends".
// docs 03-bundle.md: `assert((...p, ...q) == (1,2,3,4))  // unnamed splices
// append in order`, `assert((...p, 5) == (1,2,5))`.

const p = (1, 2)
const q = (3, 4)
cassert((...p, ...q) == (1, 2, 3, 4))
cassert((...p, 5) == (1, 2, 5))
const pq = (...q, ...p)
cassert(pq[0] == 3 and pq[3] == 2)
}
