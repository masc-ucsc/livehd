/*
:name: adv_int_div_13
:type: comptime
:verifier_pass: 4
:verifier_fail: 0
*/

// Division result fits into typed destinations (range-fit check).
// `(-9)/3 == -3` clearly fits S3 (range -4..3). The plain `d == -3`
// cassert proves the value is really -3.
const a:U8 = 200 / 2
const b:S4 = (-14) / 2
const c:U1 = 5 / 5
const d:S3 = (-9) / 3

cassert(a == 100)
cassert(b == -7)
cassert(c == 1)
cassert(d == -3)
