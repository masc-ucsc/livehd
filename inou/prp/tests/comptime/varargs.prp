/*
:name: varargs
:type: comptime
:verifier_pass: 5
:verifier_fail: 0
*/

// Ordinary tuple parameters accept positional tuple shorthand; trailing
// captures accept named leftovers. Both inline at the call site.

comb add1(x) -> (r) { r = x[0] + x[1] + x[2] }        // ordinary tuple argument
comb g(base, ...rest) -> (r) { r = base + rest.lo + rest.hi }  // fixed leading + var-args tail
comb ff(...args) -> (r) { r = args.lo + args.hi }        // named leftovers
comb h(xs) -> (r) { r = xs[0] }                       // variable tuple length

const a = add1(1, 2, 3)
cassert(a == 6)
const b = g(base=10, lo=20, hi=30)
cassert(b == 60)
const c = ff(lo=4, hi=5)
cassert(c == 9)
cassert(h(7) == 7)
cassert(h(7, 8, 9) == 7)
