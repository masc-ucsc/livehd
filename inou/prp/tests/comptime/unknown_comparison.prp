const x = 0sb?
const alias = x
cassert(String(0sb? == 0sb?) == "0ub?")
cassert(String(0sb? != 0sb?) == "0ub?")
cassert(String(0sb? == 0) == "0ub?")
cassert(String(0sb? != 0) == "0ub?")
cassert(String(0sb? == nil) == "0ub?")
cassert(String(0sb? != nil) == "0ub?")
cassert(String(x == alias) == "0ub?")
cassert(String(x != alias) == "0ub?")
cassert(String((1, x) == (1, x)) == "0ub?")
cassert(String((1, x) != (2, x)) == "0ub?")
cassert(String(x < x) == "0ub?")
cassert(String(x < 1) == "0ub?")
cassert(String(x <= x) == "0ub?")
cassert(String(x <= 1) == "0ub?")
cassert(String(x > x) == "0ub?")
cassert(String(x > 1) == "0ub?")
cassert(String(x >= x) == "0ub?")
cassert(String(x >= 1) == "0ub?")
