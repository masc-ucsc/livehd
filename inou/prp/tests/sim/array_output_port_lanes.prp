/*
:name: array_output_port_lanes
:type: simulation
*/
// Merged fixture: each section below is the original tests/sim fixture listed in its banner,
// body unchanged (module and test names are unique across the sections).

// ============================================================
// from array_output_lane_writes.prp
// ============================================================
// lhdtrack suggestions.md 2.2(d): an ARRAY OUTPUT port written lane by lane
// with no whole-array assignment first. An output starts as nil, like
// `mut v:[4]U4 = nil`, so writing its lanes one at a time is legal (user ruling
// 2026-09-27 #15); every lane is written here, so no lane is left unset.
// It failed with "upass.tolg: array 'v' is written before it has an
// initializer", both for straight-line lane writes and inside a `for`; a
// leading `v = 0` was the workaround.
//
// The parent reads the lanes back through `const w:[4]U4 = x`, the spelling
// that already worked (array_output_port_index.prp covers `x[3]`).
mod straight(a:U4) -> (v:[4]U4@[0]) {
  v[0] = a
  v[1] = a ^ 1
  v[2] = a ^ 2
  v[3] = a ^ 3
}
mod looped(a:U4) -> (v:[4]U4@[0]) {
  for i in 0..<4 {
    v[i] = a ^ (i + 4)
  }
}

pub mod array_output_lane_writes(a:U4) -> (st0:U4@[0], st3:U4@[0], l0:U4@[0], l3:U4@[0]) {
  const s:[4]U4 = straight(a=a)
  st0 = s[0]
  st3 = s[3]
  const l:[4]U4 = looped(a=a)
  l0 = l[0]
  l3 = l[3]
}

test array_output_lane_writes.lanes {
  mut dut = array_output_lane_writes
  mut ok  = true
  tick 16 {
    dut.a = clock
    step
    if dut.st0 != clock or dut.st3 != (clock ^ 3) { ok = false }
    if dut.l0 != (clock ^ 4) or dut.l3 != (clock ^ 7) { ok = false }
  }
  assert(ok, "every lane of an array output written one at a time")
}

// ============================================================
// from array_output_port_index.prp
// ============================================================
// lhdtrack suggestions.md 2.2(d), OUTPUT side: a child's ARRAY output read
// back by index at the call site.
//   * ONE output: the call binds the destination to that output directly
//     (06-functions.md "Binding return values"), so `x[3]` is lane 3 of the
//     child's `v`. It failed with "upass.tolg: instance result has no output
//     named '3'" -- the index was taken as an output NAME -- for a plain
//     `[4]U4` port and for a generic `[N]U4` one alike.
//   * SEVERAL outputs: `m.v[3]` is lane 3 of output `v`. It failed with
//     "upass.tolg: unresolved reference '%...' -- it has no driver".
// `const w:[4]U4 = x` followed by `w[3]` was the only working spelling.
mod lanes(a:U4) -> (v:[4]U4@[0]) {
  v = 0
  for i in 0..<4 {
    v[i] = a ^ i
  }
}
mod lanes2(a:U4) -> (v:[4]U4@[0], p:U4@[0]) {
  v = 0
  for i in 0..<4 {
    v[i] = a ^ (i + 8)
  }
  p = a ^ 15
}
mod glanes<N=2>(a:U4) -> (v:[N]U4@[0]) {
  v = 0
  for i in 0..<N {
    v[i] = a ^ (i + 4)
  }
}

pub mod array_output_port_index(a:U4) -> (y:U4@[0], z:U4@[0], t:U4@[0], p:U4@[0]) {
  const x = lanes(a=a)
  y = x[3]
  const g = glanes<N=4>(a=a)
  z = g[2]
  const m = lanes2(a=a)
  t = m.v[3]
  p = m.p
}

test array_output_port_index.lanes {
  mut dut = array_output_port_index
  mut ok  = true
  tick 16 {
    dut.a = clock
    step
    if dut.y != (clock ^ 3) or dut.z != (clock ^ 6) { ok = false }
    if dut.t != (clock ^ 11) or dut.p != (15 - clock) { ok = false }
  }
  assert(ok, "lane k of a child's array output")
}

// ============================================================
// from array_tuple_store_elem.prp
// ============================================================
// A combinational array reassigned WHOLE from a tuple literal, then written
// and read element by element. upass.tolg failed "unresolved reference
// '%w_1'" on the reassignment: its SSA version (`w___ssa_1 = %w_1`) took the
// value as a runtime bus, and a tuple literal has no pin. It now packs like
// the declaration's initializer. The sibling of the whole `w = 0sb?` store
// pinned by equiv/generic_array_xfill_elem; covered here in a plain mod and a
// `::[timecheck=false]` one.
mod array_tuple_store_elem(a:U8, b:U8) -> (o:U8@[0], p:U8@[0]) {
  mut w:[2]U8 = (0, 0)
  w = (1, 3)
  w[0] = a
  o = w[0] ^ w[1]
  w = (5, 7)
  w[1] = b
  p = w[0] ^ w[1]
}

mod array_tuple_store_elem_tc::[timecheck=false](a:U8) -> (o:U8@[0]) {
  mut w:[2]U8 = (0, 0)
  w = (9, 6)
  w[0] = a
  o = w[0] ^ w[1]
}

test array_tuple_store_elem.values {
  mut x = array_tuple_store_elem
  mut t = array_tuple_store_elem_tc
  tick 4 {
    const va = (clock * 37 + 11) & 0xff
    const vb = (clock * 91 + 5) & 0xff
    x.a = va
    x.b = vb
    t.a = va
    step
    assert(x.o == (va ^ 3), "w[0] = a over the tuple reassignment (1, 3)")
    assert(x.p == (5 ^ vb), "w[1] = b over the second reassignment (5, 7)")
    assert(t.o == (va ^ 6), "timecheck=false: w[0] = a over (9, 6)")
  }
}
