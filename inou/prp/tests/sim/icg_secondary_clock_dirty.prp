/*
:name: icg_secondary_clock_dirty
:type: simulation
:set: sim.tune.dirty=on sim.tune.live_words=1
*/
// A gated flop must be re-evaluated when its clock-enable LATCH changes, even
// when nothing else it reads does.
//
// Shape (lhdsuite minion's txfma pipeline, reduced): two `prim_clk_gate`-style
// ICGs (transparent-low enable latch ANDed with the clock) in the parent, their
// gated clocks handed to a child as two clock PORTS. `ra` sits on the child's
// reference clock `ca`; `rb` sits on `cb`, a SECONDARY clock. The secondary
// flop's commit guard is resolved through the occurrence edge
// (icg_guards + occurrence_bool_value) and names the parent's enable latch
// member directly -- no state-current boundary slot carries it, so under
// dirty gating the latch's commit re-dirtied the slot consumers but never
// `rb`'s capture color. The data is held constant across the enable edge, so
// nothing else woke that color: `rb` never loaded under dirty=on (minion's
// f3..f5 flops kept their power-on draws) while dirty=off loaded it. `:set:`
// pins a vector that splits the latch and the capture into separate colors.
//
// The asserts only pin what every vector must agree on. (`rb` loads one
// period after `ra` today: a secondary-clock guard samples the latch's
// current value, not its closing-edge pending value -- see the report; this
// fixture is about the missing re-evaluation, not that lag.)
pub mod clk_gate(clk_i:Clock, en_i:Bool) -> (clk_o:Clock@[]) {
  clk_o = Clock(clock_pin=clk_i, enable=en_i)  // the ICG: en_i latched while clk_i is low
}

pub mod two_clock_stage(ca:Clock, cb:Clock, da:U8, db:U8) -> (qa:U8@[], qb:U8@[]) {
  reg ra:U8:[clock_pin=ca] = 0
  reg rb:U8:[clock_pin=cb] = 0
  ra = da
  rb = db
  qa = ra
  qb = rb
}

pub mod icg_secondary_clock_dirty(clk:Clock, ena:Bool, enb:Bool, d:U8) -> (qa:U8@[], qb:U8@[]) {
  mut ga = clk_gate::[name=ga](clk_i = clk, en_i = ena)
  mut gb = clk_gate::[name=gb](clk_i = clk, en_i = enb)
  mut s  = two_clock_stage::[name=s](ca = ga.clk_o, cb = gb.clk_o, da = d, db = d)
  qa = s.qa
  qb = s.qb
}

test icg_secondary_clock_dirty.gated_flops_load_when_the_gate_opens {
  mut acc = icg_secondary_clock_dirty
  tick 8 {
    acc.ena = clock >= 4
    acc.enb = clock >= 4
    acc.d   = if clock < 2 { 7 } else { 9 }  // constant from clock 2 on: only the gates move
    step
    if clock < 4 {
      assert(acc.qa == 0, "gate closed: ra holds its initial value")
      assert(acc.qb == 0, "gate closed: rb holds its initial value")
    }
    if clock >= 4 {
      assert(acc.qa == 9, "gate open: ra loads the held data")
    }
    if clock >= 5 {
      assert(acc.qb == 9, "gate open: rb loads the held data (its color must wake on the latch change)")
    }
  }
}
