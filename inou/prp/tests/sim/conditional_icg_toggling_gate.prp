mod lwc_icg_cell(clk:Clock, en:Bool) -> (g:Clock@[]) {
  g = Clock(clock_pin=clk, enable=en)   // the ICG (ruling 56)
}

mod lwc_icg_leaf(gclk:Clock, d:U8) -> (q:U8@[]) {
  reg acc:U8:[clock_pin=gclk] = 0
  wrap acc = acc + d
  q = acc
}

mod lwc_icg_wrapper(clk:Clock, gate:Bool, d:U8) -> (q:U8@[]) {
  const cell = lwc_icg_cell(clk=clk, en=gate)
  q = lwc_icg_leaf(gclk=cell.g, d=d)
}

pub mod lwc_icg_top(clk:Clock, active:Bool, gate:Bool, d:U8) -> (q:U8@[], ctl:U8@[]) {
  q = 0
  if active {
    q = lwc_icg_wrapper(clk=clk, gate=gate, d=d)
  }

  reg every:U8:[clock_pin=clk] = 0
  wrap every = every + d
  ctl = every
}

test lwc_icg_top.dbg {
  mut dut = lwc_icg_top
  tick 8 {
    dut.active = true
    dut.gate = (clock == 1) or (clock == 2) or (clock == 4) or (clock == 7)
    dut.d = 1
    step
    assert(dut.ctl == clock + 1, "ctl")
    mut want:U8 = 0
    if clock >= 1 { want = 1 }
    if clock >= 2 { want = 2 }
    if clock >= 4 { want = 3 }
    if clock >= 7 { want = 4 }
    assert(dut.q == want, "q {dut.q} want {want}")
  }
}
