/*
:name: loop_invariant_broadcast
:type: simulation
*/
// Repeated and changing wide inputs cross two compact-loop boundaries. Lane
// zero is sometimes inactive while later lanes consume the changed input.
mod broadcast_lane(a:U8, reset:Reset) -> (q:U16@[0]) {
  reg acc:U16:[reset_pin = reset, async = true] = 0
  wrap acc = acc + a
  q = acc
}
pub mod loop_invariant_broadcast(bus:U512, enable:Bool, reset:Reset) -> (total:U16@[0]) {
  mut sum:U16 = 0
  for group in 0..<4 {
    for lane in 0..<16 {
      if enable or lane != 0 {
        const value = bus#[((group*16 + lane)*8)..+8]
        const q = broadcast_lane(a=value, reset=reset)
        wrap sum = sum + q   // q is a U16 port: the sum may not fit
      }
    }
  }
  total = sum
}
test loop_invariant_broadcast.changes_and_holds {
  mut dut = loop_invariant_broadcast
  tick 7 {
    dut.bus = if clock < 2 {
      0x01010101010101010101010101010101010101010101010101010101010101010101010101010101010101010101010101010101010101010101010101010101
    } else {
      0x02020202020202020202020202020202020202020202020202020202020202020202020202020202020202020202020202020202020202020202020202020202
    }
    dut.enable = clock == 0 or clock == 3 or clock >= 5
    dut.reset = clock == 4
    step
    const expected = if clock == 0 { 64 } elif clock == 1 { 120 } elif clock == 2 { 240 } elif clock == 3 { 372 }
      elif clock == 4 { 0 } elif clock == 5 { 128 } else { 256 }
    assert(dut.total == expected)
  }
}
