/*
:name: satopt_committed
:type: simulation
:set: pass.satopt=true
*/
// pass.satopt commits proof-backed rewrites before simulation
// (todo/livehd/2s-satopt A): a select proven never true is tied off and a mux
// arm proven constant when selected is rebuilt. The simulated values must not
// change.
pub comb never_true(x:u8, a:u8, b:u8) -> (out:u8) {
  out = if x == x + 1 { a } else { b }
}

pub comb arm_zero(x:u8, a:u8) -> (out:u8) {
  out = if x == 0 { x } else { a }
}

test never_true.keeps_the_else_arm {
  mut dut = never_true
  mut x:u8 = 0
  tick 256 {
    dut.x = x
    dut.a = 5
    dut.b = 9
    step
    assert(dut.out == 9, "a never-true select keeps its else arm, even where x + 1 wraps a u8")
    x = (x + 1) & 255
  }
}

test arm_zero.reads_the_same_values {
  mut dut = arm_zero
  mut x:u8 = 0
  tick 4 {
    dut.x = x
    dut.a = 5
    step
    assert(dut.out == (if x == 0 { 0 } else { 5 }), "an arm proven 0 when selected still reads 0")
    x += 1
  }
}
