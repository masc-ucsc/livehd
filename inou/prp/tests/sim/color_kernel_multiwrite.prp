/*
:name: color_kernel_multiwrite
:type: simulation
:sim_sweep: sim.tune.backend=slop,llvm
*/
// Two occurrences of one connected, two-output combinational definition. The
// occurrence-wide schedule must emit one canonical kernel and bind it twice.
// Both results cross color boundaries into state, so the kernel changed-mask
// has two ABI write bits whose canonical order must match each bound object.
mod pair(x:U8) -> (lo:U8@[0], hi:U8@[0]) {
  const base = x * 3
  wrap lo = base + 1
  wrap hi = lo + 8
}

pub mod kernel_multiwrite(d:U8, e:U8) -> (a_lo:U8@[1], a_hi:U8@[1], b_lo:U8@[1], b_hi:U8@[1], a_zero:U1@[1]) {
  const a = pair(d)
  const b = pair(e)
  reg ar0:U8 = 0
  reg ar1:U8 = 0
  reg br0:U8 = 0
  reg br1:U8 = 0
  ar0 = a.lo
  ar1 = a.hi
  br0 = b.lo
  br1 = b.hi
  a_lo = ar0
  a_hi = ar1
  b_lo = br0
  b_hi = br1
  a_zero = U1(ar0 == 0)
}

test kernel_multiwrite.changed_mask_order {
  mut dut = kernel_multiwrite
  tick 10 {
    const dv = 2 + (clock * 7)
    dut.d = dv
    dut.e = dv + 5
    step
    assert(dut.a_lo == ((dv * 3) + 1) & 0xFF)
    assert(dut.a_hi == ((dv * 3) + 9) & 0xFF)
    assert(dut.b_lo == (((dv + 5) * 3) + 1) & 0xFF)
    assert(dut.b_hi == (((dv + 5) * 3) + 9) & 0xFF)
    assert(dut.a_zero == U1(dut.a_lo == 0))
  }
}
