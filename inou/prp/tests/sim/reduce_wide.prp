/*
:name: reduce_wide
:type: simulation
*/
pub comb wide_reduce_runtime(a:U129, b:S65) -> (parity:U1, population:U8, signed_parity:U1, signed_population:U7) {
  parity = a#^[..]
  population = a#+[..]
  signed_parity = b#^[..]
  signed_population = b#+[..]
}

test wide_reduce_runtime.boundaries {
  mut dut = wide_reduce_runtime
  mut position:U8 = 0
  mut one:U129 = 1
  mut signed_ones:S65 = -1
  tick 129 {
    dut.a = one << position
    dut.b = signed_ones
    step
    assert(dut.parity == 1)
    assert(dut.population == 1)
    assert(dut.signed_parity == 1)
    assert(dut.signed_population == 65)
    position += 1
  }
}
