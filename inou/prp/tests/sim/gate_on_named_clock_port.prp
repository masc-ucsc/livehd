/*
:name: gate_on_named_clock_port
:type: simulation
*/

// A clock gate folds whatever the NAME of the port carrying the clock (clocks
// bind by type, docs 07-typesystem). `regate` and `regate_clk` below have
// byte-identical bodies -- one `Clock(clock_pin=, enable=)` gate, one flop --
// and both are handed this module's own reference clock. Found by
// differential fuzzing against Icarus, 2026-08-06, when the NAME decided it: a
// gate on a port spelled `clk`, `clock`, `clk_i` or `clk2` folded, one on
// `gclk`, `gin`, `myclk`, `ck` or `clkin` was refused (`flop ... has a derived
// clock inou.cgen.sim cannot fold into a commit guard`).
//
// TWO CONTROLS, IN THE DESIGN: `qdirect` (a child that uses a `gclk` port
// DIRECTLY as its flop's clock, no gate) and `qnamed` (the same gate body with
// the port spelled `clk`). `qany == qnamed` is the property: two children with
// identical bodies, fed the same clock and the same enable, agree.
//
// GOLDENS -- hand-written Icarus twin (all four modules retyped from this
// source, never LiveHD's emitter), enables changed while the clock is LOW:
//
//     c       : 0   1   2   3   4   5
//     qdirect : 10  15  20  25  30  35     (ungated: loads every period)
//     qnamed  : 10  15  15  15  30  30     (gated: holds while e is low)
//     qany    : 10  15  15  15  30  30     (identical body, another port name)

// CONTROL -- a port not spelled `clk`, used DIRECTLY as a clock.
mod direct(gclk:Clock, d:U8) -> (o:U8@[]) {
  reg f:U8:[clock_pin=gclk] = 0
  f = d
  o = f
}

// CONTROL -- gating a port spelled `clk`.
mod regate_clk(clk:Clock, e:Bool, d:U8) -> (o:U8@[]) {
  const g = Clock(clock_pin=clk, enable=e)
  reg f:U8:[clock_pin=g] = 0
  f = d
  o = f
}

// The byte-identical body, port spelled `gclk`: it must gate the same way.
mod regate(gclk:Clock, e:Bool, d:U8) -> (o:U8@[]) {
  const g = Clock(clock_pin=gclk, enable=e)
  reg f:U8:[clock_pin=g] = 0
  f = d
  o = f
}

pub mod nametop(clk:Clock, e:Bool, d:U8) -> (qdirect:U8@[], qnamed:U8@[],
                                            qany:U8@[], ctl:U8@[]) {
  // All three children are handed THIS module's reference clock, unmodified.
  mut a = direct(gclk=clk, d=d)
  qdirect = a
  mut c = regate_clk(clk=clk, e=e, d=d)
  qnamed = c
  mut b = regate(gclk=clk, e=e, d=d)
  qany = b

  // CONTROL: a flop on the ungated reference clock, so a failure is never a
  // dead testbench.
  reg cr:U8:[clock_pin=clk] = 0
  cr  = d
  ctl = cr
}

test nametop.a_gate_folds_regardless_of_the_clock_ports_name {
  mut acc  = nametop
  mut seen = 0
  mut bad_direct = 0
  mut bad_named  = 0
  mut bad_ctl    = 0
  mut bad_any    = 0
  mut bad_agree  = 0
  mut g_gated:U16 = 0
  tick 6 {
    // Enables move only while the clock is LOW -- the discipline every gated
    // fixture here follows; an enable racing the clock rise is the glitch
    // hazard a real ICG interposes a latch for.
    mut ev:Bool = (clock <= 1) or (clock == 4)
    mut dv:U8   = 10 + (clock * 5)
    acc.e = ev
    acc.d = dv
    step
    if ev {
      g_gated = dv
    }

    seen = seen + 1
    if acc.ctl != dv {
      bad_ctl = bad_ctl + 1
    }
    if acc.qdirect != dv {
      bad_direct = bad_direct + 1
    }
    if acc.qnamed != g_gated {
      bad_named = bad_named + 1
    }
    if acc.qany != g_gated {
      bad_any = bad_any + 1
    }
    if acc.qany != acc.qnamed {
      bad_agree = bad_agree + 1
    }
  }
  assert(seen == 6, "the comparisons actually ran (guards against a vacuous pass)")
  assert(bad_ctl == 0, "CONTROL: the flop on the ungated reference clock loads every tick")
  assert(bad_direct == 0, "CONTROL: a `gclk`-named port used DIRECTLY as a clock is fine")
  assert(bad_named == 0, "CONTROL: the same gate body on a port spelled `clk` folds")
  assert(bad_agree == 0, "two children with identical bodies and the same clock must agree")
  assert(bad_any == 0, "a gate folds on a clock port whatever the port is named")
}
