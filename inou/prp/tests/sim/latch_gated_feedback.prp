/*
:name: latch_gated_feedback
:type: simulation
*/

// Reduced from Minion's resettable opposite-phase accumulator pairs. A closed
// ICG leaves the low latch open (`enable_high=false` on the gated clock), and
// the low/high data windows can never be open together. Reset is the latches'
// async `reset_pin` (the form the Verilog/Pyrope writers emit).
//
// A local `Clock_cell` is a gated level, not an unconditional reference-clock
// window: `high` holds at 3 while `run` is low, ticks 5..7. The low latch stays
// open while the gate is closed, and the falling-edge observer reads settled
// high Q. Both LLVM and Slop run these same assertions.
pub mod gated_feedback(clk:Clock, clear:Bool, run:Bool, d:U8) -> (low:U8@[], high:U8@[], sampled:U8@[1], observed:U8@[]) {
  const local_clock = Clock(clock_pin=clk, enable=run)
  reg lo:U8:[latch=true, enable=local_clock, enable_high=false, reset_pin=clear, async=true, initial=0]
  reg hi:U8:[latch=true, enable=local_clock, reset_pin=clear, async=true, initial=0]
  reg sample:U8:[clock_pin=clk] = 0
  reg observer:U8:[clock_pin=clk, posclk=false] = 0
  const shared_next = (hi + 1) & 255
  lo = shared_next
  hi = lo
  sample = d
  observer = shared_next
  low = lo
  high = hi
  sampled = sample
  observed = observer
}

test gated_feedback.reset_and_pause {
  mut acc = gated_feedback
  mut expected:U8 = 0
  tick 14 {
    const clearing = (clock < 2) or (clock == 8)
    const running = (clock < 5) or (clock >= 10)
    acc.clear = clearing
    acc.run = running
    acc.d = 11 + clock
    if clearing {
      expected = 0
    } elif running {
      expected += 1
    }
    step
    assert(acc.sampled == 11 + clock, "reference-clock flop remains active")
    assert(acc.high == expected, "high latch advances only with an enabled clock")
    assert(acc.observed == expected + 1, "shared arithmetic sees settled high Q before the falling edge")
    if clearing {
      assert(acc.low == 0, "reset reaches both latch phases, including while gated off")
    } else {
      assert(acc.low == expected + 1, "open low latch sees the settled high value")
    }
  }
}

// The alternating edge/settle sequence: each low latch sees the newly
// committed negedge flop, and each high latch sees the newly committed
// posedge flop. A posedge reader samples the preceding low window.
pub mod alternating_phases(clk:Clock, d:U8) -> (fall_q:U8@[], low_q:U8@[], rise_q:U8@[], high_q:U8@[]) {
  reg falling:U8:[clock_pin=clk, posclk=false] = 0
  reg low_latch:U8:[latch=true, enable=clk, enable_high=false] = 0
  reg rising:U8:[clock_pin=clk] = 0
  reg high_latch:U8:[latch=true, enable=clk] = 0
  falling = d
  low_latch = falling
  rising = low_latch
  high_latch = rising
  fall_q = falling
  low_q = low_latch
  rise_q = rising
  high_q = high_latch
}

test alternating_phases.edge_then_settle {
  mut acc = alternating_phases
  mut previous:U8 = 0
  tick 6 {
    const next_value = 11 + (17 * clock)
    acc.d = next_value
    step
    assert(acc.fall_q == next_value, "falling-edge flop commits")
    assert(acc.low_q == next_value, "low latch settles after the falling-edge commit")
    assert(acc.rise_q == previous, "rising-edge flop reads the preceding low window")
    assert(acc.high_q == previous, "high latch settles after the rising-edge commit")
    previous = next_value
  }
}



// Reduced from Minion's resettable write-commit cell. The low-phase enable
// sampler has no reset; the high-phase data latch resets independently.
pub mod resettable_enable_feedback(clk:Clock, clear:Bool, run:Bool, d:U1) -> (q:U1@[], sampled:U1@[1]) {
  const local_clock = Clock(clock_pin=clk, enable=run)
  reg value:U1:[latch=true, enable=local_clock, reset_pin=clear, async=true, initial=0]
  reg can_write:U1:[latch=true, enable=local_clock, enable_high=false] = nil
  reg sample:U1:[clock_pin=clk] = 0
  can_write = if value == 0 { 1 } else { 0 }
  if can_write != 0 {
    value = d
  }
  sample = d
  q = value
  sampled = sample
}

test resettable_enable_feedback.reset_pause_and_lock {
  mut acc = resettable_enable_feedback
  mut expected:U1 = 0
  tick 14 {
    const clearing = (clock < 2) or (clock == 5) or (clock == 9)
    const running = ((clock >= 2) and (clock < 4)) or ((clock >= 7) and (clock < 11)) or (clock >= 12)
    const data = if (clock == 3) or (clock == 8) or (clock >= 11) { 0 } else { 1 }
    acc.clear = clearing
    acc.run = running
    acc.d = data
    if clearing {
      expected = 0
    } elif running and (expected == 0) {
      expected = data
    }
    step
    assert(acc.sampled == data, "ungated reference-clock flop stays active")
    assert(acc.q == expected, "reset overrides the closed gate; sampled enable prevents overwriting a locked value")
  }
}
