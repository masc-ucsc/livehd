/*
:name: loop_roll_invariant_domain
:type: simulation
:expect_instances: u_loop_0=1 u_loop_1=1
*/
// A loop whose body nests a loop over a LOOP-INVARIANT domain must DECLINE to
// roll, not roll and then die in tolg.
//
// lift_loop_body turns invariants into input ports of the lifted definition
// exactly as it does the index and the carries, so `n` is runtime inside
// `top.__loop0` and the inner `for j in 0..<n` can no longer be unrolled there
// ("upass.tolg: non-comptime 'for' loop"). The planner's nested-domain guard
// seeded its taint set from the index and the carries only, so it accepted this
// shape and the compile then hard-failed on source that unrolls fine.
//
// `:expect_instances: u_loop_0=1 u_loop_1=1` IS the claim: the decline must happen at
// planning time, leaving the loop source-unrolled.

pub mod top(a:u8) -> (o:u12@[0]) {
  const n:u8  = 4
  mut acc:u12 = a
  for i in 0..<2 {
    for j in 0..<n { acc = acc + j }
  }
  o = acc
}

test invariant_domain.unrolls {
  mut dut = top
  tick 1 {
    dut.a = 5
    step
    // two outer iterations x (0+1+2+3) = 12, plus the seed
    assert(dut.o == 17, "5 + 2*(0+1+2+3)")
  }
}
