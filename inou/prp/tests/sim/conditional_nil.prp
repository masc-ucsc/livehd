/*
:name: conditional_nil
:type: simulation
*/

// Give memory a known value before reset: an uninitialized memory must retain
// it, while the ZERO=true variation must reset it. No random power-on value
// is assumed, and the same assertions exercise both nil spellings.
mod explicit_nil(clk:u1, reset:bool, address:u2, we:bool, data:u8) -> (value:u8@[]) {
  reg memory:[4]u8:[ordering="old"] = nil
  if we { memory[address] = data }
  value = memory[address]
}

mod conditional_memory<ZERO=false>(clk:u1, reset:bool, address:u2, we:bool, data:u8) -> (value:u8@[]) {
  reg memory:[4]u8:[ordering="old"] = if ZERO { 0 } else { nil }
  if we { memory[address] = data }
  value = memory[address]
}

mod conditional_false(clk:u1, reset:bool, address:u2, we:bool, data:u8) -> (value:u8@[]) {
  value = conditional_memory<ZERO=false>(clk=clk, reset=reset, address=address, we=we, data=data)
}

mod conditional_true(clk:u1, reset:bool, address:u2, we:bool, data:u8) -> (value:u8@[]) {
  value = conditional_memory<ZERO=true>(clk=clk, reset=reset, address=address, we=we, data=data)
}

// Reset clears one memory address per cycle; hold it for all four addresses.
test conditional_nil.explicit_holds {
  mut dut = explicit_nil
  mut cycle = 0
  tick 8 clocks=(clk=1) {
    dut.address = 2
    dut.data = 0xa5
    dut.we = cycle == 1
    dut.reset = cycle >= 3 and cycle < 7
    step
    if cycle == 1 or cycle == 2 {
      assert(dut.value == 0xa5, "write before reset")
    } elif cycle >= 6 {
      assert(dut.value == 0xa5, "reset and release must respect the initializer")
    }
    cycle += 1
  }
}

test conditional_nil.disabled_holds {
  mut dut = conditional_false
  mut cycle = 0
  tick 8 clocks=(clk=1) {
    dut.address = 2
    dut.data = 0xa5
    dut.we = cycle == 1
    dut.reset = cycle >= 3 and cycle < 7
    step
    if cycle == 1 or cycle == 2 {
      assert(dut.value == 0xa5, "write before reset")
    } elif cycle >= 6 {
      assert(dut.value == 0xa5, "reset and release must respect the initializer")
    }
    cycle += 1
  }
}

test conditional_nil.enabled_clears {
  mut dut = conditional_true
  mut cycle = 0
  tick 8 clocks=(clk=1) {
    dut.address = 2
    dut.data = 0xa5
    dut.we = cycle == 1
    dut.reset = cycle >= 3 and cycle < 7
    step
    if cycle == 1 or cycle == 2 {
      assert(dut.value == 0xa5, "write before reset")
    } elif cycle >= 6 {
      assert(dut.value == 0, "reset and release must respect the initializer")
    }
    if cycle == 0 { assert(dut.value == 0, "ZERO=true power-on initialization") }
    cycle += 1
  }
}
