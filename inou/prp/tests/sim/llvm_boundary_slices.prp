/*
:name: llvm_boundary_slices
:type: simulation
*/
// Whole operands and overlapping slices must share transport without changing
// bit coordinates. Exercise a slice across the 64-bit limb boundary and state.
pub mod llvm_boundary_slices(d:U130, e:U130) -> (cross:U12@[0], high:U2@[0], low:U8@[0], whole:U130@[0]) {
  reg saved:U130 = (1 << 129) | (1 << 64) | 0xa5
  whole = ((saved ^ d) + e)#[0..=129]
  low = saved#[0..=7] ^ d#[0..=7]
  cross = saved#[60..=71] ^ d#[60..=71]
  high = saved#[128..=129] ^ d#[128..=129]
  saved = d
}

test llvm_boundary_slices.shared_transport {
  mut dut = llvm_boundary_slices
  tick 5 {
    dut.reset = clock == 0
    dut.d = (1 << 128) | (0xabc << 60) | 0x39
    dut.e = 1
    step
    const initial = (1 << 129) | (1 << 64) | 0xa5
    assert(clock == 0 implies dut.whole == ((initial ^ dut.d) + 1))
    assert(clock == 0 implies dut.low == (initial#[0..=7] ^ dut.d#[0..=7]))
    assert(clock == 0 implies dut.cross == (initial#[60..=71] ^ dut.d#[60..=71]))
    assert(clock == 0 implies dut.high == (initial#[128..=129] ^ dut.d#[128..=129]))
    assert(clock > 0 implies dut.whole == 1)
    assert(clock > 0 implies (dut.low == 0 and dut.cross == 0 and dut.high == 0))
  }
}

// Signed integers extend above their inferred storage width. Cover a window
// wholly above the input and another that crosses the 64-bit limb boundary.
pub mod llvm_signed_boundary_slices(d:S4) -> (full:U12@[0], high:U8@[0], cross:U70@[0], negative:S12@[0]) {
  full = d#[0..=11]
  high = d#[4..=11]
  cross = d#[1..=70]
  negative = d#sext[0..=11]
}

test llvm_signed_boundary_slices.sign_extension {
  mut dut = llvm_signed_boundary_slices
  tick 16 {
    dut.d = clock - 8
    step
    const value = clock - 8
    const shifted = value >> 1
    assert(dut.full == if value < 0 { value + 4096 } else { value })
    assert(dut.high == if value < 0 { 255 } else { 0 })
    assert(dut.cross == if value < 0 { shifted + (1 << 70) } else { shifted })
    assert(dut.negative == value)
  }
}

// Several fixed lanes share each ABI word. Keep their consumer offsets exact
// for both state and top inputs, including a slice whose high bit is the sign
// of the underlying Slop carrier.
pub mod llvm_shared_word_lanes(d:U128) -> (a:U4@[0], b:U4@[0], c:U4@[0], e:U4@[0]) {
  reg saved:U128 = 0x9876543210fedcba0123456789abcdef
  a = saved#[0..=3] ^ d#[4..=7]
  b = saved#[60..=63] ^ d#[56..=59]
  c = saved#[64..=67] ^ d#[68..=71]
  e = saved#[124..=127] ^ d#[120..=123]
  saved = d
}

test llvm_shared_word_lanes.offsets {
  mut dut = llvm_shared_word_lanes
  const initial = 0x9876543210fedcba0123456789abcdef
  tick 16 {
    dut.reset = clock == 0
    dut.d = initial ^ (clock * 0x11111111111111111111111111111111)
    step
    // The zero-latency outputs after step see the just-updated register.
    const saved_value = if clock == 0 { initial } else { dut.d }
    assert(dut.a == (saved_value#[0..=3] ^ dut.d#[4..=7]))
    assert(dut.b == (saved_value#[60..=63] ^ dut.d#[56..=59]))
    assert(dut.c == (saved_value#[64..=67] ^ dut.d#[68..=71]))
    assert(dut.e == (saved_value#[124..=127] ^ dut.d#[120..=123]))
  }
}
