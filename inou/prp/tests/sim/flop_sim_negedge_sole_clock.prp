/*
:name: flop_sim_negedge_sole_clock
:type: simulation
*/

// SILENT SIM MISCOMPILE (fixed). A design whose ONLY clock is an explicit
// `clock_pin=<net>` -- i.e. NO register sits on the implicit reference clock --
// got no edge detection at all: `inou.cgen.sim` adopted that net as the reference
// clock WAVEFORM instead of treating it as an edge-carrying signal, so every
// register on it committed on EVERY tick. A `posclk=false` flop then updated at
// the rises too, one commit per tick instead of one per fall.
//
// It reported 0 errors and 0 warnings. Nothing in the log said the edge was
// dropped; the design simply ran a cycle fast.
//
// WHERE IT CAME FROM. minion's `prim_rf_1r1w_diff_preview` (the frontend
// instruction buffer, `u_inst_data`) is exactly this shape -- its only clocks
// are explicit ports, and its write port is
//     always_ff @(negedge rf_clk_i) if (wr_data_en_1p_q[j]) mem[..] <= ..
// so the buffer write landed ONE CYCLE EARLY, capturing the previous (empty)
// fetch line, and the core replayed pc=0 forever (1,428 retired instructions in
// 20k cycles where Verilator retires 12,240 on the same RTL).
//
// The Pyrope form (2026-10-04) has ONE `Clock` port, the tick's own clock: every
// flop is `posclk=false` on it, and a transparent-LOW latch (`enable=clk,
// enable_high=false`) qualifies one of them. The original two-port form (a
// `pclk`/`rclk` pair the testbench drove as complementary Bool waveforms) cannot
// be written under the `Clock` type; its Verilog twin (lhd/tests/
// sim_negsole_standin.v) keeps that coverage. SCHEDULE VALIDATED AGAINST IVERILOG
// on the netlist LiveHD emits (clock low, inputs, rise, fall, sample).
//
// The three flops are the SAME assertion under the three write shapes minion
// actually uses, so a partial fix cannot go green: unconditional, enable from
// an input, and enable through a transparent-LOW latch (the preview protocol).
pub mod negsole(clk:Clock, en:Bool, d:U8) -> (qa:U8@[1], qb:U8@[0], qc:U8@[0]) {
  reg en_q:Bool:[latch=true, enable=clk, enable_high=false] = nil  // transparent while clk is LOW
  reg ma:U8:[clock_pin=clk, posclk=false] = 0    // (a) unconditional
  reg mb:U8:[clock_pin=clk, posclk=false] = 0    // (b) enable from an input
  reg mc:U8:[clock_pin=clk, posclk=false] = 0    // (c) enable through the latch
  qa = ma
  qb = mb
  qc = mc
  en_q = en
  ma = d
  if en {
    mb = d
  }
  if en_q {
    mc = d
  }
}

test negsole.negedge_commits_at_the_fall {
  mut acc = negsole
  tick 10 {
    // `clk` is the tick's own Clock, never driven by the testbench: each tick is
    // one period, and every flop here commits at that period's FALL (there is no
    // posedge flop, so nothing sits on the reference rise).
    acc.en = (clock >= 4) and (clock <= 7)
    acc.d  = 100 + clock
    step
    // (a) UNCONDITIONAL: a negedge flop takes d at every fall.
    assert(acc.qa == 100 + clock, "negedge flop takes d at the fall")
    // (b)/(c) the same flop with a write enable, from an input and from the
    // transparent-LOW latch (it closes at the rise, so the fall sees this tick's
    // `en`). en is high over ticks 4..7, so the last write is the fall of tick 7.
    if clock <= 3 {
      assert(acc.qb == 0, "enabled negedge flop has not written before the first enabled fall")
      assert(acc.qc == 0, "latch-enabled negedge flop has not written before the first enabled fall")
    }
    if (clock >= 4) and (clock <= 7) {
      assert(acc.qb == 100 + clock, "enabled negedge flop writes at every enabled fall")
      assert(acc.qc == 100 + clock, "latch-enabled negedge flop writes at every enabled fall")
    }
    if clock >= 8 {
      assert(acc.qb == 107, "enabled negedge flop holds the tick-7 value once en drops")
      assert(acc.qc == 107, "latch-enabled negedge flop holds the tick-7 value once en drops")
    }
  }
}
