/*
:name: conditional_latch_call
:type: simulation
*/

mod conditional_latch_inner(gate:bool, d:u8) -> (q:u8@[0]) {
  reg l:u8:[latch=true]
  q = l
  if gate {
    l = d
  }
}

pub mod conditional_latch_top(active:bool, gate:bool, d:u8) -> (q:u8@[0]) {
  q = 0
  if active {
    q = conditional_latch_inner(gate=gate, d=d)
  }
}

test conditional_latch_top.activation_holds_latch {
  mut dut = conditional_latch_top
  mut bad = 0
  tick 5 {
    dut.active = (clock == 0) or (clock >= 3)
    dut.gate = true
    dut.d = 10 + clock
    step
    if clock == 0 {
      if dut.q != 10 { bad = bad + 1 }
    } elif clock == 1 or clock == 2 {
      if dut.q != 0 { bad = bad + 1 }
    } else {
      if dut.q != 10 + clock { bad = bad + 1 }
    }
  }
  assert(bad == 0, "inactive conditional calls mask output and hold latch state")
}
