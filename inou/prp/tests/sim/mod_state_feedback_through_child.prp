/*
:name: mod_state_feedback_through_child
:type: simulation
*/

// A caller ring through a child's REGISTER is sequential, not combinational
// (lhdtrack suggestions 2.1, the br_arb_rr grant/priority shape). `st.q` is a
// pure read of the state register `r`; the fed-back `d` only reaches `r`'s NEXT
// value, so the ring `gr -> st.d -> r -> st.q -> gr` is cut by a flop.
//
// Before the 2.1 fix, upass.tolg's time-checker modeled a Sub instance as a
// crossbar (every input feeds every output), found the SCC
// `gr -> st -> m -> gr` with no flop in the CALLER and refused the design:
//   upass.tolg: combinational loop in 'mod_state_feedback_through_child.top'
// The wire-level check (resolve_wire_selfref) already followed the child's
// per-output cones and accepted this shape; the SCC check now agrees with it.
// No `::[timecheck=false]` anywhere: the fix must accept the plain spelling.
//
// The child is in the SAME file (lowered before its caller). The imported
// spelling is equiv/state_feedback_import.prp; the per-output case is
// sim/mod_state_feedback_mixed_outputs.prp; the real-loop guards are
// errors/comb_loop_through_mealy_child.prp and imports/comb_loop_import_mealy.prp.
mod st(rst:Reset, en:Bool, d:U4) -> (q:U4@[0]) {
  reg r:U4:[reset_pin=rst] = 8
  if en { r = d }
  q = r
}

pub mod top(rst:Reset, req:U4) -> (g:U4@[0], s:U4@[0]) {
  wire gr:U4 = nil
  const m = st(rst=rst, en=req != 0, d=gr)
  gr = req & ~m
  g = gr
  s = m
}

test top.grant_feeds_child_state {
  mut dut  = top
  mut r:U4 = 8
  mut bad  = 0
  mut seen = 0
  tick 12 {
    mut rq:U4 = 0
    if clock == 2 { rq = 5 }
    if clock == 3 { rq = 15 }
    if clock == 5 { rq = 3 }
    if clock == 6 { rq = 12 }
    if clock == 8 { rq = 10 }
    if clock == 9 { rq = 6 }
    dut.rst = clock == 0
    dut.req = rq
    // Golden next state: r' = (req != 0) ? (req & ~r) : r; reset forces 8.
    if clock == 0 {
      r = 8
    } elif rq != 0 {
      r = rq & ~r
    }
    step
    seen = seen + 1
    // After `step` the child's register holds r', and the grant is this
    // cycle's (still-driven) request masked by it.
    if dut.s != r { bad = bad + 1 }
    if dut.g != (rq & ~r) { bad = bad + 1 }
  }
  assert(seen == 12, "the comparisons ran (guards against a vacuous pass)")
  assert(bad == 0, "the child's state register loads the grant fed back through the wire")
}
