/*
:name: array_dims_and_signed_lanes
:type: simulation
*/
// Merged fixture: each section below is the original tests/sim fixture listed in its banner,
// body unchanged (module and test names are unique across the sections).

// ============================================================
// from array_dim_comptime_expr.prp
// ============================================================
// Related to lhdtrack suggestions.md 2.2(b): an array DIMENSION written as a
// compile-time EXPRESSION must fold like a bare name does. The runner folded
// only a BARE name in the OUTER dim (bake_decl_pre_step; copy_subtree_into for
// a generic) and kept anything else as the raw text, so
//   * `reg r:[N+1]U4` -> "upass.tolg: memory 'r' size '[N+1]' is not a
//     positive comptime constant" -- with a body `comptime const N` AND with a
//     generic N;
//   * `mut t:[N*2]U4` -> "array 't' size '[N*2]' is not a positive comptime
//     constant (a named constant must fold before lowering)";
//   * `reg m:[N][N]U1` with a body `comptime const N` -> "memory 'm' size '[N]'
//     is not a positive comptime constant" (a named INNER dim was never
//     folded; the same 2-D shape with a GENERIC N already worked).
// `comptime const W = N + 1` then `[W]U4` was the workaround.
mod gdims<N=2>(en:Bool, d:U4) -> (q:U4@[0], s:U4@[0]) {
  reg r:[N+1]U4 = 0
  if en { r[N] = d }
  q = r[N]

  mut t:[N*2]U4 = 0
  t[N*2-1] = d
  s = t[N*2-1]
}

pub mod array_dim_comptime_expr(en:Bool, d:U4) -> (q:U4@[0], s:U4@[0], b:U1@[0], gq:U4@[0], gs:U4@[0]) {
  comptime const N = 4
  reg r:[N+1]U4 = 0
  if en { r[N] = d }
  q = r[N]

  mut t:[N*2]U4 = 0
  t[N*2-1] = d
  s = t[7]

  reg m:[N][N]U1 = 0
  if en { m[N-1][N-1] = d#[0] }
  b = m[3][3]

  const g = gdims<N=3>(en=en, d=d)
  gq = g.q
  gs = g.s
}

test array_dim_comptime_expr.values {
  mut dut  = array_dim_comptime_expr
  mut s_ok = true
  tick 6 {
    dut.reset = clock == 0
    dut.en    = clock == 1
    dut.d     = if clock == 1 { 11 } else { 6 }
    step
    if dut.s != dut.d or dut.gs != dut.d { s_ok = false }
  }
  assert(s_ok, "t:[N*2]u4 lane 2N-1 follows d")
  assert(dut.q == 11, "r:[N+1]u4 lane N")
  assert(dut.b == 1, "m:[N][N]u1 lane (3,3)")
  assert(dut.gq == 11, "generic r:[N+1]u4 lane N")
}

// ============================================================
// from array_elem_signed_read.prp
// ============================================================
// Reading an element of a SIGNED `mut` array into a WIDER consumer must
// sign-extend. It did not for a comptime index: upass.tolg stamped the sign on
// the element's Get_mask driver (unsigned by construction) and cprop's
// constant-slice fold dropped it, so `a[0] = -3; y:S12 = a[0]` read 253. A
// runtime index, a `reg` array, a scalar, and a same-width consumer were
// always right — each is a control here, so a regression names its path.
// Found by the matched_filter_4 loop variant (an S8 product array copied into
// an S12 tree array, REFUTED against its own base).

pub mod comptime_index(x:S4) -> (y:S12@[0]) {
  mut a:[2]S8 = 0
  a[0] = x
  a[1] = x + 1
  y = a[0] + a[1]
}
pub mod runtime_index(x:S4, k:U1) -> (y:S12@[0]) {
  mut a:[2]S8 = 0
  a[0] = x
  a[1] = x
  y = a[k]
}
pub mod reg_array(x:S4) -> (y:S12@[0]) {
  reg a:[2]S8 = 0
  a[0] = x
  y = a[0]
}
pub mod same_width(x:S4) -> (y:S12@[0]) {
  mut a:[2]S12 = 0
  a[0] = x
  a[1] = x + 1
  wrap y = a[0] + a[1]
}
pub mod value_iteration(x:S4) -> (y:S12@[0]) {
  mut a:[2]S8 = 0
  a[0] = x
  a[1] = x + 1
  mut acc:S12 = 0
  for p in a {
    acc = acc + p
  }
  y = acc
}

test array_elem.signed_read {
  mut m1 = comptime_index
  mut m2 = runtime_index
  mut m3 = reg_array
  mut m4 = same_width
  mut m5 = value_iteration
  tick 3 {
    m1.x = -3
    m2.x = -3
    m2.k = 1
    m3.x = -3
    m4.x = -3
    m5.x = -3
    step
    assert(m1.y == -5, "comptime index: -3 + -2")
    assert(m2.y == -3, "runtime index")
    assert(m4.y == -5, "same-width element")
    assert(m5.y == -5, "value iteration over the array")
    if clock > 0 {
      assert(m3.y == -3, "reg array")
    }
  }
}

// ============================================================
// from array_output_signed_lanes.prp
// ============================================================
// An array OUTPUT with SIGNED elements built lane by lane (ruling 15). Lane 0
// used to be judged as the whole packed port -- an UNSIGNED [0, 65535] -- so
// any negative value there was a false "may not fit its declared range"
// overflow; every lane is an element of its own type.
mod mk(a:S8) -> (r:[2]S8@[0]) {
  r[1] = a
  r[0] = -3
}
comb mkc(a:S8) -> (r:[2]S8) {
  r[1] = -4
  r[0] = a
}

pub mod array_output_signed_lanes(a:S8) -> (o0:S8@[0], o1:S8@[0], c0:S8@[0], c1:S8@[0]) {
  const m:[2]S8 = mk(a=a)
  o0 = m[0]
  o1 = m[1]
  const k:[2]S8 = mkc(a=a)
  c0 = k[0]
  c1 = k[1]
}

test array_output_signed_lanes.t {
  mut dut = array_output_signed_lanes
  mut bad = 0
  tick 6 {
    dut.a = clock - 3
    step
    if dut.o0 != -3 or dut.o1 != clock - 3 { bad += 1 }
    if dut.c0 != clock - 3 or dut.c1 != -4 { bad += 1 }
  }
  assert(bad == 0, "signed lanes of an array output")
}
