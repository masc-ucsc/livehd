/*
:name: loop_false_loop_moore_child
:type: simulation
:expect_instances: u_loop*=2
*/

// lhdtrack suggestions 1.3 / 2.1 shape (br_arb_rr_internal): an arbiter whose grant
// goes through a `wire` into a child that REGISTERS it, and whose output
// depends on that child's registered state. The only path from `d` to `q` in
// `fb_state` is through `r`, so the ring is false (a Moore child).
//
// At the top of a simulation the occurrence-wide colour plan orders it
// correctly. Put the arbiter inside a rolled `for`, and the loop body is
// emitted per module: the Moore child is pre-bound from `m.__out` and its
// state-advancing call is deferred, but the settle (post-fall) pass never
// calls `m.__compact_publish()`, so `m.__out.q` is frozen at the value the
// reset published. The register updates; every read of it sees 8 forever.
//
// WHY `::[timecheck=false]`: the false loop through the child's register is
// refused by upass.tolg today (the child is modeled as a crossbar, lhdtrack
// suggestions 2.1). The attribute is the documented escape hatch that turns
// off every timing check in `fb_arb`; the fixture must keep passing once 2.1
// is fixed and the attribute is no longer needed.
//
// `:expect_instances: u_loop*=2`: both `j` loops stay rolled (the bug lives
// only on the rolled path).
//
// `fb_top_reg` feeds the same array only to a root register. Nothing reads the
// loop after the edge, so the root never runs the loop's post-edge publish:
// the child's `__out` is fresh only because the kernel republishes it right
// after the deferred advance (a settle-only republish left it at 8 forever).
//
// Same values as `--set compile.unroll=true` (which passes today; today's
// rolled lowering gets bad == 11 of 12, `r` stuck at its reset value 8).
mod fb_state(rst:Reset, en:Bool, d:U4) -> (q:U4@[0]) {
  reg r:U4:[reset_pin=rst] = 8
  if en { r = d }
  q = r
}

mod fb_arb::[timecheck=false](rst:Reset, req:U4) -> (g:U4@[0]) {
  wire gr:U4 = nil
  const m = fb_state(rst=rst, en=req != 0, d=gr)
  gr = req & ~m
  g  = gr
}

pub mod fb_top(rst:Reset, req:U8) -> (g:U8@[0]) {
  mut acc:U8 = 0
  for j in 0..<2 {
    const a = fb_arb(rst=rst, req=req#[(j * 4)..+4])
    acc#[(j * 4)..+4] = a
  }
  g = acc
}

pub mod fb_top_reg(rst:Reset, req:U8) -> (s:U8@[]) {
  mut acc:U8 = 0
  for j in 0..<2 {
    const a = fb_arb(rst=rst, req=req#[(j * 4)..+4])
    wrap acc = acc | (a << (j * 4))
  }
  reg sr:U8 = 0
  sr = acc
  s  = sr
}

test fb_top.child_state_reaches_the_grant {
  mut x    = fb_top
  mut r0:U4 = 8
  mut r1:U4 = 8
  mut bad  = 0
  mut seen = 0
  tick 12 {
    const rq:U8 = (clock * 37 + 11) & 0xFF
    x.rst = clock < 1
    x.req = rq
    step
    const q0:U4 = rq#[0..<4]
    const q1:U4 = rq#[4..<8]
    if clock == 0 {
      r0 = 8
      r1 = 8
    } else {
      // the child register loads this cycle's grant; outputs are read after step
      if q0 != 0 { r0 = q0 & ~r0 }
      if q1 != 0 { r1 = q1 & ~r1 }
    }
    const gexp:U8 = ((q1 & ~r1) << 4) | (q0 & ~r0)
    seen += 1
    if x.g != gexp { bad += 1 }
  }
  assert(seen == 12, "the comparisons ran")
  assert(bad == 0, "the arbiter sees its child's CURRENT register, not the reset value")
}

test fb_top_reg.registered_grant_sees_child_state {
  mut x     = fb_top_reg
  mut r0:U4 = 8
  mut r1:U4 = 8
  mut bad   = 0
  mut seen  = 0
  tick 12 {
    const rq:U8 = (clock * 37 + 11) & 0xFF
    x.rst = clock < 1
    x.req = rq
    step
    const q0:U4 = rq#[0..<4]
    const q1:U4 = rq#[4..<8]
    // `sr` captured this cycle's grant, computed from the child register
    // BEFORE the edge
    const g0:U4 = q0 & ~r0
    const g1:U4 = q1 & ~r1
    if clock == 0 {
      r0 = 8
      r1 = 8
    } else {
      if q0 != 0 { r0 = g0 }
      if q1 != 0 { r1 = g1 }
      const sexp:U8 = (g1 << 4) | g0
      seen += 1
      if x.s != sexp { bad += 1 }
    }
  }
  assert(seen == 11, "the comparisons ran")
  assert(bad == 0, "a register fed only by the loop sees the child's CURRENT state")
}
