/*
:name: flop_feeds_transparent_high_latch
:type: simulation
*/

// todo/livehd/3d-sim-color B: event-semantics carve-out from the retired
// module scheduler. At the rising edge `f` takes d. The high-transparent latch
// remains open after that edge, so it observes the NEW f and closes with that
// value at the fall. Sampling f before its rise commit makes h one period late.
// //lhd/tests:sim_color_latch_oracle checks that this shape selects the
// color-direct schedule; with LHD_EXTERNAL_SIM=1 it also runs the matching
// independent always_ff/always_latch Icarus oracle.
pub mod flop_high_latch(clk:Clock, d:U8) -> (qf:U8@[1], qh:U8@[1]) {
  reg f:U8:[clock_pin=clk] = 0
  reg h:U8:[latch=true, enable=clk] = 0
  qf = f
  qh = h
  f = d
  h = f
}

test flop_high_latch.post_rise_value_flows_through_open_latch {
  mut acc = flop_high_latch
  tick 6 {
    const dv = 11 + (17 * clock)
    acc.d = dv
    step
    assert(acc.qf == dv, "posedge flop captured this period's input")
    assert(acc.qh == dv, "transparent-high latch observed the flop's post-rise value before closing")
  }
}
