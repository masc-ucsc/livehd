/*
:name: flop_sim_secondary_negedge
:type: simulation
*/

// todo/livehd/2f-latch — SILENT SIM BUG TRACKER (2026-07-25 audit).
// FIXED 2026-08-02: this is now a live regression; the failure description
// below records the pre-fix behavior.
//
// A NEGEDGE flop in a SECOND clock domain never commits. This is M6's
// detected-edge model crossed with M5's two-phase tick, and the crossing is
// where it breaks.
//
// WHAT WAS WRONG (pre-fix). cgen_sim updated the per-net previous-level bit
// (`__clkprev_clkb = <current level>`) AFTER the phase-1 commits but BEFORE the
// phase-2 block. Phase 2 then built the negedge guard as `(!cur && prev)` --
// but `prev` had already been assigned `cur`, so the guard was a tautological
// false and the flop held its power-on value forever. `lhd sim` reported 0
// errors and the VCD showed the net simply never changing.
//
// The second domain is the reference clock gated by `en_b` (`Clock(clock_pin=,
// enable=)`; under the `Clock` type a test cannot drive a second Clock as a
// waveform, but it can drive the gate's enable). A tick whose enable is high
// lets BOTH edges of that tick through: the posedge flop commits at the rise
// and the negedge flop at the fall, which already sees the reference-clock
// stage `a` committed at the same rise.
//
// The POSEDGE sibling on the SAME gated clock is the NON-VACUITY CONTROL: a
// failure below is specifically the NEGEDGE guard -- not a gate that never opens.
// `a` on the REFERENCE clock is what makes the gated clock a genuine SECOND
// domain.
//
// SCHEDULE VALIDATED AGAINST IVERILOG on the netlist LiveHD emits (enable high
// at ticks 1 and 3; the golden drives enable while clk is low, then rise, fall):
//     k  :  0   1   2   3   4
//     qa : 11  28  45  62  79
//     qp :  0  11  11  45  45     (rise: takes the PRE-edge a)
//     qn :  0  28  28  62  62     (fall: takes the post-rise a)
pub mod secneg(clk:Clock, en_b:Bool, d:U8) -> (qa:U8@[1], qp:U8@[2], qn:U8@[2]) {
  const clkb = Clock(clock_pin=clk, enable=en_b)
  reg a:U8 = 0
  reg bp:U8:[clock_pin=clkb] = 0
  reg bn:U8:[clock_pin=clkb, posclk=false] = 0
  qa = a
  qp = bp
  qn = bn
  a  = d
  bp = a
  bn = a
}

test secneg.second_domain_negedge_commits {
  mut acc = secneg
  tick 5 {
    acc.en_b = (clock == 1) or (clock == 3)   // the gate opens on ticks 1 and 3
    acc.d    = 11 + (17 * clock)
    step
    // CONTROL 1: the reference-clock stage commits every tick.
    assert(acc.qa == 11 + (17 * clock), "the reference-clock stage commits every tick (control)")
    // CONTROL 2: the POSEDGE sibling on the SAME gated clock commits at the
    // rises (ticks 1 and 3), taking the pre-edge `a`.
    assert((clock == 0) implies (acc.qp == 0), "the posedge flop has not seen a gated rise yet (control)")
    assert(((clock == 1) or (clock == 2)) implies (acc.qp == 11), "posedge flop took a from tick 0 at the tick-1 rise (control)")
    assert((clock >= 3) implies (acc.qp == 45), "posedge flop took a from tick 2 at the tick-3 rise (control)")
    // THE BUG: the negedge flop commits at the FALL of each open tick, where it
    // reads the already-committed `a`. Pre-fix its commit guard was a dead `false`.
    assert((clock == 0) implies (acc.qn == 0), "the negedge flop holds its init before the first open tick")
    assert(((clock == 1) or (clock == 2)) implies (acc.qn == 28), "the negedge flop committed at the tick-1 fall, and holds")
    assert((clock >= 3) implies (acc.qn == 62), "the negedge flop committed at the tick-3 fall")
  }
}
