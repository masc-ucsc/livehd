/*
:name: array_elem_signed_read
:type: simulation
*/
// Reading an element of a SIGNED `mut` array into a WIDER consumer must
// sign-extend. It did not for a comptime index: upass.tolg stamped the sign on
// the element's Get_mask driver (unsigned by construction) and cprop's
// constant-slice fold dropped it, so `a[0] = -3; y:s12 = a[0]` read 253. A
// runtime index, a `reg` array, a scalar, and a same-width consumer were
// always right — each is a control here, so a regression names its path.
// Found by the matched_filter_4 loop variant (an s8 product array copied into
// an s12 tree array, REFUTED against its own base).

pub mod comptime_index(x:s4) -> (y:s12@[0]) {
  mut a:[2]s8 = 0
  a[0] = x
  a[1] = x + 1
  y = a[0] + a[1]
}
pub mod runtime_index(x:s4, k:u1) -> (y:s12@[0]) {
  mut a:[2]s8 = 0
  a[0] = x
  a[1] = x
  y = a[k]
}
pub mod reg_array(x:s4) -> (y:s12@[0]) {
  reg a:[2]s8 = 0
  a[0] = x
  y = a[0]
}
pub mod same_width(x:s4) -> (y:s12@[0]) {
  mut a:[2]s12 = 0
  a[0] = x
  a[1] = x + 1
  y = a[0] + a[1]
}
pub mod value_iteration(x:s4) -> (y:s12@[0]) {
  mut a:[2]s8 = 0
  a[0] = x
  a[1] = x + 1
  mut acc:s12 = 0
  for p in a {
    acc = acc + p
  }
  y = acc
}

test array_elem.signed_read {
  mut m1 = comptime_index
  mut m2 = runtime_index
  mut m3 = reg_array
  mut m4 = same_width
  mut m5 = value_iteration
  tick 3 {
    m1.x = -3
    m2.x = -3
    m2.k = 1
    m3.x = -3
    m4.x = -3
    m5.x = -3
    step
    assert(m1.y == -5, "comptime index: -3 + -2")
    assert(m2.y == -3, "runtime index")
    assert(m4.y == -5, "same-width element")
    assert(m5.y == -5, "value iteration over the array")
    if clock > 0 {
      assert(m3.y == -3, "reg array")
    }
  }
}
