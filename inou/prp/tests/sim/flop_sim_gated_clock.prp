/*
:name: flop_sim_gated_clock
:type: simulation
*/

// todo/livehd/2f-latch — LIVE (promoted at M5). GATED CLOCK, the sim half of the
// clock-blindness bug (LEC half: lhd/tests/lec_clock_blindness_test.sh). The
// flop is clocked by `clk` gated by `en` (a `Clock(clock_pin=, enable=)`
// Clock_cell, an ICG that latches `en` while `clk` is low): while en == 0 there
// is no rising edge and the flop must HOLD. Before M5 `lhd sim` computed the
// gate as DEAD CODE and committed the flop every tick, so the holds below
// failed while the run reported success on the load.
//
// Validated against iverilog (a latch ICG, en changed while clk is low):
// q = 5,6,6,6.
pub mod gate8(clk:Clock, en:Bool, d:U8) -> (q:U8@[1]) {
  const gclk = Clock(clock_pin=clk, enable=en)   // the ICG (ruling 56)
  reg f:U8:[clock_pin=gclk] = 0
  q = f
  f = d
}

test gate8.hold_while_gated {
  mut acc = gate8
  tick 4 {
    // c0: en=1 load 5; c1: en=1 load 6; c2-c3: en=0 -> no edge, HOLD 6
    acc.en = clock <= 1
    mut dv:U8 = 5
    if clock == 1 {
      dv = 6
    } elif clock == 2 {
      dv = 99
    } elif clock == 3 {
      dv = 77
    }
    acc.d = dv
    step
    if clock == 1 {
      assert(acc.q == 6, "enabled: the gated flop loads")
    }
    if clock >= 2 {
      assert(acc.q == 6, "en=0: no rising edge on the gated clock, flop HOLDS")
    }
  }
}
