/*
:name: mem_ordering_and_reset_lane
:type: simulation
*/
// Merged fixture: each section below is the original tests/sim fixture listed in its banner,
// body unchanged (module and test names are unique across the sections).

// ============================================================
// from mem_index_mod_size.prp
// ============================================================

// upass.bitwidth's index-out-of-range check judges the index RANGE, not its
// bit width: a 3-entry memory indexed by `i % 3` (a U4 whose value stays in
// [0, 2]) is legal, non-power-of-two size and all.
pub mod mem3(x:U8, wa:U4, ra:U4) -> (y:U8@[0]) {
  reg a:[3]U8 = 0
  a[wa % 3] = x
  y = a[ra % 3]
}

test mem3.mod_index {
  mut d = mem3
  tick 6 {
    d.x  = clock + 10
    d.wa = clock + 3     // entries 0, 1, 2, 0, 1, 2
    d.ra = clock + 5     // reads the entry written one cycle earlier
    step
    if clock >= 1 {
      assert(d.y == clock + 9, "mem[(clock + 5) % 3] holds the previous cycle's x")
    }
  }
}

// ============================================================
// from mem_reset_parallel.prp
// ============================================================
// A `reg` ARRAY's initializer is its RESET value, exactly like a scalar reg's
// (`reg m:[4]U4 = 7` ≡ every entry resets to 7), and the reset is PARALLEL:
// every entry is restored in ONE cycle of reset through the memory's
// whole-array reset pin. These two tests pin that timing — the design is
// identical, only the length of the reset pulse differs, and both restore the
// whole array.
//
// (`= nil` would mean NO reset value at all: no reset is bound. See
// ../equiv/mem_ordering_old.prp.)
mod arr(we:Bool, waddr:U2, din:U4, raddr:U2) -> (o:U4@[0]) {
  reg m:[4]U4:[ordering="old"] = 7
  o = m[raddr]
  if we { m[waddr] = din }
}

// ONE reset cycle restores EVERY entry. Fill every entry with 0xA out of
// reset, pulse reset for a single cycle, then read all four back.
test arr.one_reset_cycle {
  mut d  = arr
  mut e0 = nil
  mut e1 = nil
  mut e2 = nil
  mut e3 = nil
  tick 20 {
    d.reset = clock == 6  // a single reset cycle, well after the fill
    d.we    = clock < 4
    d.waddr = clock
    d.din   = 0xA
    d.raddr = clock - 10
    step
    if clock == 10 { e0 = d.o }
    if clock == 11 { e1 = d.o }
    if clock == 12 { e2 = d.o }
    if clock == 13 { e3 = d.o }
  }
  assert(e0 == 7, "entry 0 restored by the single reset cycle")
  assert(e1 == 7, "entry 1 restored by the single reset cycle")
  assert(e2 == 7, "entry 2 restored by the single reset cycle")
  assert(e3 == 7, "entry 3 restored by the single reset cycle")
}

// A longer reset pulse restores the same whole array. Same fill, same reads,
// a 4-cycle pulse instead of a 1-cycle one.
test arr.full_reset_window {
  mut d  = arr
  mut e0 = nil
  mut e1 = nil
  mut e2 = nil
  mut e3 = nil
  tick 20 {
    d.reset = clock >= 6 and clock < 10  // 4 cycles = the array size
    d.we    = clock < 4
    d.waddr = clock
    d.din   = 0xA
    d.raddr = clock - 10
    step
    if clock == 10 { e0 = d.o }
    if clock == 11 { e1 = d.o }
    if clock == 12 { e2 = d.o }
    if clock == 13 { e3 = d.o }
  }
  assert(e0 == 7, "entry 0 restored")
  assert(e1 == 7, "entry 1 restored")
  assert(e2 == 7, "entry 2 restored")
  assert(e3 == 7, "entry 3 restored")
}

// ============================================================
// from mem_ordering_sim.prp
// ============================================================
// Simulation of all four same-cycle `ordering` modes, one memory each. Each
// lowers to a distinct hlop::Memory_* type (hlop/memory.hpp), so this is the
// end-to-end check that cgen.sim picks the right one and that the staged-write
// protocol commits as the cgen_memory_*.v wrapper does.
//
// Every memory is written at address `wa` with `wd` and read at the same
// address, so every read is an in-design collision resolved by its mode:
//
//   ordering="old"      -> the committed (previous-cycle) value
//   ordering="fwd"      -> the new data, even though the read precedes the write
//   ordering="program"  -> old before the write, new after it
//   ordering="none"     -> UNDEFINED (a PRNG draw in Slop), so only the
//                          NON-colliding address is asserted here
//
// WHAT THIS FIXTURE CAN AND CANNOT SEE (bare dotted reads + `regref` writes).
// A testbench read is a reference into the outputs `step` settled, and `step` is
// settle -> commit -> settle. Both settles run with the SAME driven inputs, so
// by the time a read can happen the write has committed and every mode reads the
// same committed word: the four collision modes are indistinguishable from
// outside the design. This fixture used to see the difference only because each
// pre-`step` read was its own `peek()` — a fresh recompute against the
// just-driven inputs, with no commit — and `peek` is gone.
//
// So the same-cycle COLLISION semantics is gated elsewhere, and more strongly:
// prp-equiv-mem_ordering_{old,fwd,program,none} LEC each mode against a Verilog
// golden, and prp-v2prp2v-mem_ordering_{old,fwd,program,none} round-trip it.
// Do NOT re-add pre-`step` reads here to "restore" the distinction — they would
// assert one-cycle-stale values, which is how this fixture failed when the model
// changed.
//
// What is still checked here, and is worth checking: all four memory types
// COMMIT correctly through cgen.sim, a non-colliding read is defined, and the
// read-modify-write chain (a write whose data depends on an earlier read of the
// same memory) simulates as legal hardware rather than being mis-scheduled as a
// combinational cycle — the reason `m_rmw` is in this fixture at all.
mod ord_sim(wa:U2, wd:U4, ra:U2) -> (o_old:U4@[0], f_pre:U4@[0], p_pre:U4@[0], p_post:U4@[0], n_clean:U4@[0], rmw_pre:U4@[0], rmw_post:U4@[0]) {
  reg m_old:[4]U4:[ordering="old"] = 0
  o_old      = m_old[wa]
  m_old[wa]  = wd

  reg m_fwd:[4]U4:[ordering="fwd"] = 0
  f_pre      = m_fwd[wa]        // read BEFORE the write: fwd is position-blind
  m_fwd[wa]  = wd

  reg m_prog:[4]U4:[ordering="program"] = 0
  p_pre      = m_prog[wa]       // read BEFORE the write -> old
  m_prog[wa] = wd
  p_post     = m_prog[wa]       // read AFTER the write  -> new

  reg m_none:[4]U4:[ordering="none"] = 0
  m_none[wa] = wd
  n_clean    = m_none[ra]       // a DIFFERENT address: no collision, so defined

  // Read-modify-write under the default ordering: the write's data DEPENDS on
  // an earlier read of the same memory. That is legal hardware (the read takes
  // the array, not the write's data), but it is a false combinational cycle for
  // any codegen that stages the write before the read it feeds on.
  reg m_rmw:[4]U4:[ordering="program"] = 0
  const seen = m_rmw[wa]        // read BEFORE the write -> the committed value
  mut nxt:U4 = 0
  wrap nxt   = seen + 1
  m_rmw[wa]  = nxt              // ... which then drives the write
  rmw_pre  = seen
  rmw_post = m_rmw[wa]          // read AFTER the write -> forwards seen+1
}

test ord_sim.modes {
  mut acc      = ord_sim
  mut old_v    = nil
  mut fwd_v    = nil
  mut pre_v    = nil
  mut post_v   = nil
  mut clean_v  = nil
  mut rmw_a    = nil
  mut rmw_b    = nil

  // Write address 1 every cycle with `clock`, and read the untouched address 2
  // from the ordering="none" memory. The outputs are sampled AFTER `step` --
  // the only placement that observes this iteration's drives (see the header).
  tick 6 {
    acc.wa  = 1
    acc.wd  = clock
    acc.ra  = 2
    step
    old_v   = acc.o_old
    fwd_v   = acc.f_pre
    pre_v   = acc.p_pre
    post_v  = acc.p_post
    clean_v = acc.n_clean
    rmw_a   = acc.rmw_pre
    rmw_b   = acc.rmw_post
  }

  // The last edge committed clock=5 into address 1 of every memory, so each of
  // the four modes reads it back: post-commit they agree BY CONSTRUCTION, and
  // asserting all four separately is what pins that every memory type actually
  // committed (a mode whose write was dropped would read 4, or 0).
  assert(old_v == 5, "ordering=old: the committed word is the last one written")
  assert(fwd_v == 5, "ordering=fwd: committed")
  assert(pre_v == 5, "ordering=program: committed")
  assert(post_v == 5, "ordering=program: committed")
  assert(clean_v == 0, "ordering=none: a non-colliding address is still defined")
  // m_rmw[1] increments once per cycle -- seen+1 written back each edge -- so
  // after 6 committed cycles it holds 6. This is the read-modify-write chain:
  // if it were mis-scheduled as a combinational cycle, or the read were resolved
  // against the write it feeds, this would not count cleanly.
  assert(rmw_a == 6, "read-modify-write: 6 edges, +1 per edge")
  assert(rmw_b == 6, "read-modify-write: both reads see the same committed word")
}

// ============================================================
// from spec_memory_sim_default_program.prp
// ============================================================
// SPEC (qa.md appendix section 5): "Default ordering of `reg arr:[N]T` is "program";
// `ordering` may be set to "fwd"/"none"/"old" explicitly."
// SPEC (qa.md Q17): "Always, the Verilog and Pyrope should have the same result when
// run with icarus and lhd sim ... Overall, we always do program order unless we
// change the 'ordering' flag from memory explicitly".
// Rule encoded here: under `lhd sim`, a memory with NO ordering attribute resolves
// a same-cycle collision in program order. The design latches its own same-cycle
// reads into registers (a testbench read after `step` only sees committed state):
// `pre_r` (read before the write) must hold the OLD word, `post_r` (read after the
// write) the NEW one.
mod ord(we:Bool, wa:U2, wd:U4, ra:U2) -> (pre_q:U4@[1], post_q:U4@[1]) {
  reg mem:[4]U4 = nil
  reg pre_r:U4 = 0
  reg post_r:U4 = 0
  pre_q  = pre_r
  post_q = post_r
  pre_r  = mem[ra]
  if we {
    mem[wa] = wd
  }
  post_r = mem[ra]
}

test ord.program {
  mut d    = ord
  mut pre  = nil
  mut post = nil
  tick 3 {
    d.we = clock < 2
    d.wa = 1
    d.wd = if clock == 0 { 3 } else { 9 }
    d.ra = 1
    step
    if clock == 1 {
      pre  = d.pre_q
      post = d.post_q
    }
  }
  assert(pre == 3, "default ordering: a read BEFORE the write sees the old word")
  assert(post == 9, "default ordering: a read AFTER the write sees the new word")
}

// ============================================================
// from mem_bulk_vs_entry_order.prp
// ============================================================
// Ruling 45: a whole-array store (`mem = v`) and a per-entry write of the same
// cycle resolve in PROGRAM ORDER, like any two writes (docs 08-memories, "last
// write wins"). The per-entry write used to win whatever the order (a
// `memory-update-and-write` warning), so `ec` kept its entry through a later
// clear. Same shapes as equiv/mem_bulk_vs_entry_order.prp:
//
// * `ec`: entry write, then clear; `ce`: clear, then entry write.
// * `rl`: reset value; entry write, runtime whole-array load, entry write.
// * `pc`: whole-entry and lane write, then clear; `cp`: reset value; entry
//   write, clear, lane write.
// * `pr` (default program ordering): each read sees the writes before it, the
//   clear included; `pf` (ordering="fwd") sees the whole cycle. The reads of
//   the write cycle are captured into registers (`cap`), because a read below
//   `step` already sees the committed write.
// Writes happen on even cycles; the odd cycles write nothing and check.
mod mem_bulk_vs_entry_order(cap:Bool, wf:Bool, clr:Bool, we:Bool, ld:Bool, a:U2, d:U16, x:U8, z:U64, ra:U2) -> (ec_q:U16@[0], ce_q:U16@[0], rl_q:U16@[0], pc_q:U16@[0], cp_q:U16@[0], k1_q:U16@[0], k2_q:U16@[0], k3_q:U16@[0], kf_q:U16@[0]) {
  reg ec:[4]U16:[ordering="old"] = nil
  reg ce:[4]U16:[ordering="old"] = nil
  reg rl:[4]U16:[ordering="old"] = 0
  reg pc:[4]U16:[ordering="old"] = nil
  reg cp:[4]U16:[ordering="old"] = 0
  reg pr:[4]U16 = nil
  reg pf:[4]U16:[ordering="fwd"] = nil
  reg k1:U16 = 0
  reg k2:U16 = 0
  reg k3:U16 = 0
  reg kf:U16 = 0

  k1_q = k1
  k2_q = k2
  k3_q = k3
  kf_q = kf

  const f = pf[ra]

  if wf {
    ec[a] = d
  }
  if clr {
    ec = 0
  }

  if clr {
    ce = 0
  }
  if wf {
    ce[a] = d
  }

  if wf {
    rl[a] = d
  }
  if ld {
    rl = z
  }
  if we {
    rl[ra] = x
  }

  if wf {
    pc[a] = d
  }
  if we {
    pc[a]#[0..<8] = x
  }
  if clr {
    pc = 0
  }

  if wf {
    cp[a] = d
  }
  if clr {
    cp = 0
  }
  if we {
    cp[a]#[8..<16] = x
  }

  if wf {
    pr[a] = d
    pf[a] = d
  }
  const m1 = pr[ra]
  if clr {
    pr = 0
    pf = 0
  }
  const m2 = pr[ra]
  if we {
    pr[a]#[8..<16] = x
    pf[a]#[8..<16] = x
  }
  const m3 = pr[ra]

  if cap {
    k1 = m1
    k2 = m2
    k3 = m3
    kf = f
  }

  ec_q = ec[ra]
  ce_q = ce[ra]
  rl_q = rl[ra]
  pc_q = pc[ra]
  cp_q = cp[ra]
}

test mem_bulk_vs_entry_order.orders {
  mut t = mem_bulk_vs_entry_order
  tick 12 {
    const phase = clock >> 1
    const wr    = (clock & 1) == 0 and clock >= 2
    t.reset = clock < 2
    t.a     = 1
    t.ra    = 1
    t.z     = 0x4444_5555_6666_7777
    t.cap   = wr
    // phase 1: entry write only; 2: entry write + clear; 3: everything;
    // 4: entry write + load; 5: lane writes only.
    t.wf    = wr and phase != 5
    t.clr   = wr and (phase == 2 or phase == 3)
    t.we    = wr and (phase == 3 or phase == 5)
    t.ld    = wr and (phase == 3 or phase == 4)
    t.d     = if phase == 1 { 0x1111 } elif phase == 2 { 0x2222 } elif phase == 3 { 0x3333 } else { 0x5a5a }
    t.x     = if phase == 3 { 0xab } else { 0xcd }
    step
    if (clock & 1) == 1 and clock >= 3 {
      // Entry 1 of each memory after the write cycle, and the captured
      // program-order reads m1/m2/m3 and fwd read of that cycle (the fwd read
      // sees what m3, the last read, sees).
      const w_ec = if phase == 1 { 0x1111 } elif phase == 2 or phase == 3 { 0 } else { 0x5a5a }
      const w_ce = if phase == 1 { 0x1111 } elif phase == 2 { 0x2222 } elif phase == 3 { 0x3333 } else { 0x5a5a }
      const w_rl = if phase == 1 { 0x1111 } elif phase == 2 { 0x2222 } elif phase == 3 { 0x00ab } elif phase == 4 { 0x6666 } else { 0x00cd }
      const w_pc = if phase == 1 { 0x1111 } elif phase == 2 or phase == 3 { 0 } elif phase == 4 { 0x5a5a } else { 0x5acd }
      const w_cp = if phase == 1 { 0x1111 } elif phase == 2 { 0 } elif phase == 3 { 0xab00 } elif phase == 4 { 0x5a5a } else { 0xcd5a }
      const w_k1 = if phase == 1 { 0x1111 } elif phase == 2 { 0x2222 } elif phase == 3 { 0x3333 } else { 0x5a5a }
      const w_k2 = if phase == 1 { 0x1111 } elif phase == 2 or phase == 3 { 0 } else { 0x5a5a }
      const w_k3 = if phase == 1 { 0x1111 } elif phase == 2 { 0 } elif phase == 3 { 0xab00 } elif phase == 4 { 0x5a5a } else { 0xcd5a }
      assert(t.ec_q == w_ec, "entry write then clear: the clear wins")
      assert(t.ce_q == w_ce, "clear then entry write: the entry write wins")
      assert(t.rl_q == w_rl, "entry write, whole-array load, entry write: program order")
      assert(t.pc_q == w_pc, "entry and lane writes then clear: the clear wins")
      assert(t.cp_q == w_cp, "entry write, clear, lane write: the lane lands on the cleared entry")
      assert(t.k1_q == w_k1, "a program-order read sees the entry write before it")
      assert(t.k2_q == w_k2, "a program-order read sees the clear before it")
      assert(t.k3_q == w_k3, "a program-order read sees the lane write after the clear")
      assert(t.kf_q == w_k3, "a fwd read sees the entry as the whole cycle leaves it")
    }
  }
}

// ============================================================
// from mem_partial_write_ordering_old.prp
// ============================================================
// lhdtrack suggestions2.md 1.2 (mem_partial_write_ordering_old): two byte-lane
// writes to the SAME entry in one cycle kept only the last lane under
// `ordering="old"` (cycle 0 read back 0xaa00 for 0xaaaa, no diagnostic). A
// partial write `mem[a]#[..] = v` reads the entry, merges the lane and writes
// the entry back; its read must see the earlier writes of the same cycle
// whatever `ordering` says, or a later lane writes the old earlier lane back.
//
// Every memory takes the same byte-lane writes: `mo` is the 1.2 repro
// (ordering="old" with a `clock_pin`; lhd sim steps every clock, so `wclk`
// needs no driving), `mf` is ordering="fwd" (the partial writes used to be a
// combinational cycle through their own forwarding), `mn` is ordering="none"
// (the sim used to refuse a partial write after another write), `mr` has a
// reset value and `mu` a whole-array clear in the cycle of one write, which
// the lanes must land on. Writes happen on even cycles and the entry is read
// back on the odd ones, when nothing is written (an "none" read of an entry
// written in the same cycle is undefined).
// equiv/mem_partial_write_ordering_old.prp and mem_partial_write_update.prp
// prove the same shapes against Verilog goldens.
mod mem_partial_write_ordering_old(clk:Clock, wclk:Clock, we:U1, clr:U1, a:U2, d:U32, be:U4, ra:U2) -> (qo:U32@[0], qf:U32@[0], qn:U32@[0], qr:U32@[0], qu:U32@[0]) {
  reg mo:[4]U32:[ordering = "old", clock_pin = wclk] = nil
  reg mf:[4]U32:[ordering = "fwd", clock_pin = clk] = nil   // two Clock inputs: name it
  reg mn:[4]U32:[ordering = "none", clock_pin = clk] = nil
  reg mr:[4]U32:[ordering = "old", clock_pin = clk] = 0
  reg mu:[4]U32:[ordering = "old", clock_pin = clk] = nil
  if clr == 1 {
    mu = 0
  }
  if we == 1 {
    for w in 0..<4 {
      if be#[w] == 1 {
        mo[a]#[(w * 8)..+8] = d#[(w * 8)..+8]
        mf[a]#[(w * 8)..+8] = d#[(w * 8)..+8]
        mn[a]#[(w * 8)..+8] = d#[(w * 8)..+8]
        mr[a]#[(w * 8)..+8] = d#[(w * 8)..+8]
        mu[a]#[(w * 8)..+8] = d#[(w * 8)..+8]
      }
    }
  }
  qo = mo[ra]
  qf = mf[ra]
  qn = mn[ra]
  qr = mr[ra]
  qu = mu[ra]
}

test mem_partial_write_ordering_old.lanes {
  mut x = mem_partial_write_ordering_old
  tick 8 {
    const phase = clock >> 1
    x.a   = 1
    x.ra  = 1
    x.we  = U1((clock & 1) == 0)
    x.clr = U1(clock == 4)
    x.d   = if phase == 0 { 0xaaaa_aaaa } elif phase == 1 { 0x5555_5555 } elif phase == 2 { 0x1234_5678 } else { 0xffff_ffff }
    x.be  = if phase == 0 { 0xf } elif phase == 1 { 0x5 } elif phase == 2 { 0x6 } else { 0x9 }
    step
    if (clock & 1) == 1 {
      // The entry after the write cycle: every lane of it landed.
      const want = if phase == 0 { 0xaaaa_aaaa } elif phase == 1 { 0xaa55_aa55 } elif phase == 2 { 0xaa34_5655 } else { 0xff34_56ff }
      assert(x.qo == want, "every byte lane of one entry lands in the same cycle (ordering=old)")
      assert(x.qf == want, "every byte lane of one entry lands in the same cycle (ordering=fwd)")
      assert(x.qn == want, "every byte lane of one entry lands in the same cycle (ordering=none)")
      assert(x.qr == want, "every byte lane of one entry lands in the same cycle (reset value)")
      // `mu` was cleared in the cycle of the phase-2 write: the new lanes land
      // on the cleared entry.
      const want_u = if phase == 2 { 0x0034_5600 } elif phase == 3 { 0xff34_56ff } else { want }
      assert(x.qu == want_u, "the lanes land on a whole-array clear of the same cycle")
    }
  }
}

// ============================================================
// from mem_replay_crossref.prp
// ============================================================
// A same-cycle memory read that replays the cycle's earlier writes in logic
// may itself feed another replayed access; every such use must see the
// REPLAYED value. Same shapes as equiv/mem_replay_crossref.prp and
// equiv/mem_replay_whole_copy.prp: after a clear, `tv` and `id` are program-order
// reads that feed a write of `m` (data) and of `n` (address and data), a
// partial write of `n` merges over that write, `c = m` copies the replayed
// contents, and the valid bit `vl[ra]`, cleared in the same cycle, gates a
// write of `dt`. The replay once read the committed values there: `kr` saw
// the loaded 0x2a instead of 0x11, `n[1]` merged into 0x2a, `kc` read the
// committed m[0], and `dt[0]` took tv (0x15, not 0x2d) although its valid bit
// was cleared. The reads of the write cycle are captured into registers.
mod mem_replay_crossref(ld:Bool, clr:Bool, w:Bool, p:Bool, cp:Bool, cap:Bool, a:U2, d:U6, ra:U2, rb:U2, x:U3) -> (kt_q:U6@[0], kr_q:U6@[0], kc_q:U6@[0], q:U6@[0], c_q:U6@[0], qd:U6@[0]) {
  reg ix:[4]U2 = nil
  reg m:[4]U6 = nil
  reg n:[4]U6:[ordering="old"] = nil
  reg c:[4]U6 = nil
  reg vl:[4]Bool = false
  reg dt:[4]U6:[ordering="old"] = nil
  reg kt:U6 = 0
  reg kr:U6 = 0
  reg kc:U6 = 0

  kt_q = kt
  kr_q = kr
  kc_q = kc

  if ld {
    m[a]  = d
    ix[a] = d#[0..<2]
  }
  if w {
    vl[a] = true
  }
  if clr {
    ix = 1
    m  = 0x11
    vl = false
  }
  const tv = m[ra]
  const id = ix[ra]
  const g  = vl[ra]
  if w {
    m[a]  = tv
    n[id] = tv
  }
  if p {
    n[id]#[0..<3] = x
  }
  if g {
    dt[ra] = tv
  }
  if p {
    dt[ra]#[0..<3] = x
  }
  if cp {
    c = m
  }
  const r  = m[a]
  const cr = c[ra]
  if cap {
    kt = tv
    kr = r
    kc = cr
  }
  q   = n[rb]
  c_q = c[rb]
  qd  = dt[ra]
}

test mem_replay_crossref.chains {
  mut t = mem_replay_crossref
  tick 6 {
    t.reset = clock < 2
    t.ld    = clock == 2
    t.clr   = clock == 4
    t.w     = clock == 2 or clock == 4
    t.p     = clock == 4
    t.cp    = clock == 4
    t.cap   = clock == 4
    t.a     = if clock == 2 { 0 } else { 3 }
    t.d     = 0x2a
    t.ra    = 0
    t.rb    = 1
    t.x     = 5
    step
    if clock == 5 {
      assert(t.kt_q == 0x11, "a read after the clear sees the clear")
      assert(t.kr_q == 0x11, "a read after `m[a] = tv` sees the replayed tv")
      assert(t.kc_q == 0x11, "the copy `c = m` stores m as the clear left it")
      assert(t.q == 0x15, "the partial write merges over the replayed write of n[id]")
      assert(t.c_q == 0x11, "the copy lands")
      assert(t.qd == 0x2d, "a valid bit cleared before the read gates the data write off")
    }
  }
}
