/*
:name: loop_hierarchy
:type: simulation
:expect_instances: u_loop_0=2 core=1 *=3
*/
mod loop_worker(x:u8) -> (y:u16@[0]) {
  mut sum:u16 = 0
  for j in 0..<4 { sum = sum + x + j }
  y = sum
}

mod loop_hierarchy(x:u8) -> (y:u16@[0]) {
  mut sum:u16 = 0
  for i in 0..<2 {
    const core = loop_worker::[name=core](x=x)
    sum = sum + core
  }
  y = sum
}

test loop_hierarchy.nested {
  mut dut = loop_hierarchy
  tick 3 {
    dut.x = if clock == 0 { 3 } elif clock == 1 { 0 } else { 7 }
    step
    assert(dut.y == (if clock == 0 { 36 } elif clock == 1 { 12 } else { 68 }))
  }
}
