/*
:name: negedge_through_sub
:type: simulation
*/
// A PARENT negedge flop whose data crosses a SUB-INSTANCE. The occurrence-wide
// plan gives the child's combinational cone a post-rise version and orders that
// color before the parent's fall commit. No module call or second state advance
// exists at the hierarchy boundary.
//
// THE VALUE THIS PINS. `thru` is pure combinational, so the half-cycle transfer
// must land IN THE SAME PERIOD: at the rise `a` takes `d`; at the fall `n`
// samples `t == a` reading the POST-rise `a`. So `qn == qp` on every tick after
// the first. If the fall ever went back to reading pre-rise bindings, `qn` would
// lag `qp` by a full period — the silent full-cycle-lag failure that
// hier_sim_negedge_sub.prp records for the child-side twin of this bug.
comb thru(x:u8) -> (y:u8) { y = x }

pub mod ptop(d:u8) -> (qp:u8@[1], qn:u8@[2]) {
  reg a:u8 = 0
  a  = d
  qp = a
  mut t = thru(x=a)
  reg n:u8:[posclk=false] = 0
  n  = t
  qn = n
}

test ptop.halfcycle {
  mut acc  = ptop
  mut bad  = 0
  mut seen = 0
  tick 8 {
    acc.d = 11 + (17 * clock)
    step
    // CONTROL: qp is the parent's own posedge stage, correct independently of
    // the fall phase — so a failure below is specifically the negedge timing.
    if clock >= 1 {
      seen = seen + 1
      if acc.qn != acc.qp {
        bad = bad + 1
      }
    }
  }
  assert(seen == 7, "the comparison actually ran (guards against a vacuous pass)")
  assert(bad == 0, "a parent negedge flop fed THROUGH an instance samples the same period's posedge Q")
}
