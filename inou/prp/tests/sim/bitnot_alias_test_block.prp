/*
:name: bitnot_alias_test_block
:type: simulation
*/
// User rulings 2026-09-28 (38) and 2026-09-29 (44), inside a `test` block
// (ruling 20: a test follows the language): an untyped `const` alias of a
// typed value has its type, so `~alias` flips the typed width in the test
// exactly as in the design. Before, the test driver typed `~` only from
// declared names, so `~K2` was -3 in the test while the DUT computed 5.
const K:U3 = 2
const K2 = K

mod bitnot_alias_test_block(a:U4) -> (o:U4@[0], n:U3@[0]) {
  o = a
  n = ~K2
}

test bitnot_alias_test_block.aliases() {
  mut d = bitnot_alias_test_block
  d.a = 3
  step
  assert(d.n == 5)
  assert(~K2 == 5)           // file-scope alias of a U3
  mut v:U8 = 5
  const av = v               // alias of a U8
  const sv = v#[0..<4]       // a 4-bit slice
  const ssv = sv             // alias of the slice
  const al = d.o             // alias of a U4 DUT output
  assert(~av == 250)
  assert(~sv == 10)
  assert(~ssv == 10)
  assert(~al == 12)
  assert(~d.o == 12)
}
