load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//tools:copt_default.bzl", "COPTS")

# Simulator-codegen content salt (opt_loop_incr L2). `kSimGenVersion` is a
# HAND-bumped string, and a forgotten bump is not a stale comment — it is a
# stale generated .cpp reused against a changed emitter, i.e. a miscompile, and
# it silently reports the OLD implementation's numbers as the new one's. Hash
# every emitter source into a constant instead, exactly as //lhd:formal_salt
# does for the prover: an edit here auto-invalidates every cached generation
# while an unrelated lhd rebuild keeps the sim tree warm.
#
# kSimGenVersion stays, as the human-facing generated-C++ stamp and the
# on-disk schema version; it is no longer the sole soundness gate.
#
# The glob deliberately EXCLUDES the generated header itself (it is an `outs`,
# not a source) — hashing an output into its own input is a cycle. Test sources
# are excluded for the opposite reason: they never emit a byte of the generated
# tree, so folding them in would throw away every cached sim generation on a
# test-only edit. Same exclusion, same rationale, as //pass/abc:abc_salt.
genrule(
    name = "cgen_salt",
    srcs = glob(
        [
            "*.cpp",
            "*.hpp",
        ],
        exclude = [
            "cgen_salt.hpp",
            "*_test.cpp",
        ],
    ),
    outs = ["cgen_salt.hpp"],
    cmd = "h=$$(cat $(SRCS) | (shasum -a 256 2>/dev/null || sha256sum) | cut -c1-16); " +
          "printf '// Generated by //inou/cgen:cgen_salt -- DO NOT EDIT.\\n" +
          "// Content hash of every inou/cgen source: the sim generation-cache\\n" +
          "// code salt (docs/opt_loop_incr.md L2).\\n" +
          "#pragma once\\n#include <cstdint>\\n" +
          "namespace livehd { inline constexpr uint64_t kCgenSrcSalt = 0x%sULL; }\\n' \"$$h\" > $@",
)

cc_library(
    name = "inou_cgen",
    srcs = glob(
        ["*.cpp"],
        exclude = [
            "*_test.cpp",
            "llvm_sim_link.cpp",
        ],
    ) + ["cgen_salt.hpp"],
    hdrs = glob(
        ["*.hpp"],
        exclude = ["cgen_salt.hpp"],
    ),
    copts = COPTS,
    includes = ["."],
    visibility = ["//visibility:public"],
    deps = [
        "//core",
        "//graph",
        "//pass/common:pass",
        "@llvm-project//llvm:BitReader",
        "@llvm-project//llvm:BitWriter",
        "@llvm-project//llvm:CodeGen",
        "@llvm-project//llvm:Core",
        "@llvm-project//llvm:IPO",
        "@llvm-project//llvm:Linker",
        "@llvm-project//llvm:MC",
        "@llvm-project//llvm:Passes",
        "@llvm-project//llvm:Support",
        "@llvm-project//llvm:Target",
        "@llvm-project//llvm:TargetParser",
    ] + select({
        "@platforms//cpu:aarch64": [
            "@llvm-project//llvm:AArch64AsmParser",
            "@llvm-project//llvm:AArch64CodeGen",
        ],
        "@platforms//cpu:x86_64": [
            "@llvm-project//llvm:X86AsmParser",
            "@llvm-project//llvm:X86CodeGen",
        ],
        "//conditions:default": [
            "@llvm-project//llvm:AllTargetsAsmParsers",
            "@llvm-project//llvm:AllTargetsCodeGens",
        ],
    }),
    alwayslink = True,
)

cc_binary(
    name = "llvm_sim_link",
    srcs = ["llvm_sim_link.cpp"],
    copts = COPTS,
    visibility = ["//visibility:public"],
    deps = [":inou_cgen"],
)

cc_test(
    name = "cgen_llvm_test",
    srcs = ["cgen_llvm_test.cpp"],
    copts = COPTS,
    deps = [
        ":inou_cgen",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "sim_color_plan_test",
    srcs = ["sim_color_plan_test.cpp"],
    copts = COPTS,
    deps = [
        ":inou_cgen",
        "//graph",
        "@googletest//:gtest_main",
        "@hhds//hhds:graph",
    ],
)

# A cgen Memory becomes `<wrapper instance>.data` when its Verilog is read
# back. Two same-shaped uninitialized memories pin the reversible instance
# provenance used by native LEC to retain exact state correspondence.
sh_test(
    name = "cgen_memory_state_roundtrip",
    size = "large",
    srcs = ["tests/memory_state_roundtrip_test.sh"],
    data = [
        "tests/memory_state_roundtrip.sv",
        "tests/memory_whole_state_roundtrip.prp",
        "tests/memory_whole_state_roundtrip.sv",
        "//lhd",
    ],
)
