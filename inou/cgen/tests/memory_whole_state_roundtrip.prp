/*
:name: memory_whole_state_roundtrip
:type: compile
*/

// A registered whole-array update takes cgen's inline packed-array path, not
// the cgen_memory_* wrapper path. Its emitted storage name must retain the
// original Memory-node provenance for native endpoint correspondence. The
// reads come BEFORE the store: in program order (the default `ordering`) a
// read after it would see this cycle's `inp`, not the committed contents the
// nonblocking Verilog twin reads.
pub mod memory_whole_state_roundtrip(inp:U80, idx:U3) -> (r:U10@[0], allout:U80@[0]) {
  reg arr:[8]U10 = nil
  r = arr[idx]
  allout = arr
  arr = inp
}
