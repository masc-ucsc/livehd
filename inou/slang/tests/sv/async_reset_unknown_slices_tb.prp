// Native directed vectors for the Pyrope round trip of
// async_reset_unknown_slices.sv (the roundtrip_sim tier of
// tests/slang_compile.sh). sim.unknown_zero resolves unknown bits, so only the
// DEFINED reset bits are checked here; the x bits of the emitted reset
// constants, and the asynchronous sensitivity list, are pinned by the fixture's
// :verilog_re:/:verilog_not_re: headers.
const dut = import("lg:async_reset_unknown_slices")

test unknown_slices.reset {
  mut acc = dut
  mut cycle:u32 = 0
  tick 4 {
    acc.rst = cycle != 2
    acc.d   = if cycle == 0 { 0 } else { 0x9c }
    step
    assert((cycle != 2) implies ((acc.a & 3) == 3 and (acc.b & 5) == 1), "defined reset bits")
    assert((cycle == 2) implies (acc.a == 9 and acc.b == 12), "clocked arm")
    cycle += 1
  }
}
