pub mod StageReg_4::[lg="StageReg_4", hdl](clock:u1, reset:u1, io_in_ex_ctrl_itype:u1, io_in_ex_ctrl_aluop:u1, io_in_ex_ctrl_src1:u1, io_in_ex_ctrl_src2:u2, io_in_ex_ctrl_branch:u1, io_in_ex_ctrl_jumptype:u2, io_in_ex_ctrl_resultselect:u1, io_in_ex_ctrl_wordinst:u1, io_in_mem_ctrl_memop:u2, io_in_wb_ctrl_toreg:u1, io_in_wb_ctrl_regwrite:u1, io_flush:u1) -> (io_data_ex_ctrl_itype:u1@[], io_data_ex_ctrl_aluop:u1@[], io_data_ex_ctrl_src1:u1@[], io_data_ex_ctrl_src2:u2@[], io_data_ex_ctrl_branch:u1@[], io_data_ex_ctrl_jumptype:u2@[], io_data_ex_ctrl_resultselect:u1@[], io_data_ex_ctrl_wordinst:u1@[], io_data_mem_ctrl_memop:u2@[], io_data_wb_ctrl_toreg:u1@[], io_data_wb_ctrl_regwrite:u1@[]) {
  mut _mux_1 = 0
  mut _mux_2 = 0
  mut _mux_3 = 0
  reg reg_ex_ctrl_itype:u1
  reg reg_ex_ctrl_aluop:u1
  reg reg_ex_ctrl_src1:u1
  reg reg_ex_ctrl_src2:u2
  reg reg_ex_ctrl_branch:u1
  reg reg_ex_ctrl_jumptype:u2
  reg reg_ex_ctrl_resultselect:u1
  reg reg_ex_ctrl_wordinst:u1
  reg reg_mem_ctrl_memop:u2
  reg reg_wb_ctrl_toreg:u1
  reg reg_wb_ctrl_regwrite:u1
  if reset != 0 {
    reg_ex_ctrl_aluop = 0
    reg_ex_ctrl_branch = 0
    reg_ex_ctrl_itype = 0
    reg_ex_ctrl_jumptype = 0
    reg_ex_ctrl_resultselect = 0
    reg_ex_ctrl_src1 = 0
    reg_ex_ctrl_src2 = 0
    reg_ex_ctrl_wordinst = 0
    reg_mem_ctrl_memop = 0
    reg_wb_ctrl_regwrite = 0
    reg_wb_ctrl_toreg = 0
  } else {
    
    _mux_1 = io_in_ex_ctrl_src2#[0..=1]
    reg_ex_ctrl_aluop = (~io_flush) & 1 & io_in_ex_ctrl_aluop
    reg_ex_ctrl_itype = (~io_flush) & 1 & io_in_ex_ctrl_itype
    reg_ex_ctrl_src1 = (~io_flush) & 1 & io_in_ex_ctrl_src1
    if io_flush != 0 {
      _mux_1 = 0
    }
    
    _mux_2 = io_in_ex_ctrl_jumptype#[0..=1]
    reg_ex_ctrl_branch = (~io_flush) & 1 & io_in_ex_ctrl_branch
    reg_ex_ctrl_src2 = _mux_1
    if io_flush != 0 {
      _mux_2 = 0
    }
    
    _mux_3 = io_in_mem_ctrl_memop#[0..=1]
    reg_ex_ctrl_jumptype = _mux_2
    reg_ex_ctrl_resultselect = (~io_flush) & 1 & io_in_ex_ctrl_resultselect
    reg_ex_ctrl_wordinst = (~io_flush) & 1 & io_in_ex_ctrl_wordinst
    if io_flush != 0 {
      _mux_3 = 0
    }
    reg_mem_ctrl_memop = _mux_3
    reg_wb_ctrl_regwrite = (~io_flush) & 1 & io_in_wb_ctrl_regwrite
    reg_wb_ctrl_toreg = (~io_flush) & 1 & io_in_wb_ctrl_toreg
  }
  io_data_ex_ctrl_aluop = reg_ex_ctrl_aluop
  io_data_ex_ctrl_branch = reg_ex_ctrl_branch
  io_data_ex_ctrl_itype = reg_ex_ctrl_itype
  io_data_ex_ctrl_jumptype = reg_ex_ctrl_jumptype
  io_data_ex_ctrl_resultselect = reg_ex_ctrl_resultselect
  io_data_ex_ctrl_src1 = reg_ex_ctrl_src1
  io_data_ex_ctrl_src2 = reg_ex_ctrl_src2
  io_data_ex_ctrl_wordinst = reg_ex_ctrl_wordinst
  io_data_mem_ctrl_memop = reg_mem_ctrl_memop
  io_data_wb_ctrl_regwrite = reg_wb_ctrl_regwrite
  io_data_wb_ctrl_toreg = reg_wb_ctrl_toreg
}
