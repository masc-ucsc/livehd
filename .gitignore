# local agent worktrees / scratch
.claude/worktrees/
tmp_v2prp2v_*/

# inou/cgen/tests/sim/diff_test.py writes here only if $LHD_DIFFTEST_DIR points back into the repo
difftest_*/

# Optimization-loop scoreboards (docs/opt_loop_incr.md H6b, docs/opt_loop_synth.md
# M0.4b): pure renderings of ../lhdsuite/bench/ledger.jsonl, per-host by
# construction. Regenerate with `bazel run //bench:ledger -- render`.
#current_opt_loop_incr.html
#current_opt_loop_synth.html
/color_stats.json

# ABC writes its interactive command history into the CWD whenever pass.abc runs
# a script through the embedded shell.
/abc.history

# lhd --emit-dir lg: scratch output dirs (lg1, lg2, ...)
/lg[0-9]*/

# Local B1 refactor validation artifacts
generated/b1_refactor/

# Local master-port validation artifacts (fresh exports, generated Lean files,
# proof logs). Evidence is summarized in pass/lean/tests/*.json; the raw tree is
# thousands of files and is not source.
generated/master_port/
# Generated per-design simulator launchers (pass/lean/scripts/make_sim_launcher.py).
# A real design's certificate literal is megabytes of array elements; the
# generator is tracked, its output is not.
/formal/lean/Sims/

# Locally provisioned validation tools (pinned Icarus Verilog, built from
# source into the project). The FINGERPRINT.txt that records the pinned tag,
# commit and binary hashes is what belongs in the ledger; a built toolchain
# does not belong in the repository.
/generated/validation-tools/

# Analysis staging for the D3/D4/Futamura ports (file inventories, diffs).
/generated/port_staging/

# Derived trees, never source. `generated/` is run output and the imported
# corpora (whose identity is pinned per certificate by the sha256 column of
# pass/lean/manifests/*.tsv, not by git); `temp/` is the scratch root the tests
# and drivers create under the project; `Gen/` is the per-design Lean models the
# D3 reifier emits, for the same reason /formal/lean/Sims/ is ignored above.
# Nothing under any of the three has ever been tracked. The four narrower
# generated/ rules above are subsumed and kept only for their rationale -- a
# canonical manifest run refuses a dirty worktree, and that refusal should mean
# "source is uncommitted", not "a previous run left its output behind".
/generated/
/temp/
/formal/lean/LeanSemanticPrimitives/Gen/

# Lean build OUTPUT for the projection probes. `.build-proj.sh` writes the
# oleans into .olean-dev and `run_cert.sh` reads them back through LEAN_PATH;
# `build-native.sh` writes .native-dev and calls itself a diagnostic that
# nothing in the project depends on. Three FP commits (73dee5673, df8b7c8ec,
# d8d84afbd) swept 46 .olean files -- 78 MB -- into the repository; they are
# regenerable and are untracked again from here.
/formal/lean/.olean-dev/
/formal/lean/.native-dev/

# Measurement/reproduction bundles: large, regenerable, kept out of the repository
# (files already tracked under repros/ stay tracked).
/repros/

# Plans, progress ledgers, audits, bug-hunt logs and status snapshots for the
# Lean/Isabelle proof flows stay local. The repository carries only usage and
# introduction documents, and states which benchmarks are covered -- never which
# ones are planned, queued or still to run. The patterns catch new documents;
# the explicit paths are the ones already written under other names.
# <doc>.plans.md, beside <doc>, holds the passages cut from that tracked doc.
*.plans.md
/pass/lean/**/*_PLAN.md
/pass/lean/**/*_AUDIT.md
/pass/lean/**/*_LEDGER*.md
/pass/lean/**/*_STATUS.md
/pass/lean/**/*_BUGS.md
/pass/lean/**/*_PROVENANCE.md
/pass/lean/**/*_REFACTOR.md
/pass/lean/**/*_LOG.md
/pass/isabelle/**/*_BUGS.md
/formal/**/*_PLAN.md
/formal/**/*_NOTES.md
/formal/**/*_PERF.md
/formal/**/*_HANDOFF.md
/formal/**/*_OBLIGATIONS.md
/docs/cva6_isabelle_stress.md
/pass/lean/GROUNDING_SRA_GETMASK_SEXT.md
/pass/lean/LEGACY_PROOF_COVERAGE.md
/pass/lean/LEGACY_PROOF_REPLAY.md
/pass/lean/MASTER_INTEGRATION.md
/pass/lean/specialization/FUTAMURA_PROJECTIONS.md
# Plan-shaped data: target matrices, schedules and requested-unit manifests.
/pass/lean/tests/MASTER_SIM_*
/pass/lean/tests/MASTER_BENCHMARK_MANIFEST.json
/pass/lean/tests/MASTER_D2_PORT_PLAN_AUDIT.json
/pass/lean/specialization/tests/FP_SUPPORT_MANIFEST.tsv
/pass/lean/specialization/tests/fp_obligation_inventory.tsv
/todo/livehd/simulator-generation-matrix.html
