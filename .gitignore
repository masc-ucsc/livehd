# local agent worktrees / scratch
.claude/worktrees/
tmp_v2prp2v_*/

# inou/cgen/tests/sim/diff_test.py writes here only if $LHD_DIFFTEST_DIR points back into the repo
difftest_*/

# EVERYTHING under generated/ is local run output: reproducible from the
# scripts and the commit it was produced at, often multi-GB, and NEVER to be
# staged.  Commit 51b973ceb staged 1303 of these files (1,145,863 lines) via
# `git add -A generated` and had to be recovered onto a clean branch; this
# blanket rule is what makes that mistake impossible rather than unlikely.
# The per-tree entries below are kept as documentation of what each tree is
# and which script writes it -- they are subsumed by the rule above.
/generated/

# Derived slang-clean copies of CORE-ET sources (scripts/coreet_patch_srcs.py).
# Regenerated by run_coreet_module_lean.sh on every run, and map.tsv holds
# absolute machine-specific paths -- tracking them would bake in one machine
# and go stale against upstream core-et without anything noticing.
generated/core-et/patched_src/

# Cycle-provenance evidence (scripts/cycle_provenance.sh,
# scripts/proc_ifx_scc_compare.sh): per-module lgdb directories, RTLIL dumps and
# yosys/lhd logs, several GB per sweep. Kept ON DISK as the evidence trail --
# the CONCLUSIONS belong in pass/lean/GATED_MODULES.tsv and
# pass/lean/DIRECTION2_RESULTS.md, which are tracked.
generated/provenance/

# Defined-input equivalence evidence (scripts/coreet_equiv7.sh): per-module
# lgdb directories, emitted netlists, verilator build trees and simulation
# traces. Kept ON DISK; the conclusions are in pass/lean/DIRECTION2_RESULTS.md
# and pass/lean/GATED_MODULES.tsv.
generated/equiv7/

# D2-local Lake build tree + Lean validation evidence. Several GB (hardlinked
# deps). See generated/lean_validation/README.md -- this directory exists
# because formal/lean/.lake used to be a symlink into another worktree.
generated/lean_validation/

# Direction 2 census runs (scripts/coreet_d2_census.sh): one directory per
# commit, each holding per-module lgdb trees, certificates and logs. The
# CENSUS TSV and manifest of a reported run are copied into pass/lean/.
generated/census_d2/

# Run debris from lhd/tests/census_consistency_test.sh when it is invoked
# directly (under bazel it uses TEST_TMPDIR instead).
generated/census_consistency_test/
