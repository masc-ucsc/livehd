diff --git a/src/slang_frontend.cc b/src/slang_frontend.cc
--- src/slang_frontend.cc
+++ src/slang_frontend.cc
@@ -218,2 +218,18 @@
-	else
-		return std::string(sym.name) + "$" + instance;
+
+	// Slang prints escaped path components with their required trailing space.
+	// RTLIL identifiers cannot contain that delimiter. Encode it without losing
+	// the distinction between a dotted identifier and nested instances, and
+	// escape the marker itself so a literal "%20" cannot collide with a space.
+	std::string encoded_instance;
+	encoded_instance.reserve(instance.size());
+	constexpr char hex[] = "0123456789ABCDEF";
+	for (unsigned char c : instance) {
+		if (c <= 0x20 || c == 0x7f || c == '%') {
+			encoded_instance += '%';
+			encoded_instance += hex[c >> 4];
+			encoded_instance += hex[c & 0xf];
+		} else {
+			encoded_instance += static_cast<char>(c);
+		}
+	}
+	return std::string(sym.name) + "$" + encoded_instance;
