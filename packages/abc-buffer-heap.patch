+// Pending fanouts form a minimum heap in the existing departure/cap order.
+// Repeatedly compacting and summing the complete vector for each small buffer
+// batch costs quadratic time on a high-fanout net.
+static Abc_Obj_t * Bus_SclPopFanout( Vec_Ptr_t * vFanouts )
+{
+    Abc_Obj_t * pResult = (Abc_Obj_t *)Vec_PtrEntry( vFanouts, 0 );
+    Abc_Obj_t * pLast = (Abc_Obj_t *)Vec_PtrPop( vFanouts );
+    int i = 0, nSize = Vec_PtrSize( vFanouts );
+    while ( 2*i + 1 < nSize )
+    {
+        int k = 2*i + 1;
+        Abc_Obj_t * pChild = (Abc_Obj_t *)Vec_PtrEntry( vFanouts, k );
+        if ( k + 1 < nSize )
+        {
+            Abc_Obj_t * pRight = (Abc_Obj_t *)Vec_PtrEntry( vFanouts, k + 1 );
+            if ( Bus_SclCompareFanouts( &pRight, &pChild ) < 0 )
+                pChild = pRight, k++;
+        }
+        if ( Bus_SclCompareFanouts( &pLast, &pChild ) < 0 )
+            break;
+        Vec_PtrWriteEntry( vFanouts, i, pChild );
+        i = k;
+    }
+    if ( nSize )
+        Vec_PtrWriteEntry( vFanouts, i, pLast );
+    return pResult;
+}
+static void Bus_SclPushFanout( Vec_Ptr_t * vFanouts, Abc_Obj_t * pObj )
+{
+    int i = Vec_PtrSize( vFanouts );
+    Vec_PtrPush( vFanouts, pObj );
+    while ( i > 0 )
+    {
+        int k = (i - 1) / 2;
+        Abc_Obj_t * pParent = (Abc_Obj_t *)Vec_PtrEntry( vFanouts, k );
+        if ( Bus_SclCompareFanouts( &pParent, &pObj ) < 0 )
+            break;
+        Vec_PtrWriteEntry( vFanouts, i, pParent );
+        i = k;
+    }
+    Vec_PtrWriteEntry( vFanouts, i, pObj );
+}
