+// Same edge and polarity update as Abc_ObjPatchFanin, given the old
+// source's fanout-vector slot. Swap-remove that entry and return the moved
+// fanout ID (or -1) so a caller maintaining back-indices can update it.
+int Abc_ObjPatchFaninFast( Abc_Obj_t * pObj, Abc_Obj_t * pFaninOld, Abc_Obj_t * pFaninNew, int iFanout )
+{
+    Abc_Obj_t * pFaninNewR = Abc_ObjRegular(pFaninNew);
+    int iFanin = Vec_IntFind( &pObj->vFanins, pFaninOld->Id );
+    int last;
+    assert( !Abc_ObjIsComplement(pObj) && !Abc_ObjIsComplement(pFaninOld) );
+    assert( pFaninOld != pFaninNewR );
+    assert( pObj->pNtk == pFaninOld->pNtk && pObj->pNtk == pFaninNewR->pNtk );
+    assert( iFanin >= 0 );
+    assert( iFanout >= 0 && iFanout < Vec_IntSize(&pFaninOld->vFanouts) );
+    assert( Vec_IntEntry(&pFaninOld->vFanouts, iFanout) == (int)pObj->Id );
+    Vec_IntWriteEntry( &pObj->vFanins, iFanin, pFaninNewR->Id );
+    if ( Abc_ObjIsComplement(pFaninNew) )
+        Abc_ObjXorFaninC( pObj, iFanin );
+    last = Vec_IntPop( &pFaninOld->vFanouts );
+    if ( iFanout < Vec_IntSize(&pFaninOld->vFanouts) )
+        Vec_IntWriteEntry( &pFaninOld->vFanouts, iFanout, last );
+    else
+        last = -1;
+    Vec_IntPushMem( pObj->pNtk->pMmStep, &pFaninNewR->vFanouts, pObj->Id );
+    return last;
+}
