+// Buffering repeatedly removes edges of the same source. Keep back-indices
+// so this does not search and shift its complete fanout list for every edge.
+// Duplicate fanout IDs use the general routine, which preserves parallel edges.
+static void Bus_SclIndexFanouts( Bus_Man_t * p, Abc_Obj_t * pObj )
+{
+    Abc_Obj_t * pFanout;
+    int i;
+    p->fFastFanouts = 1;
+    Abc_ObjForEachFanout( pObj, pFanout, i )
+    {
+        int pos = Vec_IntGetEntry( p->vFanoutPos, Abc_ObjId(pFanout) );
+        if ( pos < i && Vec_IntEntry(&pObj->vFanouts, pos) == (int)Abc_ObjId(pFanout) )
+            p->fFastFanouts = 0;
+        Vec_IntSetEntry( p->vFanoutPos, Abc_ObjId(pFanout), i );
+    }
+}
+static void Bus_SclPatchFanout( Bus_Man_t * p, Abc_Obj_t * pFanout, Abc_Obj_t * pOld, Abc_Obj_t * pNew )
+{
+    int pos, moved;
+    if ( !p->fFastFanouts )
+    {
+        Abc_ObjPatchFanin( pFanout, pOld, pNew );
+        return;
+    }
+    pos = Vec_IntEntry( p->vFanoutPos, Abc_ObjId(pFanout) );
+    moved = Abc_ObjPatchFaninFast( pFanout, pOld, pNew, pos );
+    if ( moved >= 0 )
+        Vec_IntWriteEntry( p->vFanoutPos, moved, pos );
 }
