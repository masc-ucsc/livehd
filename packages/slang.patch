diff --git external/CMakeLists.txt external/CMakeLists.txt
--- external/CMakeLists.txt
+++ external/CMakeLists.txt
@@ -1,3 +1,12 @@
+# LiveHD: resolve FetchContent from Bazel's pinned archives without network or
+# host package discovery. Each path points to that archive's root CMakeLists.txt.
+foreach(dep FMT BOOST_REGEX TOMLPLUSPLUS)
+  get_filename_component(dep_root "${${dep}_CMAKE_PATH}" DIRECTORY)
+  set(FETCHCONTENT_SOURCE_DIR_${dep} "${dep_root}")
+endforeach()
+set(FETCHCONTENT_FULLY_DISCONNECTED ON)
+set(FETCHCONTENT_TRY_FIND_PACKAGE_MODE NEVER)
+
