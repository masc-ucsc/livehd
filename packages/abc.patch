+// Per-CI/CO boundary environment of a partitioned design's region, consumed by
+// the SCL timer only (stime/upsize/dnsize and their SC_Man users); the mappers
+// never read it. Installed on the frame by the caller (Abc_FrameSetBnd), which
+// owns the vectors. Index = PI/PO position in the network's vPis/vPos (the
+// first CIs/COs); a missing or negative entry means "unconstrained".
+typedef struct SC_Bnd_          SC_Bnd;
+struct SC_Bnd_
+{
+    Vec_Flt_t *    vPoLoad;       // per PO: external load in fF added to the driver's load (<0: none)
+    Vec_Flt_t *    vPoDelay;      // per PO: virtual delay after the PO in ps -- budget minus required time (<0: none)
+    Vec_Ptr_t *    vPiCell;       // per PI: SC_Cell * of the driving cell (NULL: ideal driver)
+    Vec_Flt_t *    vPiArr;        // per PI: arrival time in ps (<0: none)
+};
+
 typedef struct SC_Man_          SC_Man;
 struct SC_Man_ 
 {
