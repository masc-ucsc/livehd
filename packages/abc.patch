+// boundary: a driving cell with any number of inputs -- the load-dependent
+// delay delta and slew of its slowest input arc (Scl_LibHandleInputDriver is
+// the one-input special case).
+static void Abc_SclHandleInputDriverAny( SC_Cell * pCell, SC_Pair * pLoadIn, SC_Pair * pArrOut, SC_Pair * pSlewOut )
+{
+    int k;
+    pArrOut->rise = pArrOut->fall = 0;
+    pSlewOut->rise = pSlewOut->fall = 0;
+    for ( k = 0; k < pCell->n_inputs; k++ )
+    {
+        SC_Pair LoadIn   = { 0.0, 0.0 };
+        SC_Pair ArrIn    = { 0.0, 0.0 };
+        SC_Pair SlewIn   = { 0.0, 0.0 };
+        SC_Pair ArrOut0  = { 0.0, 0.0 };
+        SC_Pair ArrOut1  = { 0.0, 0.0 };
+        SC_Pair SlewOut0 = { 0.0, 0.0 };
+        SC_Pair SlewOut1 = { 0.0, 0.0 };
+        SC_Timing * pTime = Scl_CellPinTime( pCell, k );
+        if ( pTime == NULL )
+            continue;
+        Scl_LibPinArrival( pTime, &ArrIn, &SlewIn, &LoadIn, &ArrOut0, &SlewOut0 );
+        Scl_LibPinArrival( pTime, &ArrIn, &SlewIn, pLoadIn, &ArrOut1, &SlewOut1 );
+        pArrOut->rise  = Abc_MaxFloat( pArrOut->rise,  ArrOut1.rise - ArrOut0.rise );
+        pArrOut->fall  = Abc_MaxFloat( pArrOut->fall,  ArrOut1.fall - ArrOut0.fall );
+        pSlewOut->rise = Abc_MaxFloat( pSlewOut->rise, SlewOut1.rise );
+        pSlewOut->fall = Abc_MaxFloat( pSlewOut->fall, SlewOut1.fall );
+    }
+}
